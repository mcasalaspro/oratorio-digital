---
import fs from 'node:fs';
import { withBase } from '../config/site';
import { reserva } from '../config/contadores';
const { prayer } = Astro.props;
const { id, data } = prayer;

// usa a versão "_thumb" (menor) se existir; senão, a imagem normal
const hasThumb = fs.existsSync(`public/saints/${id}_thumb.webp`);
const img = withBase(hasThumb ? `/saints/${id}_thumb.webp` : `/saints/${id}.webp`);
const imgFallback = withBase('/saints/default.webp');

const href = withBase(`/oracao/${id}`);
const langCode = (data.language ?? 'pt-BR').slice(0, 2).toUpperCase();
const feast = data.liturgicalFeast ?? '';
const total = data.totalDays ?? 1;
const offset = data.novenaSuggestedStart ?? 0;

// quantas vezes já foi rezada: começa com a reserva do build (src/data/contadores.json);
// a página inicial troca pelo número vivo do contador. Zero ou sem número = marca oculta.
const rezas = reserva(id) ?? 0;
const rezasTxt = rezas > 0 ? new Intl.NumberFormat('pt-BR').format(rezas) : '';
---
<a class="card" href={href}
   data-slug={id}
   data-type={data.type}
   data-lang={data.language}
   data-feast={feast}
   data-total={total}
   data-offset={offset}
   data-search={`${data.title} ${data.saint ?? ''} ${data.tags.join(' ')} ${data.description}`.toLowerCase()}>
  <img class="card-img" src={img} alt={data.saint ?? data.title} loading="lazy" width="600" height="800" onerror={`this.onerror=null;this.src='${imgFallback}'`} />
  <button class="fav-btn" type="button" aria-label="Favoritar" aria-pressed="false">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path class="hpath" d="M12 21l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.18L12 21z" stroke-width="2"/></svg>
  </button>
  <div class="card-body">
    <span class="card-type" data-i18n={`type_${data.type}`}>{data.type}</span>
    <h3 class="card-title">{data.title}</h3>
    {data.saint && <span class="card-saint">{data.saint}</span>}
    {data.description && <p class="card-desc">{data.description}</p>}
    <div class="card-foot">
      <span class="pill">{langCode}</span>
      {data.type === 'novena' && data.totalDays && <span class="pill">{data.totalDays} dias</span>}
      {/* vezes rezada: chama + número; o leitor de tela ouve "120 vezes rezada" */}
      <span class="pill pill-reza" data-n={rezas || undefined} title={rezas ? `${rezasTxt} ${rezas === 1 ? 'vez rezada' : 'vezes rezada'}` : undefined} hidden={!rezas}><span class="pill-reza-n">{rezasTxt}</span><span class="sr-only"> <span class="pill-reza-lab" data-i18n={rezas === 1 ? undefined : 'count_short'}>{rezas === 1 ? 'vez rezada' : 'vezes rezada'}</span></span></span>
    </div>
  </div>
</a>

<style is:global>
  /* marca "vezes rezada" no rodapé do cartão (global: não espalha atributos pelos 234 cartões) */
  .card-foot { flex-wrap: wrap; row-gap: .25rem; }
  .pill-reza { display: inline-flex; align-items: center; gap: .3em; margin-left: auto; }
  .pill-reza[hidden] { display: none; }
  .pill-reza::before {   /* chama da vela, a mesma do contador da comunidade */
    content: ''; flex: 0 0 auto; width: .5em; height: .8em;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    background: radial-gradient(circle at 50% 70%, #fff6da 0%, var(--flame) 45%, #e07a1f 100%);
  }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
</style>
