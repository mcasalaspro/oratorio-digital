---
// Cartão de oração (página inicial). O link fica no TÍTULO e a área clicável se
// estende ao cartão inteiro (::after); o coração é um botão IRMÃO do link — botão
// dentro de link é HTML inválido. O ícone vem do <symbol id="i-coracao"> da página.
import fs from 'node:fs';
import { withBase } from '../config/site';
import { reserva } from '../config/contadores';
const { prayer } = Astro.props;
const { id, data } = prayer;

// miniatura em pé (360×480, gerada no build como <id>_thumb.webp); sem ela, a imagem normal
const hasThumb = fs.existsSync(`public/saints/${id}_thumb.webp`);
const img = withBase(hasThumb ? `/saints/${id}_thumb.webp` : `/saints/${id}.webp`);

// imagem grande (destaque "Oração do dia"): só vai no cartão quando foge do padrão /saints/<id>.webp
const imgGrande = data.image && data.image !== `/saints/${id}.webp` ? withBase(data.image) : undefined;

const href = withBase(`/oracao/${id}`);
const lang = data.language ?? 'pt-BR';
const total = data.totalDays ?? 1;
const offset = data.novenaSuggestedStart ?? 0;
// texto de busca além do título e do santo (esses dois o script lê do próprio cartão)
const busca = `${data.tags.join(' ')} ${data.description}`.toLowerCase();

// quantas vezes já foi rezada: começa com a reserva do build (src/data/contadores.json);
// a página inicial troca pelo número vivo do contador. Sem número, a marca nem vem.
const rezas = reserva(id) ?? 0;
const rezasTxt = rezas > 0 ? new Intl.NumberFormat('pt-BR').format(rezas) : '';
const rezasLab = rezas === 1 ? 'vez rezada' : 'vezes rezada';
---
<article class="card card-oracao"
   data-slug={id}
   data-type={data.type}
   data-lang={lang !== 'pt-BR' ? lang : undefined}
   data-feast={data.liturgicalFeast || undefined}
   data-total={total > 1 ? total : undefined}
   data-offset={offset ? offset : undefined}
   data-img={imgGrande}
   data-search={busca}>
  <img class="card-img" src={img} alt="" loading="lazy" decoding="async" width="360" height="480" />
  <div class="card-body">
    <span class="card-type" data-i18n={`type_${data.type}`}>{data.type}</span>
    <h3 class="card-title"><a class="card-link" href={href}>{data.title}</a></h3>
    {data.saint && <span class="card-saint">{data.saint}</span>}
    <div class="card-foot">
      <span class="pill">{lang.slice(0, 2).toUpperCase()}</span>
      {data.type === 'novena' && data.totalDays && <span class="pill">{data.totalDays} dias</span>}
      {rezas > 0 && (
        <span class="pill pill-reza" data-n={rezas} title={`${rezasTxt} ${rezasLab}`}><span class="pill-reza-n">{rezasTxt}</span><span class="sr-only"> <span class="pill-reza-lab" data-i18n={rezas === 1 ? undefined : 'count_short'}>{rezasLab}</span></span></span>
      )}
    </div>
  </div>
  <button class="fav-btn" type="button" aria-pressed="false" aria-label={`Salvar ${data.title} nos favoritos`}><svg width="20" height="20" aria-hidden="true"><use href="#i-coracao" /></svg></button>
</article>

<style is:global>
  /* global de propósito: estilo com escopo espalharia um atributo extra pelos 234 cartões */
  .card-oracao .card-link { color: inherit; text-decoration: none; }
  /* o cartão inteiro leva ao link do título (o coração fica por cima, em outra camada) */
  .card-oracao .card-link::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .card-oracao .card-link:focus-visible { outline: none; }
  .card-oracao .card-link:focus-visible::after { outline: 2px solid var(--gold-bright); outline-offset: -3px; border-radius: 12px; }

  /* coração: o círculo continua com 36 px, mas a área de toque tem 44 px */
  .card-oracao .fav-btn { width: 44px; height: 44px; top: .25rem; right: .25rem; background: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; }
  .card-oracao .fav-btn::before { content: ''; position: absolute; inset: 4px; z-index: -1; border-radius: 50%; background: rgba(10,7,3,.45); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); transition: background .2s; }
  .card-oracao .fav-btn:hover { background: transparent; }
  .card-oracao .fav-btn:hover::before { background: rgba(10,7,3,.66); }
  .card-oracao .fav-btn svg { fill: none; stroke: #fff; transition: fill .2s, stroke .2s; }
  .card-oracao .fav-btn[aria-pressed="true"] svg { fill: var(--gold-bright); stroke: var(--gold-bright); }

  /* marca "vezes rezada" no rodapé do cartão */
  .card-oracao .card-foot { flex-wrap: wrap; row-gap: .25rem; }
  .pill-reza { display: inline-flex; align-items: center; gap: .3em; margin-left: auto; }
  .pill-reza::before {   /* chama da vela, a mesma do contador da comunidade */
    content: ''; flex: 0 0 auto; width: .5em; height: .8em;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    background: radial-gradient(circle at 50% 70%, #fff6da 0%, var(--flame) 45%, #e07a1f 100%);
  }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
</style>
