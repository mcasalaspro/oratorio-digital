---
// ════════════════════════════════════════════════════════════════
//  Botão "Stories e Status" (oração e biografia)
//  Gera, no aparelho, uma imagem 1080×1920 para Instagram Stories e
//  WhatsApp Status (public/js/compartilhar.js). Aqui, no build, só se
//  escolhem os textos da imagem:
//   - oração: campo `destaque`; sem ele, as primeiras linhas da primeira
//     citação (>) ou do primeiro verso com <br> — nunca a nota histórica
//     nem rubricas (parágrafos inteiros em itálico);
//   - biografia: campo `frase`; sem ele, a primeira citação (>) do texto se
//     for curta; senão, o `summary`.
//  O botão nasce com hidden e só aparece quando o compartilhar.js carrega.
// ════════════════════════════════════════════════════════════════
import { withBase } from '../config/site';
import JanelaCompartilhar from './JanelaCompartilhar.astro';

interface Props {
  modo: 'oracao' | 'bio';
  titulo: string;        // título da oração / nome do santo
  rotulo?: string;       // linha pequena acima do título (PT)
  rotuloChave?: string;  // chave de tradução do rótulo (ex.: type_novena)
  banner: string;        // imagem de fundo (já com o caminho-base)
  bannerReserva?: string;
  foco?: string;         // "x% y%": parte da imagem que fica à vista no recorte (campo imageFocus)
  caminho: string;       // ex.: /oracao/pai-nosso (já com o caminho-base)
  corpo?: string;        // texto em markdown (entry.body)
  destaque?: string;     // oração: trecho escolhido à mão
  frase?: string;        // biografia: frase escolhida à mão
  resumo?: string;       // biografia: summary
}
const p = Astro.props;

const REP = /^\s*\{?\s*\d{1,2}\s*[x×]\s*\}?\s*[·.\-:]?\s*/i; // marcador "10x" das repetições
// markdown → linhas de texto puro
function linhasDe(md: string): string[] {
  return md
    .replace(/<br\s*\/?>/gi, '\n')
    .replace(/<[^>]+>/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/\*\*|__|\*|_/g, '')
    .replace(/&nbsp;/g, ' ')
    .split('\n')
    .map((l) => l.replace(/\s+/g, ' ').trim())
    .filter(Boolean);
}
// até ~6 linhas / 230 letras; se cortar, termina com "…"
function cortar(linhas: string[], max = 230, maxLinhas = 6): string {
  const fim = (s: string) => s.replace(/[\s,;:.—-]+$/, '') + '…';
  const out: string[] = [];
  let n = 0;
  for (const l of linhas) {
    if (!out.length && l.length > max) return fim(l.slice(0, max).replace(/\s+\S*$/, ''));
    if (out.length >= maxLinhas || (out.length && n + l.length > max)) { out[out.length - 1] = fim(out[out.length - 1]); return out.join('\n'); }
    out.push(l);
    n += l.length;
  }
  return out.join('\n');
}
const blocos = (md = '') => md.split(/\n\s*\n/).map((b) => b.trim()).filter(Boolean);
const ehCitacao = (b: string) => b.split('\n').every((l) => /^\s*>/.test(l));
const semCitacao = (b: string) => b.split('\n').map((l) => l.replace(/^\s*>\s?/, '')).join('\n');

function trechoDaOracao(md?: string): string {
  for (const b of blocos(md)) {
    if (/^(#|<|-{3,}|\*{3,}|_{3,})/.test(b)) continue;                    // título, HTML, linha
    if (/^\*[^*][\s\S]*[^*]\*$/.test(b) || /^_[^_][\s\S]*[^_]_$/.test(b)) continue; // rubrica
    const cit = ehCitacao(b);
    if (!cit && !/<br\s*\/?>/i.test(b)) continue;                         // nota histórica ou instrução
    if (!cit && /\b(1\d{3}|20\d{2})\b|\bs[ée]culo\b/i.test(b)) continue;  // nota em versos (cita ano ou século)
    const linhas = linhasDe((cit ? semCitacao(b) : b).replace(REP, ''));
    if (linhas.length) return cortar(linhas);
  }
  return '';
}
function citacaoCurta(md?: string, max = 220): string {
  const b = blocos(md).find(ehCitacao);
  if (!b) return '';
  const t = linhasDe(semCitacao(b)).join(' ');
  return t.length <= max ? t : '';
}

let trecho = '';
let citacao = false;
if (p.modo === 'oracao') {
  trecho = p.destaque?.trim() || trechoDaOracao(p.corpo);
} else {
  trecho = p.frase?.trim() || citacaoCurta(p.corpo);
  citacao = !!trecho;
  if (!trecho) trecho = (p.resumo ?? '').trim();
}

const dominio = (Astro.site?.host ?? 'oratoriodigital.com').replace(/^www\./, '');
const slug = p.caminho.replace(/\/+$/, '').split('/').pop() ?? 'oratorio';
const dados = {
  rotulo: p.rotulo ?? '',
  rotuloChave: p.rotuloChave ?? '',
  titulo: p.titulo,
  trecho,
  citacao,
  banner: p.banner,
  bannerReserva: p.bannerReserva ?? '',
  foco: p.foco ?? '',
  caminho: p.caminho,
  dominio,
  arquivo: `oratorio-${slug}`,
};
---
<button type="button" class="rtool" hidden data-od-stories={JSON.stringify(dados)}>
  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10.5" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
  <span>Stories e Status</span>
</button>
<JanelaCompartilhar />
