---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../config/site';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import { site } from '../../config/site';
import { reserva } from '../../config/contadores';

const meses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];

const entries = await getCollection('liturgia');

// a data vem do nome do arquivo: AAAAMMDD_Liturgia
const parsed = entries
  .map((e) => { const m = e.id.match(/(\d{4})(\d{2})(\d{2})/); return m ? { e, y: +m[1], mo: +m[2], d: +m[3], key: m[1] + m[2] + m[3] } : null; })
  .filter((x) => x)
  .sort((a, b) => b.key.localeCompare(a.key)); // mais recente primeiro

// agrupa por "Mês de Ano" preservando a ordem
const groups = [];
const gidx = {};
for (const x of parsed) {
  const gk = `${x.y}-${x.mo}`;
  if (gidx[gk] === undefined) { gidx[gk] = groups.length; groups.push({ label: `${meses[x.mo - 1]} de ${x.y}`, items: [] }); }
  groups[gidx[gk]].items.push(x);
}

const undatedList = entries.filter((e) => !/(\d{4})(\d{2})(\d{2})/.test(e.id));

const todayMap = {};
for (const x of parsed) { todayMap[x.key] = x.e.id; }

const bg = fs.existsSync('public/liturgia/index.webp') ? withBase('/liturgia/index.webp') : withBase('/textures/rays.webp');
const hasAny = entries.length > 0;
// número de reserva das liturgias lidas (src/data/contadores.json), se o build tiver trazido
const reservaLiturgias = reserva(site.counter.liturgiasKey ?? 'liturgias');
---
<Base title="Liturgia do dia" description="A Liturgia da Palavra de cada dia — as leituras da Missa, fiéis aos textos da Igreja.">
  <section class="txs-hero">
    <div class="txs-bg" style={`background-image: url('${bg}')`} aria-hidden="true"></div>
    <div class="txs-shade" aria-hidden="true"></div>
    <div class="txs-wrap">
      <p class="txs-eyebrow" data-i18n="nav_liturgia">Liturgia</p>
      <h1 class="txs-title" data-i18n="liturgia_title">Liturgia do dia</h1>
      <p class="txs-lead" data-i18n="liturgia_lead">A Liturgia da Palavra de cada dia — as leituras da Missa, fiéis aos textos da Igreja.</p>

      <a class="miss-hoje" id="litHoje" href={withBase('/liturgia')} data-map={JSON.stringify(todayMap)} data-base={import.meta.env.BASE_URL} hidden>
        <span data-i18n="liturgia_today">Liturgia de hoje</span>
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <!-- contador SEPARADO: liturgias lidas -->
      <div class="lit-votive" id="litVotive" hidden data-reserva={reservaLiturgias ?? undefined}>
        <span class="lit-votive-pre" data-i18n="liturgia_count_pre">A comunidade já leu</span>
        <span class="lit-votive-num" id="litVotiveNum">—</span>
        <span class="lit-votive-post" data-i18n="liturgia_count_post">liturgias diárias.</span>
      </div>

      {!hasAny ? (
        <p class="txs-empty" data-i18n="liturgia_empty">Em breve, a Liturgia diária.</p>
      ) : (
        <div class="miss-cal">
          {groups.map((g) => (
            <div class="miss-month">
              <h2 class="miss-month-h">{g.label}</h2>
              <div class="miss-days">
                {g.items.map((x) => (
                  <a class="miss-day" href={withBase(`/liturgia/${x.e.id}`)}>
                    <span class="miss-day-n">{x.d}</span>
                    <span class="miss-day-t">{x.e.data.title}{x.e.data.rank && <span class="miss-day-r"> · {x.e.data.rank}</span>}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
          {undatedList.length > 0 && (
            <div class="miss-month">
              <h2 class="miss-month-h">Outros</h2>
              <div class="miss-days">
                {undatedList.map((e) => (
                  <a class="miss-day" href={withBase(`/liturgia/${e.id}`)}><span class="miss-day-t">{e.data.title}</span></a>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    // botão "Liturgia de hoje" (data completa AAAAMMDD)
    var el = document.getElementById('litHoje');
    if (el) {
      var base = el.getAttribute('data-base') || '/';
      var map = {}; try { map = JSON.parse(el.getAttribute('data-map') || '{}'); } catch (e) {}
      var now = new Date();
      var key = '' + now.getFullYear() + String(now.getMonth() + 1).padStart(2, '0') + String(now.getDate()).padStart(2, '0');
      if (map[key]) { el.setAttribute('href', base.replace(/\/$/, '') + '/liturgia/' + map[key]); el.hidden = false; }
    }
    // contador de liturgias lidas (window.odContador — public/js/contador.js).
    // Nunca mostra "0": o número vivo; sem ele, o maior entre o guardado neste aparelho
    // (od-liturgias-cache) e a reserva do build; sem nenhum, o bloco fica oculto.
    var C = window.odContador;
    var box = document.getElementById('litVotive'), num = document.getElementById('litVotiveNum');
    if (C && C.ativo && box && num) {
      var pos = function (v) { var n = Number(v); return (isFinite(n) && n > 0) ? n : 0; };
      var guardado = 0; try { guardado = pos(localStorage.getItem('od-liturgias-cache')); } catch (e) {}
      var valor = Math.max(guardado, pos(box.getAttribute('data-reserva')));
      var mostra = function () {
        if (!valor) { box.hidden = true; return; }
        var l = document.documentElement.getAttribute('data-lang') || 'pt-BR';
        try { num.textContent = new Intl.NumberFormat(l).format(valor); } catch (e) { num.textContent = String(valor); }
        box.hidden = false;
      };
      mostra();   // o guardado (ou a reserva) já aparece; o número vivo o substitui quando chegar
      var k = C.chaves.liturgias;
      C.ler([k]).then(function (m) {
        var vivo = m ? pos(m[k]) : 0;
        if (vivo) { try { localStorage.setItem('od-liturgias-cache', String(vivo)); } catch (e) {} valor = vivo; }
        mostra();
      });
      document.addEventListener('od:lang', function () { if (valor) mostra(); });
    }
  })();
</script>

<style>
  .txs-hero { position: relative; overflow: hidden; min-height: 100vh; display: flex; align-items: center; background: radial-gradient(120% 100% at 50% 0%, #2a1d0e 0%, #1a1208 55%, #120c06 100%); }
  .txs-bg { position: absolute; inset: 0; background-position: center; background-size: cover; background-repeat: no-repeat; background-attachment: fixed; }
  .txs-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,5,2,.6) 0%, rgba(8,5,2,.5) 40%, rgba(8,5,2,.72) 100%); }
  .txs-wrap { position: relative; z-index: 1; width: 100%; max-width: var(--maxw); margin: 0 auto; padding: clamp(2.6rem, 7vw, 5rem) clamp(1rem, 4vw, 2.2rem); }
  .txs-eyebrow { color: var(--season, var(--gold)); font-size: .8rem; letter-spacing: .26em; text-transform: uppercase; margin: 0 0 .7rem; }
  .txs-title { font-family: 'Cormorant', serif; font-weight: 600; font-size: clamp(2.4rem, 7vw, 3.6rem); line-height: 1.05; color: #f5ecd8; margin: 0 0 .8rem; }
  .txs-lead { font-family: 'EB Garamond', serif; font-size: 1.12rem; line-height: 1.7; color: #d8c8a8; max-width: 38rem; margin: 0 0 1.6rem; }

  .miss-hoje { display: inline-flex; align-items: center; gap: .6rem; padding: .85rem 1.5rem; margin: 0 0 1.4rem; border-radius: 999px; background: color-mix(in srgb, var(--season, var(--gold)) 22%, rgba(28,26,23,.8)); border: 1px solid color-mix(in srgb, var(--season, var(--gold)) 60%, var(--hair)); color: #f5ecd8; text-decoration: none; font-size: .9rem; letter-spacing: .14em; text-transform: uppercase; transition: transform .2s, background .2s, border-color .2s; }
  .miss-hoje:hover { transform: translateY(-2px); border-color: var(--gold); }
  .miss-hoje[hidden] { display: none; }

  .lit-votive { margin: 0 0 2.2rem; font-family: 'EB Garamond', serif; color: #cdc0a8; font-size: 1rem; }
  .lit-votive[hidden] { display: none; }
  .lit-votive-num { color: var(--gold-bright); font-family: 'Cormorant', serif; font-size: 1.5rem; font-weight: 600; margin: 0 .3rem; }

  .miss-cal { display: flex; flex-direction: column; gap: 1.8rem; }
  .miss-month-h { font-family: 'Cormorant', serif; font-weight: 600; font-size: 1.5rem; color: #ecdfc6; margin: 0 0 .8rem; padding-bottom: .4rem; border-bottom: 1px solid rgba(200,162,74,.22); }
  .miss-days { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: .6rem; }
  .miss-day { display: flex; align-items: baseline; gap: .7rem; padding: .7rem .9rem; border-radius: 12px; background: rgba(28,26,23,.78); border: 1px solid rgba(200,162,74,.16); text-decoration: none; transition: border-color .2s, background .2s, transform .15s; }
  .miss-day:hover { border-color: var(--gold); background: rgba(36,32,26,.9); transform: translateY(-2px); }
  .miss-day-n { font-family: 'Cormorant', serif; font-size: 1.6rem; font-weight: 600; color: var(--gold); line-height: 1; flex: 0 0 auto; min-width: 1.6rem; text-align: center; }
  .miss-day-t { font-family: 'EB Garamond', serif; font-size: 1.02rem; line-height: 1.3; color: #e7ddc9; }
  .miss-day-r { color: #b9ab90; font-size: .88rem; }
  .txs-empty { font-family: 'EB Garamond', serif; font-size: 1.1rem; color: #cdc0a8; }
</style>
