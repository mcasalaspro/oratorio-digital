---
import fs from 'node:fs';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site, ui, withBase } from '../../config/site';
import { produtosForPage, produtoImagem, catLabelPt } from '../../config/produtos';
import { bioDaOracao, nomeDaBio } from '../../config/relacoes';
import { reserva } from '../../config/contadores';
import CompartilharStories from '../../components/CompartilharStories.astro';

export async function getStaticPaths() {
  const entries = await getCollection('prayers');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const banner = withBase(data.image ?? `/saints/${entry.id}.webp`);
const imgFallback = withBase('/saints/default.webp');
// camada de paralaxe só se o arquivo existir em public/ (antes: /textures/rays.svg dava 404 em 31 orações)
const _px = data.parallaxImage ?? '';
const _pxOk = !!_px && (/^https?:\/\//.test(_px) || fs.existsSync(`public${_px.startsWith('/') ? '' : '/'}${_px}`));
if (_px && !_pxOk) console.warn(`⚠️  Oração "${entry.id}": parallaxImage "${_px}" não existe em public/ — camada omitida.`);
const parallax = _pxOk ? withBase(_px) : '';

// dados que o cliente precisa
const caminho = withBase(`/oracao/${entry.id}`);
const rotuloTipo = (ui['pt-BR'] as Record<string, string>)[`type_${data.type}`] ?? data.type;
const meta = {
  slug: entry.id,
  type: data.type,
  totalDays: data.totalDays ?? 0,
  feast: data.liturgicalFeast ?? '',
  startOffset: data.novenaSuggestedStart ?? 0,
  // imagem "Rezei hoje" (D2)
  titulo: data.title,
  banner,
  bannerReserva: imgFallback,
  caminho,
  dominio: (Astro.site?.host ?? 'oratoriodigital.com').replace(/^www\./, ''),
  // número de reserva da capa, se o contador estiver fora do ar (src/data/contadores.json)
  reserva: reserva(entry.id),
};

// ligação automática para a biografia — regra única em src/config/relacoes.ts
// (pelo nome do santo; a data da festa só desempata) — sem editar os .md
const _bios = await getCollection('biografias');
const _bio = bioDaOracao(entry, _bios);
const relatedBio: { id: string; name: string } | null = _bio ? { id: _bio.id, name: nomeDaBio(_bio) } : null;

// produtos relacionados (por slug da página ou por santo) — sem editar os .md
const relatedProducts = produtosForPage(entry.id, data.saint);
---
<Base title={data.title} description={data.description || site.tagline} idioma={data.language || 'pt-BR'}>
  <article>
    <!-- ░░ Banner com paralaxe ░░ -->
    <header class="reader-hero">
      <img class="reader-bg" src={banner} alt={data.saint ?? data.title} width="1600" height="1000" onerror={`this.onerror=null;this.src='${imgFallback}'`} />
      {parallax && <div class="reader-parallax" data-parallax="0.34" style={`background-image:url(${parallax})`}></div>}
      <div class="reader-shade"></div>
      <div class="reader-head">
        <p class="reader-type" data-i18n={`type_${data.type}`}>{data.type}</p>
        <h1 class="reader-title">{data.title}</h1>
        {data.saint && <p class="reader-saint">{data.saint}</p>}
        <p class="reader-count" id="readerCount" hidden><span class="rc-num" id="readerCountNum">—</span> <span class="rc-label" data-i18n="count_short">vezes rezada</span></p>
      </div>
    </header>

    <div class="reader-body">
      <!-- ░░ Ferramentas de leitura ░░ -->
      <div class="reader-tools" role="group" aria-label="Ferramentas de leitura">
        <button id="favBtn" class="rtool" type="button" aria-pressed="false">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path class="hpath" d="M12 21l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.18L12 21z" stroke-width="2"/></svg>
          <span data-i18n="fav_save">Salvar</span>
        </button>
        <button id="shareBtn" class="rtool" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9V5l7 7-7 7v-4.1C9 11.8 5.5 13 3 16c1-5 4-9 11-9.9z" fill="currentColor"/></svg>
          <span data-i18n="share">Compartilhar</span>
        </button>
        <CompartilharStories modo="oracao" titulo={data.title} rotulo={rotuloTipo} rotuloChave={`type_${data.type}`}
          banner={banner} bannerReserva={imgFallback} caminho={caminho} corpo={entry.body} destaque={data.destaque} />
        <span class="rtool-sep" aria-hidden="true"></span>
        <button id="fsDown" class="rtool rtool-sq" type="button" aria-label="Diminuir letra">A−</button>
        <button id="fsUp" class="rtool rtool-sq" type="button" aria-label="Aumentar letra">A+</button>
        <button id="focusBtn" class="rtool" type="button" aria-pressed="false">
          <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span data-i18n="focus_mode">Foco</span>
        </button>
      </div>

      {relatedBio && (
        <a class="bio-link" href={withBase(`/biografia/${relatedBio.id}`)}>
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v15H5.5C4.7 19 4 18.3 4 17.5v-12zM20 5.5C20 4.7 19.3 4 18.5 4H13v15h5.5c.8 0 1.5-.7 1.5-1.5v-12z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <span><span data-i18n="bio_about">Conheça a vida de</span> {relatedBio.name}</span>
        </a>
      )}

      <!-- ░░ Seletor de dia (novena) — contas de rosário ░░ -->
      <nav id="beads" class="beads" hidden aria-label="Dias da novena"></nav>
      <p id="dayCaption" class="day-caption" hidden></p>

      <!-- ░░ Texto da oração ░░ -->
      <div id="prayer-content" class="prayer-body">
        <Content />
      </div>

      <!-- ░░ Assistente de leitura ░░ -->
      <div class="rg-bar" role="group" aria-label="Assistente de leitura">
        <span class="rg-title" data-i18n="reading_assistant">Assistente de leitura</span>
        <div class="rg-controls">
          <button id="rgPlay" class="rg-btn" type="button" aria-label="Iniciar">
            <svg class="i-play" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l12 7-12 7z" fill="currentColor"/></svg>
            <svg class="i-pause" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z" fill="currentColor"/></svg>
            <span id="rgPlayLabel">Iniciar</span>
          </button>
          <button id="rgRestart" class="rg-btn" type="button" aria-label="Reiniciar">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V2L7 6l5 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z" fill="currentColor"/></svg>
            <span data-i18n="restart">Reiniciar</span>
          </button>
          <button id="rgNext" class="rg-btn" type="button" aria-label="Próximo">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5l9 7-9 7zM16 5h2.4v14H16z" fill="currentColor"/></svg>
            <span data-i18n="next">Próximo</span>
          </button>
        </div>
        <label class="rg-speed">
          <span data-i18n="speed">Ritmo</span>
          <select id="rgSpeed" aria-label="Ritmo de leitura">
            <option value="slow" data-i18n="speed_slow">Lento</option>
            <option value="medium" selected data-i18n="speed_medium">Médio</option>
            <option value="fast" data-i18n="speed_fast">Rápido</option>
          </select>
        </label>
      </div>

      <!-- ░░ Concluir oração ░░ -->
      <div class="finish-zone">
        <div id="turnstileBox" class="turnstile-box"></div>
        <button id="finishBtn" class="btn btn-primary" type="button" data-i18n="finish_prayer">Concluir oração</button>
        <p id="finishHint" class="day-caption" hidden></p>
        <div id="postActions" class="post-actions">
          <button id="paNext" class="btn" type="button" data-i18n="next_day" hidden>Próximo dia</button>
          <button id="paAgain" class="btn" type="button" data-i18n="pray_again">Rezar de novo</button>
          <a id="paBack" class="btn" data-i18n="back_catalog">Voltar ao catálogo</a>
        </div>
      </div>

      {relatedProducts.length > 0 && (
        <section class="prod-related" aria-label="Produtos relacionados">
          <h2 class="prod-related-title" data-i18n="produtos_related">Produtos relacionados</h2>
          <div class="prod-list">
            {relatedProducts.map((p) => (
              <a class="prod-card" href={p.link} target="_blank" rel="noopener noreferrer sponsored">
                <img class="prod-thumb" src={produtoImagem(p)} alt={p.nome} loading="lazy" onerror="this.style.display='none'" />
                <span class="prod-body">
                  <span class="prod-info">
                    <span class="prod-name">{p.nome}</span>
                    {p.descricao && <span class="prod-desc">{p.descricao}</span>}
                    <span class="prod-cat" data-i18n={`prodcat_${p.categoria}`}>{catLabelPt(p.categoria)}</span>
                  </span>
                  <span class="prod-go" aria-hidden="true">↗</span>
                </span>
              </a>
            ))}
          </div>
          <p class="prod-disclosure" data-i18n="produtos_disclosure">Alguns links são de afiliados e podem gerar uma pequena comissão para manter o site no ar.</p>
        </section>
      )}
    </div>
  </article>

  <!-- ░░ Overlay de conclusão ░░ -->
  <div id="overlay" class="overlay" role="dialog" aria-modal="true" aria-labelledby="ovTitle">
    <div class="overlay-card">
      <button id="ovClose" class="ov-close" type="button" aria-label="Fechar">×</button>
      <div class="motes" id="motes" aria-hidden="true"></div>
      <div class="ov-candle"><span class="ov-flame"></span><span class="ov-body"></span></div>
      <h2 id="ovTitle" class="ov-title" data-i18n="completed_title">Oração concluída</h2>
      <p class="ov-sub" data-i18n="completed_sub">Você faz parte de uma corrente de oração.</p>
      <div id="ovNumber" class="ov-number">—</div>
      <div class="ov-number-label" data-i18n="times_prayed">vezes que esta oração já foi rezada</div>
      <!-- aviso da 2ª conclusão no mesmo dia (texto via JS: chave already_counted) -->
      <p id="ovNote" class="ov-sub" style="margin:.7rem 0 0" hidden></p>
      <div class="ov-actions">
        <button id="ovNext" class="btn btn-primary" type="button" data-i18n="next_day" hidden>Próximo dia</button>
        <!-- imagem "Rezei hoje" para Stories/Status (texto via JS: chave share_prayed) -->
        <button id="ovShare" class="btn" type="button" hidden>Compartilhar que rezei</button>
        <button id="ovAgain" class="btn" type="button" data-i18n="pray_again">Rezar de novo</button>
        <a id="ovBack" class="btn" data-i18n="back_catalog">Voltar ao catálogo</a>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ meta }}>
    (function () {
      var S = window.__SITE__ || {};
      var C = window.odContador || null; // contador da comunidade (Supabase ou Abacus) — public/js/contador.js
      var contadorAtivo = !!(C && C.ativo);
      var turnstileKey = (S.turnstile && S.turnstile.siteKey) || '';
      var t = window.odt || function (k) { return k; };
      var base = window.odBase || function (p) { return p; };

      var content = document.getElementById('prayer-content');
      if (!content) return;

      // ───────── util ─────────
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function fmt(n) {
        var l = document.documentElement.getAttribute('data-lang') || 'pt-BR';
        try { return new Intl.NumberFormat(l).format(n); } catch (e) { return String(n); }
      }
      function todayKey() {
        var d = new Date();
        return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
      }

      // ───────── dia sugerido pelo calendário litúrgico ─────────
      function suggestedDay() {
        if (!meta.feast || meta.type !== 'novena' || meta.totalDays < 1) return 0;
        var parts = meta.feast.split('-');
        if (parts.length < 2) return 0;
        var mm = parseInt(parts[parts.length - 2], 10);
        var dd = parseInt(parts[parts.length - 1], 10);
        var now = new Date(); now.setHours(0, 0, 0, 0);
        var year = now.getFullYear();
        var feast = new Date(year, mm - 1, dd);
        if (now > feast) feast = new Date(year + 1, mm - 1, dd);
        var start = new Date(feast); start.setDate(start.getDate() + (meta.startOffset || 0));
        var day = Math.floor((now - start) / 86400000) + 1;
        if (day < 1) day = 1;
        if (day > meta.totalDays) day = meta.totalDays;
        return day;
      }

      // ───────── divisão em dias (novena) ─────────
      var isNovena = meta.type === 'novena' && meta.totalDays > 1;
      var dayOfNode = new Map(); // elemento -> nº do dia (0 = comum a todos)
      var current = 1;

      if (isNovena) {
        var dayHead = /^\s*(dia|day)\s+\d+/i;
        var d = 0;
        Array.prototype.forEach.call(content.children, function (el) {
          if (el.tagName === 'H2' && dayHead.test((el.textContent || '').trim())) d += 1;
          dayOfNode.set(el, d); // tudo antes do 1º "Dia" fica no grupo 0 (intro comum)
        });
        if (d < 1) isNovena = false; // não achou marcadores -> trata como oração simples
      }

      function showDay(n) {
        current = n;
        content.querySelectorAll('.lead').forEach(function (e) { e.classList.remove('lead'); });
        dayOfNode.forEach(function (grp, el) {
          el.style.display = (grp === 0 || grp === n) ? '' : 'none';
        });
        buildBeads();
        var cap = document.getElementById('dayCaption');
        if (cap) { cap.hidden = false; cap.textContent = t('day') + ' ' + n + ' ' + t('day_of') + ' ' + meta.totalDays; }
        try { localStorage.setItem('od-progress:' + meta.slug, String(n)); } catch (e) {}
        rgReset();
        togglePostNext();
      }

      function buildBeads() {
        var wrap = document.getElementById('beads');
        if (!wrap) return;
        wrap.hidden = false;
        wrap.innerHTML = '';
        for (var i = 1; i <= meta.totalDays; i++) {
          (function (i) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'bead' + (i < current ? ' done' : '') + (i === current ? ' current' : '');
            b.textContent = i;
            b.setAttribute('aria-label', t('day') + ' ' + i);
            if (i === current) b.setAttribute('aria-current', 'true');
            b.addEventListener('click', function () { showDay(i); window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }); });
            wrap.appendChild(b);
          })(i);
        }
      }

      // ───────── rubricas (orientações) + escopo de leitura ─────────
      function isRubric(el) {
        return !!(el.classList && (el.classList.contains('rubric') || el.classList.contains('terco-mystery')));
      }
      function markRubrics() {
        // parágrafo inteiramente em itálico = orientação ("rubrica") -> o assistente pula
        var ps = content.querySelectorAll('p');
        Array.prototype.forEach.call(ps, function (pe) {
          var em = pe.querySelector(':scope > em, :scope > i');
          var txt = (pe.textContent || '').trim();
          if (em && txt.length && em.textContent.trim() === txt) pe.classList.add('rubric');
        });
      }
      // onde ficam as linhas de um bloco: no blockquote, CADA <p> (antes só o 1º era lido);
      // o blockquote continua sendo a unidade de leitura e de repetição
      function lineHosts(el) {
        if (el.tagName !== 'BLOCKQUOTE') return [el];
        var ps = el.querySelectorAll('p');
        if (!ps.length) return [el];
        return Array.prototype.filter.call(ps, function (p) { return !isRubric(p); });
      }
      function readBlocks() {
        var all = content.querySelectorAll('p, li, blockquote');
        var out = [];
        Array.prototype.forEach.call(all, function (el) {
          if (el.tagName !== 'BLOCKQUOTE' && el.closest('blockquote')) return; // o blockquote é a unidade
          if (el.offsetParent === null) return;                  // invisível (outro dia da novena)
          if ((el.textContent || '').trim().length <= 1) return;
          if (isRubric(el)) return;                              // pula orientações
          out.push(el);
        });
        return out;
      }
      function setLead() {
        content.querySelectorAll('.lead').forEach(function (e) { e.classList.remove('lead'); });
        var bl = readBlocks();
        for (var i = 0; i < bl.length; i++) { if (bl[i].tagName === 'P') { bl[i].classList.add('lead'); break; } }
      }

      // ───────── repetições ("10x") ─────────
      var REP_RE = /^\s*\{?\s*(\d{1,2})\s*[x×]\s*\}?\s*[·.\-:]?\s*/i;
      function repRender(el) {
        var st = el._rep; if (!st) return;
        for (var i = 0; i < st.dots.length; i++) st.dots[i].className = 'rep-dot' + (i < st.k ? ' on' : '');
        st.label.textContent = st.k + ' / ' + st.n;
        el.classList.toggle('rep-done', st.k >= st.n);
      }
      function repReset(el) { if (el._rep) { el._rep.k = 0; repRender(el); } }
      function setupRepeats() {
        var blocks = content.querySelectorAll('blockquote, p');
        Array.prototype.forEach.call(blocks, function (el) {
          if (el.dataset.repInit) return;
          if (el.tagName !== 'BLOCKQUOTE' && el.closest('blockquote')) return; // o blockquote é a unidade
          var tc = el.tagName === 'BLOCKQUOTE' ? (el.querySelector('p') || el) : el;
          var m = (tc.textContent || '').match(REP_RE);
          if (!m) return;
          var n = parseInt(m[1], 10);
          if (n === 1) { tc.innerHTML = tc.innerHTML.replace(REP_RE, ''); return; } // "1x": só tira o marcador, sem contas
          if (!(n >= 2 && n <= 99)) return;
          el.dataset.repInit = '1';
          tc.innerHTML = tc.innerHTML.replace(REP_RE, '');
          var bar = document.createElement('div');
          bar.className = 'rep'; bar.setAttribute('role', 'button'); bar.setAttribute('tabindex', '0');
          bar.setAttribute('aria-label', t('count_tap'));
          var dotsWrap = document.createElement('span'); dotsWrap.className = 'rep-dots';
          var dots = [];
          for (var i = 0; i < n; i++) { var d = document.createElement('i'); d.className = 'rep-dot'; dotsWrap.appendChild(d); dots.push(d); }
          var lab = document.createElement('span'); lab.className = 'rep-count';
          var hint = document.createElement('span'); hint.className = 'rep-hint'; hint.setAttribute('data-i18n','count_tap'); hint.textContent = t('count_tap');
          bar.appendChild(dotsWrap); bar.appendChild(lab); bar.appendChild(hint);
          el.appendChild(bar);
          el._rep = { n: n, k: 0, dots: dots, label: lab };
          repRender(el);
          function tap() { el._rep.k = (el._rep.k < el._rep.n) ? el._rep.k + 1 : 0; repRender(el); }
          bar.addEventListener('click', tap);
          bar.addEventListener('keydown', function (e) { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); tap(); } });
        });
      }
      function wrapLines(host) {
        if (host.dataset.lined) return;
        host.dataset.lined = '1';
        // a barra de contas ("10x") sai antes e volta depois: reescrever o HTML com ela dentro
        // a recriava sem os eventos e o texto "0 / 10 toque para contar" virava parte da oração
        var reps = Array.prototype.slice.call(host.querySelectorAll(':scope > .rep'));
        reps.forEach(function (r) { host.removeChild(r); });
        var parts = host.innerHTML.split(/<br\s*\/?>/i);
        if (parts.length <= 1) {
          host.innerHTML = '<span class="rg-line">' + host.innerHTML + '</span>';
        } else {
          var out = '';
          for (var i = 0; i < parts.length; i++) {
            var seg = parts[i];
            if (seg.replace(/<[^>]*>/g, '').trim().length === 0) { out += seg; continue; }
            out += '<span class="rg-line">' + seg + '</span>';
            if (i < parts.length - 1) out += '<br>';
          }
          host.innerHTML = out;
        }
        reps.forEach(function (r) { host.appendChild(r); });
      }
      function setupLines() {
        var bl = content.querySelectorAll('p, blockquote, li');
        Array.prototype.forEach.call(bl, function (el) {
          if (el.tagName !== 'BLOCKQUOTE' && el.closest('blockquote')) return;
          if (isRubric(el)) return;
          lineHosts(el).forEach(wrapLines);
        });
      }
      function wrapWords(lineSpan) {
        if (lineSpan.dataset.worded) return;
        lineSpan.dataset.worded = '1';
        var tokens = (lineSpan.textContent || '').split(/(\s+)/);
        var out = '';
        for (var i = 0; i < tokens.length; i++) {
          var tk = tokens[i];
          if (!tk) continue;
          if (/^\s+$/.test(tk)) { out += tk; continue; }
          out += '<span class="rg-word">' + tk.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</span>';
        }
        lineSpan.innerHTML = out;
      }
      function setupWords() { content.querySelectorAll('.rg-line').forEach(function (ln) { wrapWords(ln); }); }
      markRubrics();
      setupRepeats();
      setupLines();
      setupWords();

      // ───────── assistente de leitura (palavra a palavra) ─────────
      var blocks = [], bi = 0, li = 0, wi = 0, playing = false, timer = null;
      // conclusão: "concluindo" = registro em andamento (não deixa contar 2×);
      // "concluidaNaLeitura" = esta leitura já foi concluída (o fim do assistente não conclui de novo)
      var concluindo = false, concluidaNaLeitura = false;
      // [base ms, ms por caractere, mínimo] por PALAVRA
      var SPEED = { slow: [240, 60, 300], medium: [150, 45, 220], fast: [90, 32, 150] };
      function buildBlocks() {
        return readBlocks().map(function (el) {
          var lines = [];
          lineHosts(el).forEach(function (h) {
            Array.prototype.forEach.call(h.querySelectorAll('.rg-line'), function (ln) {
              lines.push({ span: ln, words: ln.querySelectorAll('.rg-word') });
            });
          });
          return { el: el, lines: lines, rep: el._rep || null };
        }).filter(function (b) { return b.lines.length > 0; });
      }
      function wordDwell(w) {
        var sel = document.getElementById('rgSpeed');
        var sp = SPEED[sel ? sel.value : 'medium'] || SPEED.medium;
        var len = ((w && w.textContent) || '').length || 3;
        return Math.max(sp[2], sp[0] + len * sp[1]);
      }
      function clearActive() {
        content.querySelectorAll('.rg-active').forEach(function (e) { e.classList.remove('rg-active'); });
        content.querySelectorAll('.rg-word-active').forEach(function (e) { e.classList.remove('rg-word-active'); });
      }
      function paint() {
        clearActive();
        var b = blocks[bi]; if (!b) return;
        var line = b.lines[li]; if (!line) return;
        line.span.classList.add('rg-active');
        var w = line.words[wi];
        if (w) w.classList.add('rg-word-active');
        if (!reduce && line.span !== _lastCentered) {
          _lastCentered = line.span;
          centerOn(line.span);
        }
      }
      var _lastCentered = null;
      function centerOn(el) {
        var r = el.getBoundingClientRect();
        // mantém a linha por volta de 42% da altura da tela (acima do centro, livre da barra)
        var target = window.scrollY + r.top - (window.innerHeight * 0.42 - r.height / 2);
        window.scrollTo({ top: Math.max(0, target), behavior: 'smooth' });
      }
      function enterBlock() { var b = blocks[bi]; if (b && b.rep) { b.rep.k = 1; repRender(b.el); } }
      function playLabel() {
        var lab = document.getElementById('rgPlayLabel');
        if (lab) lab.textContent = playing ? t('pause') : ((bi > 0 || li > 0 || wi > 0) ? t('resume') : t('start'));
        var btn = document.getElementById('rgPlay');
        if (btn) { btn.classList.toggle('is-playing', playing); btn.setAttribute('aria-label', lab ? lab.textContent : ''); }
      }
      function onReadingEnd() {
        playing = false;
        var lastB = blocks.length - 1;
        if (lastB >= 0) {
          bi = lastB; li = blocks[lastB].lines.length - 1;
          var lw = blocks[lastB].lines[li]; wi = lw ? Math.max(0, lw.words.length - 1) : 0;
        }
        playLabel();
        doFinish(true); // marca como rezada automaticamente (conta na oração e no total)
      }
      function step() {
        if (!playing) return;
        var b = blocks[bi];
        if (!b) { onReadingEnd(); return; }
        var line = b.lines[li];
        if (!line) { onReadingEnd(); return; }
        paint();
        var w = line.words[wi];
        timer = setTimeout(function () {
          if (wi < line.words.length - 1) { wi++; step(); return; }                 // próxima palavra
          if (li < b.lines.length - 1) { li++; wi = 0; step(); return; }             // próxima linha
          if (b.rep && b.rep.k < b.rep.n) { b.rep.k++; repRender(b.el); li = 0; wi = 0; step(); return; } // repetição
          bi++; li = 0; wi = 0;                                                      // próximo bloco
          if (bi >= blocks.length) { onReadingEnd(); return; }
          enterBlock(); step();
        }, wordDwell(w));
      }
      function play() {
        blocks = buildBlocks();
        if (!blocks.length) return;
        if (bi >= blocks.length) { bi = 0; li = 0; wi = 0; }
        playing = true; playLabel();
        if (li === 0 && wi === 0) enterBlock();
        step();
      }
      function pause() { playing = false; if (timer) clearTimeout(timer); playLabel(); }
      function rgReset() {
        pause(); bi = 0; li = 0; wi = 0; _lastCentered = null; blocks = buildBlocks();
        concluidaNaLeitura = false; // nova leitura
        clearActive();
        blocks.forEach(function (b) { if (b.rep) repReset(b.el); });
        setLead();
      }
      document.getElementById('rgPlay').addEventListener('click', function () { playing ? pause() : play(); });
      document.getElementById('rgRestart').addEventListener('click', function () {
        pause(); bi = 0; li = 0; wi = 0; _lastCentered = null; blocks = buildBlocks();
        concluidaNaLeitura = false; // nova leitura
        blocks.forEach(function (b) { if (b.rep) repReset(b.el); });
        if (blocks.length) { enterBlock(); paint(); } playLabel();
      });
      document.getElementById('rgNext').addEventListener('click', function () {
        pause(); blocks = buildBlocks(); if (!blocks.length) return;
        bi = Math.min(bi + 1, blocks.length - 1); li = 0; wi = 0;
        enterBlock(); paint(); playLabel();
      });

      // ───────── Terço: mistérios por dia da semana (exclusivo desta oração) ─────────
      if (meta.slug === 'terco') {
        var MYS = {
          gozosos: ['A Anunciação do Anjo a Maria', 'A Visitação de Maria a Isabel', 'O Nascimento de Jesus em Belém', 'A Apresentação do Menino Jesus no Templo', 'O Encontro do Menino Jesus no Templo'],
          dolorosos: ['A Agonia de Jesus no Horto', 'A Flagelação do Senhor', 'A Coroação de Espinhos', 'Jesus a caminho do Calvário', 'A Crucifixão e Morte de Jesus'],
          gloriosos: ['A Ressurreição de Jesus', 'A Ascensão do Senhor ao Céu', 'A Vinda do Espírito Santo', 'A Assunção de Maria ao Céu', 'A Coroação de Maria, Rainha do Céu'],
          luminosos: ['O Batismo de Jesus no Jordão', 'A revelação de Jesus nas Bodas de Caná', 'O Anúncio do Reino de Deus', 'A Transfiguração do Senhor', 'A Instituição da Eucaristia']
        };
        var ADJ = { gozosos: 'Gozoso', dolorosos: 'Doloroso', gloriosos: 'Glorioso', luminosos: 'Luminoso' };
        var BYDAY = ['gloriosos', 'gozosos', 'dolorosos', 'gloriosos', 'luminosos', 'dolorosos', 'gozosos']; // 0=Dom..6=Sáb
        var ABBR = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
        var FULL = ['Domingo', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado'];
        var tSlots = content.querySelectorAll('.terco-mystery');
        var tHost = document.getElementById('terco-days');
        var tBtns = [];
        function tFill(setKey) {
          var arr = MYS[setKey], adj = ADJ[setKey];
          for (var i = 0; i < tSlots.length && i < arr.length; i++) tSlots[i].textContent = (i + 1) + 'º Mistério ' + adj + ' — ' + arr[i];
        }
        function tSelect(d) {
          tFill(BYDAY[d]);
          for (var i = 0; i < tBtns.length; i++) {
            var on = (i === d); tBtns[i].classList.toggle('day-on', on);
            if (on) tBtns[i].setAttribute('aria-current', 'true'); else tBtns[i].removeAttribute('aria-current');
          }
        }
        if (tHost) {
          tHost.innerHTML = '';
          var lbl = document.createElement('div'); lbl.className = 'terco-days-label'; lbl.textContent = 'Toque no dia para ver os mistérios:';
          var rowEl = document.createElement('div'); rowEl.className = 'terco-days-row';
          for (var d = 0; d < 7; d++) (function (d) {
            var b = document.createElement('button'); b.type = 'button'; b.className = 'day-chip';
            b.textContent = ABBR[d]; b.setAttribute('aria-label', FULL[d]);
            b.addEventListener('click', function () { tSelect(d); });
            rowEl.appendChild(b); tBtns.push(b);
          })(d);
          tHost.appendChild(lbl); tHost.appendChild(rowEl);
        }
        tSelect(new Date().getDay()); // dia de hoje já selecionado
      }

      // ───────── Turnstile (CAPTCHA) opcional ─────────
      var turnstileReady = false;
      if (turnstileKey) {
        var box = document.getElementById('turnstileBox');
        var s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        s.async = true; s.defer = true;
        s.onload = function () {
          try {
            window.turnstile.render(box, { sitekey: turnstileKey, theme: 'auto' });
            turnstileReady = true;
          } catch (e) {}
        };
        document.head.appendChild(s);
      }

      // ───────── contador + conclusão ─────────
      // texto de interface com reserva em PT (chave que ainda não está no site.ts)
      function tt(k, pt) { var v = t(k); return (v == null || v === k) ? pt : v; }
      // valor do contador desta oração; null = não deu para saber (a capa fica oculta, nunca "0").
      // odContador já tem prazo e nunca rejeita (rede caída, bloqueador ou serviço fora → null)
      function readCount(slug) {
        if (!contadorAtivo) return Promise.resolve(null);
        return C.ler([slug]).then(function (m) { return (m && typeof m[slug] === 'number') ? m[slug] : null; }, function () { return null; });
      }
      // últimos números do serviço (nunca a reserva): 2ª conclusão do dia e imagem "Rezei hoje"
      var numVivo = null, numOverlay = null;
      function animateNumber(el, to) {
        if (reduce || to == null) { el.textContent = to == null ? '—' : fmt(to); return; }
        var from = 0, dur = 1300, t0 = performance.now();
        function frame(now) {
          var p = Math.min(1, (now - t0) / dur);
          var e = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt(Math.round(from + (to - from) * e));
          if (p < 1) requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      }
      function spawnMotes() {
        var box = document.getElementById('motes');
        if (!box || reduce) return;
        box.innerHTML = '';
        for (var i = 0; i < 18; i++) {
          var m = document.createElement('span');
          m.className = 'mote';
          m.style.left = Math.random() * 100 + '%';
          m.style.animationDuration = (2 + Math.random() * 2.5) + 's';
          m.style.animationDelay = (Math.random() * 1.2) + 's';
          m.style.setProperty('--dx', (Math.random() * 60 - 30) + 'px');
          box.appendChild(m);
        }
      }
      function togglePostNext() {
        var show = isNovena && current < meta.totalDays;
        // style.display além do hidden: o CSS .btn{display:inline-flex} anula o atributo hidden
        ['paNext', 'ovNext'].forEach(function (id) { var b = document.getElementById(id); if (b) { b.hidden = !show; b.style.display = show ? '' : 'none'; } });
      }
      function updateReaderCount(v) {
        if (v == null || !(v > 0)) return; // sem número confiável (ou zero): a capa continua oculta
        var n = document.getElementById('readerCountNum');
        var box = document.getElementById('readerCount');
        if (n) n.textContent = fmt(v);
        if (box) box.hidden = false;
      }
      // o overlay abre na hora; o número chega depois (fillOverlay) ou fica "—"
      function openOverlay() {
        var ov = document.getElementById('overlay');
        numOverlay = null;
        document.getElementById('ovNumber').textContent = '…';
        document.querySelector('.ov-number-label').style.display = 'none';
        if (ovShare) { ovShare.hidden = !window.odCompartilhar; rotularOvShare(); }
        ov.classList.add('show');
        spawnMotes();
        togglePostNext();
      }
      function fillOverlay(total) {
        if (!(total > 0)) total = null; // falhou (ou zero): "—", sem inventar número
        numOverlay = total;
        if (total != null) numVivo = total;
        document.querySelector('.ov-number-label').style.display = (total == null) ? 'none' : '';
        animateNumber(document.getElementById('ovNumber'), total);
        updateReaderCount(total);
      }
      // "Compartilhar que rezei": imagem "Rezei hoje" para Stories/Status (public/js/compartilhar.js)
      var ovShare = document.getElementById('ovShare');
      function rotularOvShare() { if (ovShare) ovShare.textContent = tt('share_prayed', 'Compartilhar que rezei'); }
      if (ovShare) ovShare.addEventListener('click', function () {
        if (!window.odCompartilhar) return;
        var n = numOverlay != null ? numOverlay : numVivo; // contagem da oração (sem número: sem a linha)
        window.odCompartilhar.abrir({
          rotulo: isNovena ? tt('prayed_day', 'Rezei o {n}º dia da').replace('{n}', current) : tt('prayed_today', 'Rezei hoje'),
          titulo: meta.titulo,
          linhas: n > 1 ? [tt('prayed_with', 'numa corrente de {n} orações').replace('{n}', fmt(n))] : [],
          banner: meta.banner, bannerReserva: meta.bannerReserva,
          caminho: meta.caminho, dominio: meta.dominio,
          arquivo: 'rezei-' + meta.slug + (isNovena ? '-dia-' + current : '')
        });
      });
      // aviso da 2ª conclusão no mesmo dia
      function setNote(on) {
        var n = document.getElementById('ovNote');
        if (!n) return;
        n.hidden = !on;
        n.textContent = on ? tt('already_counted', 'Sua oração de hoje já foi contada.') : '';
      }
      function closeOverlay() { document.getElementById('overlay').classList.remove('show'); }

      var finishBtn = document.getElementById('finishBtn');
      function doFinish(auto) {
        pause();                                // o assistente para: nada avança nem rola atrás do overlay
        var hint = document.getElementById('finishHint');
        if (hint) hint.hidden = true;
        if (concluindo) return;                 // já há um registro em andamento (evita contar 2×)
        if (auto && concluidaNaLeitura) return; // o assistente chegou ao fim depois de "Concluir": não conclui de novo
        if (turnstileKey) {
          var tok = '';
          try { tok = window.turnstile ? window.turnstile.getResponse() : ''; } catch (e) {}
          if (!tok) { if (!auto && hint) { hint.hidden = false; hint.textContent = t('captcha_needed'); } return; }
        }
        var guardKey = 'od-done:' + meta.slug + ':' + (isNovena ? current : 0) + ':' + todayKey();
        var already = false;
        try { already = !!localStorage.getItem(guardKey); } catch (e) {}
        concluidaNaLeitura = true;
        document.getElementById('postActions').style.display = 'flex';
        openOverlay();
        setNote(contadorAtivo && already);
        if (!contadorAtivo) { fillOverlay(null); return; }
        // já contada hoje: mostra o número mais novo que a página conhece (a leitura do
        // odContador é guardada por página e seria a de antes da contagem)
        if (already) { if (numVivo != null) fillOverlay(numVivo); else readCount(meta.slug).then(fillOverlay); return; }
        concluindo = true;
        finishBtn.disabled = true;
        var old = finishBtn.textContent;
        finishBtn.textContent = t('finishing');
        C.contarOracao(meta.slug)
          .then(function (r) {
            var mine = r ? r.oracao : null;
            // só marca "já contada hoje" quando a contagem desta oração deu certo
            if (mine != null) { try { localStorage.setItem(guardKey, '1'); } catch (e) {} }
            if (r && r.total != null) { try { localStorage.setItem('od-total-cache', String(r.total)); } catch (e) {} }
            fillOverlay(mine); // falhou → "—" (não finge que contou)
          }, function () { fillOverlay(null); })
          .finally(function () { concluindo = false; finishBtn.disabled = false; finishBtn.textContent = old; });
      }
      finishBtn.addEventListener('click', function () { doFinish(false); });

      // ── Ferramentas: favoritar, compartilhar, tamanho da fonte, foco ──
      (function () {
        var favBtn = document.getElementById('favBtn');
        if (favBtn && window.odFav) {
          var setFav = function () {
            var on = window.odFav.has(meta.slug);
            favBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
            var lab = favBtn.querySelector('span');
            if (lab) lab.textContent = t(on ? 'fav_saved' : 'fav_save');
          };
          setFav();
          favBtn.addEventListener('click', function () { window.odFav.toggle(meta.slug); setFav(); });
          document.addEventListener('od:lang', setFav);
        }
        var shareBtn = document.getElementById('shareBtn');
        if (shareBtn) {
          shareBtn.addEventListener('click', function () {
            var url = location.href.split('#')[0];
            // menu do aparelho; se falhar (sem ser cancelamento), copia o link; "Link copiado!" só se
            // copiou; sem área de transferência, mostra o endereço — ver public/js/compartilhar.js
            if (window.odCompartilhar) { window.odCompartilhar.link({ url: url, titulo: document.title, botao: shareBtn }); return; }
            if (navigator.share) navigator.share({ title: document.title, url: url }).catch(function () {});
          });
        }
        var FKEY = 'od-fontscale';
        var STEPS = [0.9, 1, 1.15, 1.3, 1.45];
        var fi = 1;
        try { var sv = parseFloat(localStorage.getItem(FKEY)); if (sv) { var k = STEPS.indexOf(sv); fi = k >= 0 ? k : 1; } } catch (e) {}
        function applyScale() {
          document.documentElement.style.setProperty('--reader-scale', String(STEPS[fi]));
          try { localStorage.setItem(FKEY, String(STEPS[fi])); } catch (e) {}
        }
        applyScale();
        var up = document.getElementById('fsUp'), down = document.getElementById('fsDown');
        if (up) up.addEventListener('click', function () { fi = Math.min(STEPS.length - 1, fi + 1); applyScale(); });
        if (down) down.addEventListener('click', function () { fi = Math.max(0, fi - 1); applyScale(); });
        var focusBtn = document.getElementById('focusBtn');
        if (focusBtn) focusBtn.addEventListener('click', function () {
          var on = document.body.classList.toggle('reader-focus');
          focusBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      })();

      // ações pós-oração
      function goNext() { if (current < meta.totalDays) { showDay(current + 1); } closeOverlay(); window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }); }
      function again() { closeOverlay(); rgReset(); window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }); play(); }
      var catalogHref = base('/') + '#catalogo';
      ['ovBack', 'paBack'].forEach(function (id) { var a = document.getElementById(id); if (a) a.setAttribute('href', catalogHref); });
      document.getElementById('ovNext').addEventListener('click', goNext);
      document.getElementById('paNext').addEventListener('click', goNext);
      document.getElementById('ovAgain').addEventListener('click', again);
      document.getElementById('paAgain').addEventListener('click', again);
      document.getElementById('ovClose').addEventListener('click', closeOverlay);
      document.getElementById('overlay').addEventListener('click', function (e) { if (e.target === this) closeOverlay(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeOverlay(); });

      // atualiza textos dinâmicos ao trocar idioma
      document.addEventListener('od:lang', function () {
        playLabel();
        if (isNovena) { var cap = document.getElementById('dayCaption'); if (cap) cap.textContent = t('day') + ' ' + current + ' ' + t('day_of') + ' ' + meta.totalDays; }
        var nt = document.getElementById('ovNote'); if (nt && !nt.hidden) setNote(true);
        rotularOvShare();
      });

      // ───────── início ─────────
      var startDay = 1;
      if (isNovena) {
        var q = new URLSearchParams(location.search).get('dia');
        var saved = null; try { saved = localStorage.getItem('od-progress:' + meta.slug); } catch (e) {}
        if (q && +q >= 1 && +q <= meta.totalDays) startDay = +q;
        else if (saved && +saved >= 1 && +saved <= meta.totalDays) startDay = +saved;
        else { var sg = suggestedDay(); startDay = sg || 1; }
        showDay(startDay);
      } else {
        setLead();
        blocks = buildBlocks();
      }

      // contagem desta oração, mostrada na capa. Se a leitura falhar, usa o número de reserva
      // do build (src/data/contadores.json); sem reserva, a capa fica oculta (nunca "0")
      if (contadorAtivo) {
        readCount(meta.slug).then(function (v) {
          if (v > 0 && numVivo == null) numVivo = v;
          if (v == null && meta.reserva > 0) v = meta.reserva;
          updateReaderCount(v);
        });
      }

      // limpeza: marcas "od-done:…" com mais de 30 dias (antes cresciam para sempre)
      // e as antigas "od-mine:…" (não são mais usadas)
      try {
        var limite = Date.now() - 30 * 86400000;
        for (var ki = localStorage.length - 1; ki >= 0; ki--) {
          var kk = localStorage.key(ki);
          if (kk && kk.indexOf('od-mine:') === 0) { localStorage.removeItem(kk); continue; }
          if (!kk || kk.indexOf('od-done:') !== 0) continue;
          var kd = kk.slice(kk.lastIndexOf(':') + 1).split('-');
          if (!(new Date(+kd[0], +kd[1] - 1, +kd[2]).getTime() >= limite)) localStorage.removeItem(kk);
        }
      } catch (e) {}
    })();
  </script>
