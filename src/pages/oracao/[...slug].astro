---
import fs from 'node:fs';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site, ui, withBase } from '../../config/site';
import { produtosForPage, produtoImagem, catLabelPt } from '../../config/produtos';
import { bioDaOracao, nomeDaBio } from '../../config/relacoes';
import { reserva } from '../../config/contadores';
import CompartilharStories from '../../components/CompartilharStories.astro';
import { prepararOracao } from '../../scripts/oracao/preparar';
import { modoMisterios } from '../../scripts/oracao/misterios';
import { srcsetDoBanner, SIZES_BANNER } from '../../scripts/oracao/banner';

export async function getStaticPaths() {
  const entries = await getCollection('prayers');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
// H3: o texto declara a própria língua (Hail Mary = en), mesmo com a interface em outro idioma
const lingua = data.language || 'pt-BR';

const imagem = data.image ?? `/saints/${entry.id}.webp`;
const banner = withBase(imagem);
const imgFallback = withBase('/saints/default.webp');
// E4: banner responsivo — srcset só com as variantes que existem (src/scripts/oracao/banner.ts)
const bannerSrcset = srcsetDoBanner(imagem);
// ponto da imagem que fica à vista quando ela é cortada (celular, Imersão, Stories) — campo imageFocus
const foco = data.imageFocus ?? '';

// camada de paralaxe só se o arquivo existir em public/ (antes: /textures/rays.svg dava 404 em 31 orações)
const _px = data.parallaxImage ?? '';
const _pxOk = !!_px && (/^https?:\/\//.test(_px) || fs.existsSync(`public${_px.startsWith('/') ? '' : '/'}${_px}`));
if (_px && !_pxOk) console.warn(`⚠️  Oração "${entry.id}": parallaxImage "${_px}" não existe em public/ — camada omitida.`);
const parallax = _pxOk ? withBase(_px) : '';

// E3/E8: o texto sai do build já preparado (rubricas, contas "Nx", seções repetidas, dias da
// novena, capitular, mistérios) — o navegador não reescreve mais nada ao abrir
const misterios = modoMisterios(entry.id);
const ehNovena = data.type === 'novena' && (data.totalDays ?? 0) > 1;
const htmlBruto = (entry as any).rendered?.html as string | undefined;
const prep = htmlBruto ? prepararOracao(htmlBruto, { novena: ehNovena, misterios }) : null;
if (!prep) console.warn(`⚠️  Oração "${entry.id}": sem HTML renderizado — texto sem preparação.`);
for (const a of prep?.avisos ?? []) console.warn(`⚠️  Oração "${entry.id}": ${a}`);
const dias = prep && prep.dias > 1 ? prep.dias : 0;
// 1º dia da novena = festa + início (sem o campo: termina na véspera da festa)
const inicioNovena = data.novenaSuggestedStart ?? -dias;
if (ehNovena && dias !== data.totalDays) console.warn(`⚠️  Novena "${entry.id}": totalDays ${data.totalDays}, mas o texto tem ${prep?.dias ?? 0} "## Dia N" — vale o texto.`);

// dados que o módulo da página precisa (src/scripts/oracao/leitor.ts)
const caminho = withBase(`/oracao/${entry.id}`);
const rotuloTipo = (ui['pt-BR'] as Record<string, string>)[`type_${data.type}`] ?? data.type;
const dados = {
  slug: entry.id,
  type: data.type,
  dias,
  // imagem "Rezei hoje" (D2)
  titulo: data.title,
  banner,
  bannerReserva: imgFallback,
  caminho,
  dominio: (Astro.site?.host ?? 'oratoriodigital.com').replace(/^www\./, ''),
  // número de reserva da capa, se o contador estiver fora do ar (src/data/contadores.json)
  reserva: reserva(entry.id),
  misterios,
  lingua,
  bannerFoco: foco,     // "x% y%" ou '' (centro)
};
const dadosJson = JSON.stringify(dados).replace(/</g, '\\u003c');

// ligação automática para a biografia — regra única em src/config/relacoes.ts
// (pelo nome do santo; a data da festa só desempata) — sem editar os .md
const _bios = await getCollection('biografias');
const _bio = bioDaOracao(entry, _bios);
const relatedBio: { id: string; name: string } | null = _bio ? { id: _bio.id, name: nomeDaBio(_bio) } : null;

// produtos relacionados (por slug da página ou por santo) — sem editar os .md
const relatedProducts = produtosForPage(entry.id, data.saint);
---
<Base title={data.title} description={data.description || site.tagline} idioma={lingua}>
  <Fragment slot="head">
    <!-- antes de pintar: tamanho da letra e Modo Foco salvos (o resto fica no módulo da página) -->
    <script is:inline>
      (function () {
        try {
          var s = parseFloat(localStorage.getItem('od-fontscale'));
          if (s >= 0.8 && s <= 1.6) document.documentElement.style.setProperty('--reader-scale', String(s));
          if (localStorage.getItem('od-foco') === '1') document.documentElement.classList.add('od-foco');
          if (localStorage.getItem('od-rosario') === 'trad') document.documentElement.classList.add('od-trad');
        } catch (e) {}
      })();
    </script>
  </Fragment>
  <article>
    <!-- ░░ Banner com paralaxe ░░ -->
    <header class="reader-hero">
      <img class="reader-bg" src={banner} srcset={bannerSrcset || undefined} sizes={bannerSrcset ? SIZES_BANNER : undefined}
        alt={data.saint ?? data.title} width="1600" height="1000" fetchpriority="high" style={foco ? `object-position: ${foco}` : undefined}
        onerror={`this.onerror=null;this.removeAttribute('srcset');this.src='${imgFallback}'`} />
      {parallax && <div class="reader-parallax" data-parallax="0.34" style={`background-image:url(${parallax})`}></div>}
      <div class="reader-shade"></div>
      <div class="reader-head">
        <p class="reader-type" data-i18n={`type_${data.type}`}>{data.type}</p>
        <h1 class="reader-title" lang={lingua}>{data.title}</h1>
        {data.saint && <p class="reader-saint" lang={lingua}>{data.saint}</p>}
        <p class="reader-count" id="readerCount" hidden><span class="rc-num" id="readerCountNum">—</span> <span class="rc-label" data-i18n="count_short">vezes rezada</span></p>
      </div>
    </header>

    <div class="reader-body">
      <!-- ░░ Ferramentas de leitura ░░ -->
      <div class="reader-tools" role="group" aria-label="Ferramentas de leitura" data-i18n-aria="reader_tools">
        <button id="favBtn" class="rtool" type="button" aria-pressed="false">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path class="hpath" d="M12 21l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.18L12 21z" stroke-width="2"/></svg>
          <span data-i18n="fav_save">Salvar</span>
        </button>
        <button id="shareBtn" class="rtool" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9V5l7 7-7 7v-4.1C9 11.8 5.5 13 3 16c1-5 4-9 11-9.9z" fill="currentColor"/></svg>
          <span data-i18n="share">Compartilhar</span>
        </button>
        <CompartilharStories modo="oracao" titulo={data.title} rotulo={rotuloTipo} rotuloChave={`type_${data.type}`}
          banner={banner} bannerReserva={imgFallback} foco={foco} caminho={caminho} corpo={entry.body} destaque={data.destaque} />
        <span class="rtool-sep" aria-hidden="true"></span>
        <button id="fsDown" class="rtool rtool-sq" type="button" aria-label="Diminuir letra" data-i18n-aria="font_smaller">A−</button>
        <button id="fsUp" class="rtool rtool-sq" type="button" aria-label="Aumentar letra" data-i18n-aria="font_larger">A+</button>
        <button id="focusBtn" class="rtool" type="button" aria-pressed="false">
          <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span data-i18n="focus_mode">Foco</span>
        </button>
        <!-- Modo Imersão: imagem de fundo, velas e o texto passando no meio (src/scripts/oracao/imersao.ts) -->
        <button id="imersaoBtn" class="rtool" type="button" aria-pressed="false">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6c1.7 2.1 2.7 3.5 2.7 5a2.7 2.7 0 0 1-5.4 0c0-1.5 1-2.9 2.7-5z" fill="currentColor"/><path d="M12 10.4v1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><rect x="8.6" y="12.6" width="6.8" height="8.6" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          <span data-i18n="immersion_mode">Imersão</span>
        </button>
        <!-- G1: só aparece onde o navegador permite manter a tela acesa (Wake Lock API) -->
        <button id="wakeBtn" class="rtool" type="button" aria-pressed="false" hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          <span data-i18n="keep_awake">Manter tela acesa</span>
        </button>
      </div>

      {relatedBio && (
        <a class="bio-link" href={withBase(`/biografia/${relatedBio.id}`)}>
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v15H5.5C4.7 19 4 18.3 4 17.5v-12zM20 5.5C20 4.7 19.3 4 18.5 4H13v15h5.5c.8 0 1.5-.7 1.5-1.5v-12z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <span><span data-i18n="bio_about">Conheça a vida de</span> {relatedBio.name}</span>
        </a>
      )}

      <!-- ░░ Seletor de dia (novena) — contas de rosário; dias rezados marcados pelo script logo abaixo do texto ░░ -->
      {dias > 0 && (
        <nav id="beads" class="beads" aria-label="Dias da novena" data-i18n-aria="novena_days">
          {Array.from({ length: dias }, (_, i) => (
            <button type="button" class={i === 0 ? 'bead current' : 'bead'} data-dia={i + 1} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Dia ${i + 1}`}>{i + 1}</button>
          ))}
        </nav>
      )}
      {dias > 0 && <p id="dayCaption" class="day-caption" aria-live="polite">1º dia · faltam {dias - 1}</p>}

      <!-- ░░ Texto da oração (preparado no build; o assistente não reescreve o HTML) ░░ -->
      {prep
        ? <div id="prayer-content" class="prayer-body" lang={lingua} data-slug={entry.id} data-dias={dias || undefined}
            data-festa={dias ? (data.liturgicalFeast ?? '') : undefined} data-inicio={dias ? inicioNovena : undefined}
            set:html={prep.html}></div>
        : <div id="prayer-content" class="prayer-body" lang={lingua}><Content /></div>}

      {/* Novena: o dia é escolhido ANTES de pintar (sem "piscar" o dia 1), e contas e legenda saem prontas.
          Ordem: ?dia=N > 1º dia ainda não rezado neste ciclo > dia do calendário > 1.
          Progresso (B3): só dias CONCLUÍDOS (gravados pelo módulo ao concluir), por ciclo = a festa que a
          novena prepara (vale até 7 dias depois dela); sem festa válida, ciclo "livre" (30 dias desde a
          última conclusão). Datas sempre por window.odCalendario (festas móveis e horário de verão — J2).
          window.__odNovena.pintar() é reaproveitado pelo módulo (src/scripts/oracao/novena.ts). */}
      {dias > 0 && (
        <script is:inline>
(function () {
var c = document.getElementById('prayer-content'); if (!c) return;
var N = +c.getAttribute('data-dias'), slug = c.getAttribute('data-slug'), festa = c.getAttribute('data-festa') || '', ini = +c.getAttribute('data-inicio') || 0;
var K = window.odCalendario, ciclo = 'livre', sug = 0, feitos = [];
try { if (K && festa && K.valido(festa)) { var hoje = K.hoje(), f = K.proxima(festa, K.somarDias(hoje, -7));
  if (f) { ciclo = f.getFullYear() + '-' + (f.getMonth() + 1) + '-' + f.getDate(); var d = K.dias(K.somarDias(f, ini), hoje) + 1; if (d >= 1 && d <= N) sug = d; } } } catch (e) {}
try { var p = JSON.parse(localStorage.getItem('od-novena:' + slug) || 'null');
  if (p && p.ciclo === ciclo && (ciclo !== 'livre' || Date.now() - (p.em || 0) < 2592e6)) feitos = (p.feitos || []).filter(function (x) { return x >= 1 && x <= N; }); } catch (e) {}
var q = +(new URLSearchParams(location.search).get('dia') || 0), dia = sug || 1;
if (q >= 1 && q <= N) dia = q; else if (feitos.length) { dia = N; for (var i = N; i >= 1; i--) if (feitos.indexOf(i) < 0) dia = i; }
function tx(k, pt) { var v = window.odt ? window.odt(k) : k; return v == null || v === k ? pt : v; }
var nv = window.__odNovena = { N: N, ciclo: ciclo, feitos: feitos, dia: dia, sugerido: sug, pintar: function () {
  var a = nv.dia, fe = nv.feitos, j, els = c.querySelectorAll('[data-dia]'), bs = document.querySelectorAll('#beads .bead');
  for (j = 0; j < els.length; j++) els[j].hidden = +els[j].getAttribute('data-dia') !== a;
  for (j = 0; j < bs.length; j++) { var n = j + 1, ok = fe.indexOf(n) >= 0;
    bs[j].className = 'bead' + (ok ? ' done' : '') + (n === a ? ' current' : '');
    bs[j].setAttribute('aria-pressed', n === a ? 'true' : 'false');
    bs[j].setAttribute('aria-label', tx('day', 'Dia') + ' ' + n + (ok ? ', ' + tx('novena_prayed', 'rezado') : '')); }
  var cap = document.getElementById('dayCaption'), feito = fe.indexOf(a) >= 0, r = N - fe.length - (feito ? 0 : 1);
  if (cap) cap.textContent = tx('novena_day', '{n}º dia').replace('{n}', a) + (feito ? ' ✓' : '') + ' · ' + (fe.length >= N ? tx('novena_done', 'novena concluída')
    : r <= 0 ? tx('novena_last', 'último dia') : r === 1 ? tx('novena_left_one', 'falta 1') : tx('novena_left', 'faltam {n}').replace('{n}', r));
} };
nv.pintar();
})();
        </script>
      )}

      <!-- ░░ Assistente de leitura ░░ -->
      <div class="rg-bar" role="group" aria-label="Assistente de leitura" data-i18n-aria="reading_assistant">
        <span class="rg-title" data-i18n="reading_assistant">Assistente de leitura</span>
        <div class="rg-controls">
          <button id="rgPlay" class="rg-btn" type="button" aria-label="Iniciar">
            <svg class="i-play" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l12 7-12 7z" fill="currentColor"/></svg>
            <svg class="i-pause" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z" fill="currentColor"/></svg>
            <span id="rgPlayLabel">Iniciar</span>
          </button>
          <button id="rgRestart" class="rg-btn" type="button" aria-label="Reiniciar" data-i18n-aria="restart">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V2L7 6l5 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z" fill="currentColor"/></svg>
            <span data-i18n="restart">Reiniciar</span>
          </button>
          <button id="rgNext" class="rg-btn" type="button" aria-label="Próximo" data-i18n-aria="next">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5l9 7-9 7zM16 5h2.4v14H16z" fill="currentColor"/></svg>
            <span data-i18n="next">Próximo</span>
          </button>
          <!-- Modo Foco também aqui: liga e desliga no meio da leitura, sem parar o assistente -->
          <button id="rgFoco" class="rg-btn" type="button" aria-pressed="false" aria-label="Modo Foco" data-i18n-aria="focus_mode_aria">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <span data-i18n="focus_mode">Foco</span>
          </button>
          <!-- Imersão também aqui: entra e sai no meio da leitura, sem parar o assistente -->
          <button id="rgImersao" class="rg-btn" type="button" aria-pressed="false" aria-label="Modo Imersão" data-i18n-aria="immersion_mode_aria">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6c1.7 2.1 2.7 3.5 2.7 5a2.7 2.7 0 0 1-5.4 0c0-1.5 1-2.9 2.7-5z" fill="currentColor"/><path d="M12 10.4v1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><rect x="8.6" y="12.6" width="6.8" height="8.6" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
            <span data-i18n="immersion_mode">Imersão</span>
          </button>
        </div>
        <label class="rg-speed">
          <span data-i18n="speed">Ritmo</span>
          <select id="rgSpeed" aria-label="Ritmo de leitura" data-i18n-aria="speed">
            <option value="slow" data-i18n="speed_slow">Lento</option>
            <option value="medium" selected data-i18n="speed_medium">Médio</option>
            <option value="fast" data-i18n="speed_fast">Rápido</option>
          </select>
        </label>
      </div>

      <!-- ░░ Concluir oração ░░ -->
      <div class="finish-zone">
        <div id="turnstileBox" class="turnstile-box"></div>
        <button id="finishBtn" class="btn btn-primary" type="button" data-i18n="finish_prayer">Concluir oração</button>
        <p id="finishHint" class="day-caption" hidden></p>
        <div id="postActions" class="post-actions">
          <button id="paNext" class="btn" type="button" data-i18n="next_day" hidden>Próximo dia</button>
          <button id="paAgain" class="btn" type="button" data-i18n="pray_again">Rezar de novo</button>
          <a id="paBack" class="btn" data-i18n="back_catalog">Voltar ao catálogo</a>
          <!-- outra oração ao acaso, de preferência uma que ainda não abriu (public/js/sortear.js) -->
          <a id="paSortear" class="btn btn-sortear" href={withBase('/sortear')} data-od-sortear>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span data-i18n="random_another">Conhecer outra oração</span>
          </a>
        </div>
      </div>

      {relatedProducts.length > 0 && (
        <section class="prod-related" aria-label="Produtos relacionados">
          <h2 class="prod-related-title" data-i18n="produtos_related">Produtos relacionados</h2>
          <div class="prod-list">
            {relatedProducts.map((p) => (
              <a class="prod-card" href={p.link} target="_blank" rel="noopener noreferrer sponsored">
                <img class="prod-thumb" src={produtoImagem(p)} alt={p.nome} loading="lazy" onerror="this.style.display='none'" />
                <span class="prod-body">
                  <span class="prod-info">
                    <span class="prod-name">{p.nome}</span>
                    {p.descricao && <span class="prod-desc">{p.descricao}</span>}
                    <span class="prod-cat" data-i18n={`prodcat_${p.categoria}`}>{catLabelPt(p.categoria)}</span>
                  </span>
                  <span class="prod-go" aria-hidden="true">↗</span>
                </span>
              </a>
            ))}
          </div>
          <p class="prod-disclosure" data-i18n="produtos_disclosure">Alguns links são de afiliados e podem gerar uma pequena comissão para manter o site no ar.</p>
        </section>
      )}
    </div>
  </article>

  <!-- ░░ Overlay de conclusão (título, subtítulo e avisos traduzidos pelo módulo) ░░ -->
  <div id="overlay" class="overlay" role="dialog" aria-modal="true" aria-labelledby="ovTitle">
    <div class="overlay-card">
      <button id="ovClose" class="ov-close" type="button" aria-label="Fechar" data-i18n-aria="close">×</button>
      <div class="motes" id="motes" aria-hidden="true"></div>
      <div class="ov-candle"><span class="ov-flame"></span><span class="ov-body"></span></div>
      <h2 id="ovTitle" class="ov-title">Oração concluída</h2>
      <p id="ovSub" class="ov-sub">Você faz parte de uma corrente de oração.</p>
      <div id="ovNumber" class="ov-number">—</div>
      <div class="ov-number-label" data-i18n="times_prayed">vezes que esta oração já foi rezada</div>
      <!-- aviso da 2ª conclusão no mesmo dia (chave already_counted) -->
      <p id="ovNote" class="ov-sub" style="margin:.7rem 0 0" hidden></p>
      <div class="ov-actions">
        <button id="ovNext" class="btn btn-primary" type="button" data-i18n="next_day" hidden>Próximo dia</button>
        <!-- imagem "Rezei hoje" para Stories/Status (chave share_prayed) -->
        <button id="ovShare" class="btn" type="button" hidden>Compartilhar que rezei</button>
        <button id="ovAgain" class="btn" type="button" data-i18n="pray_again">Rezar de novo</button>
        <a id="ovBack" class="btn" data-i18n="back_catalog">Voltar ao catálogo</a>
      </div>
    </div>
  </div>

  <!-- dados da página para o módulo (E3) -->
  <script type="application/json" id="oracao-dados" is:inline set:html={dadosJson}></script>
  <script>
    import '../../scripts/oracao/leitor';
  </script>
</Base>

<style is:global>
  /* ════════ Leitor da oração (Fases 3 e 4) — complementa o CSS do Base.astro ════════ */

  /* E8: destaque pela API nativa de realce — só fundo e cor (sem negrito: o texto não "treme").
     Cores literais: ::highlight() não lê var() em todos os navegadores. Contraste ≥ 9:1. */
  ::highlight(od-linha) { background-color: rgba(231, 178, 76, .14); }
  ::highlight(od-palavra) { background-color: rgba(231, 178, 76, .5); color: #2b2117; }
  :root[data-theme="dark"] ::highlight(od-linha) { background-color: rgba(255, 215, 132, .1); }
  :root[data-theme="dark"] ::highlight(od-palavra) { background-color: rgba(255, 215, 132, .85); color: #1a130a; }
  /* reserva sem a API (só no bloco que está sendo lido) */
  .rg-w { border-radius: 4px; }
  .rg-w-linha { background-color: rgba(231, 178, 76, .14); }
  .rg-w-ativa { background-color: rgba(231, 178, 76, .5); color: #2b2117; }
  :root[data-theme="dark"] .rg-w-linha { background-color: rgba(255, 215, 132, .1); }
  :root[data-theme="dark"] .rg-w-ativa { background-color: rgba(255, 215, 132, .85); color: #1a130a; }
  /* G6: tocar num parágrafo/verso começa a leitura dali */
  #prayer-content :is(p, blockquote):not(.rubric):not(.rotulo):not(.terco-mystery) { cursor: pointer; -webkit-tap-highlight-color: transparent; }
  #prayer-content :is(.od-misterios, .terco-days) :is(p, li) { cursor: auto; }

  /* B15: A+ e A− valem para tudo no texto (antes rubricas, mistérios e títulos ficavam fixos) */
  #prayer-content h2 { font-size: calc(1.9rem * var(--reader-scale, 1)); }
  #prayer-content p.rubric { font-size: calc(1rem * var(--reader-scale, 1)); }
  #prayer-content p.rubric.nota { font-size: calc(.98rem * var(--reader-scale, 1)); }
  #prayer-content .terco-mystery { font-size: calc(1.28rem * var(--reader-scale, 1)); }
  #prayer-content .lead::first-letter { font-size: calc(3.6rem * var(--reader-scale, 1)); }
  #prayer-content .rep-count { font-size: calc(1.1rem * var(--reader-scale, 1)); }
  #prayer-content .rep-hint { font-size: calc(.72rem * var(--reader-scale, 1)); }
  #prayer-content .rep-dot { width: calc(13px * var(--reader-scale, 1)); height: calc(13px * var(--reader-scale, 1)); }
  .rtool[aria-disabled="true"] { opacity: .45; cursor: default; }

  /* G8: seção repetida (ex.: "## 5x Dezenas") — a barra de continhas fica logo abaixo do título */
  #prayer-content section.od-secao { margin: 0 0 1.2rem; padding: 0 0 0 .9rem; border-left: 2px dotted color-mix(in srgb, var(--gold) 55%, transparent); }
  #prayer-content section.od-secao > .rep-secao { margin: -.4rem 0 1rem; }
  #prayer-content section.od-secao.rep-done { border-left-style: solid; }

  /* G7: mistérios do dia (Terço, Rosário completo e as quatro páginas) */
  #prayer-content .od-misterios { margin: .4rem 0 1.8rem; padding: .9rem 1.1rem; border: 1px solid var(--hair); border-radius: 12px; background: color-mix(in srgb, var(--gold) 5%, transparent); font-size: calc(1rem * var(--reader-scale, 1)); }
  #prayer-content .od-misterios.od-hoje { border-color: color-mix(in srgb, var(--gold) 60%, var(--hair)); }
  #prayer-content .od-mist-titulo { margin: 0 0 .35rem; font-size: .78em; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); }
  #prayer-content .od-mist-titulo .od-mist-dias { text-transform: none; letter-spacing: .02em; color: var(--ink-soft); }
  #prayer-content .od-mist-hoje { margin: 0 0 .5rem; color: var(--ink); font-style: italic; min-height: 1.5em; }
  #prayer-content .od-mist-hoje a { color: var(--gold); }
  #prayer-content .od-mist-sumario { margin: 0; padding-left: 1.4rem; display: grid; gap: .25rem; }
  #prayer-content .od-mist-sumario a { color: inherit; text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--gold) 35%, transparent); }
  #prayer-content .od-mist-sumario a:hover { color: var(--gold); }
  #prayer-content .od-mist-sumario .od-mist-dias { color: var(--ink-soft); font-size: .85em; }
  #prayer-content .od-mist-sumario li.od-hoje { color: var(--gold); font-weight: 500; }
  #prayer-content :is(li, h2).od-hoje::after { content: attr(data-hoje-rotulo); display: inline-block; margin-left: .5rem; padding: .05rem .5rem; border-radius: 999px; border: 1px solid var(--gold); font-family: 'EB Garamond', serif; font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); vertical-align: middle; font-weight: 400; }
  #prayer-content .terco-days .od-mist-hoje { margin: .8rem 0 .3rem; }
  #prayer-content .terco-days .od-mist-sumario { font-size: .95em; }
  #prayer-content .day-chip.od-hoje:not(.day-on) { border-color: var(--gold); }
  /* Rosário: "Com os Luminosos (2002)" ou "Tradicional (15 mistérios)" — a escolha fica no aparelho */
  #prayer-content .od-distrib { display: flex; flex-wrap: wrap; gap: .3rem; width: fit-content; max-width: 100%; margin: .1rem 0 .9rem; padding: .22rem; border: 1px solid var(--hair); border-radius: 14px; background: color-mix(in srgb, var(--paper) 70%, transparent); }
  #prayer-content .od-distrib-op { flex: 1 1 auto; min-height: 40px; padding: .2rem .75rem; border-radius: 10px; border: 1px solid transparent; background: transparent; color: var(--ink-soft); font-family: 'EB Garamond', serif; font-size: .9rem; line-height: 1.2; cursor: pointer; transition: all .18s; }
  #prayer-content .od-distrib-op:hover { color: var(--gold); }
  html:not(.od-trad) #prayer-content .od-distrib-op[data-distrib="jp2"], html.od-trad #prayer-content .od-distrib-op[data-distrib="trad"] {
    color: var(--ink); border-color: color-mix(in srgb, var(--gold) 55%, var(--hair)); background: color-mix(in srgb, var(--gold) 14%, transparent); }
  /* dias de cada conjunto nas duas distribuições: aparece o da escolha (sem "piscar" ao abrir) */
  html.od-trad #prayer-content .od-dias-jp2, html:not(.od-trad) #prayer-content .od-dias-trad { display: none; }
  #prayer-content .od-distrib-op:focus-visible { outline: 2px solid var(--gold-bright); outline-offset: 2px; }
  /* Rosário tradicional: a coroa dos Luminosos some antes de pintar (o módulo põe hidden para o assistente) */
  html.od-trad #prayer-content [data-luminosos] { display: none !important; }

  /* G11: Modo Foco — além de topo e rodapé (Base.astro), esconde ferramentas, biografia e produtos.
     A classe no <html> vem do script curto do <head> (sem "piscar"); só o botão Foco fica para sair. */
  html.od-foco .topbar, html.od-foco .footsite,
  html.od-foco .reader-tools > :not(#focusBtn):not(#imersaoBtn), html.od-foco .bio-link, html.od-foco .prod-related { display: none !important; }
  html.od-foco .reader-hero { min-height: 26vh; }
  html.od-foco .reader-tools { justify-content: flex-end; margin-bottom: .8rem; }
  /* barra do assistente com cinco botões (Foco e Imersão) nos celulares estreitos (360 px): botões de 40 px;
     abaixo de 340 px, o ritmo desce para uma segunda linha */
  @media (max-width: 380px) {
    .reader-body .rg-bar { gap: .25rem; padding-left: .45rem; padding-right: .45rem; }
    .rg-bar .rg-controls { gap: .22rem; }
    .rg-bar .rg-btn { min-width: 40px; }
    .rg-bar .rg-speed select { padding: .2rem .15rem; font-size: .78rem; }
  }
  @media (max-width: 340px) { .reader-body .rg-bar { flex-wrap: wrap; } .rg-bar .rg-speed { margin-left: 0; } }
  /* barra do assistente com cinco botões (Foco e Imersão): numa linha só a partir de 768 px */
  @media (min-width: 768px) {
    .reader-body .rg-bar { margin-left: -2rem; margin-right: -2rem; flex-wrap: nowrap; }
    .rg-bar .rg-btn { padding: 0 .55rem; }
    .rg-bar :is(.rg-controls, .rg-speed) { flex-shrink: 0; }
    /* rótulos mais longos ("Continuar", outros idiomas): o título encolhe com "…" em vez de quebrar a barra */
    .rg-bar .rg-title { letter-spacing: .14em; flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  }
  /* botão Foco na barra do assistente: aceso enquanto o foco está ligado */
  #rgFoco[aria-pressed="true"] { border-color: var(--gold); color: var(--gold); background: color-mix(in srgb, var(--gold) 12%, transparent); }

  /* B17: a barra do assistente respeita a área segura do iPhone e se recolhe enquanto as
     contas/legenda da novena estão na faixa de baixo da tela (parada; tocando, ela fica) */
  :root { --od-seguro: env(safe-area-inset-bottom, 0px); }
  .rg-bar { padding-bottom: calc(.7rem + var(--od-seguro)); transition: transform .25s ease, opacity .25s ease; }
  .rg-bar.rg-recolhida { transform: translateY(calc(100% + 16px)); opacity: 0; pointer-events: none; }
  @media (max-width: 560px) { .rg-bar { padding-bottom: calc(.55rem + var(--od-seguro)); } }
  /* contas da novena abaixo do topo fixo ao rolar até elas; no modo foco o topo some e basta uma folga */
  .beads, .day-caption { scroll-margin-top: 84px; }
  html.od-foco .beads, html.od-foco .day-caption { scroll-margin-top: 1rem; }

  /* ════ Modo Imersão — "oratório digital" (src/scripts/oracao/imersao.ts) ════
     A imagem da oração ocupa a tela sob um degradê; velas tremulam ao pé da tela (e, nas
     telas bem largas, velas de altar dos dois lados); o texto passa pelo meio, e a linha
     lida fica no centro. Camadas: fundo (z −1, atrás do texto) · texto · degradês e velas
     (z 25, por cima do texto que sai pelo alto e por baixo) · topo (35) · barra (36) ·
     aviso de conclusão (100). Só na tela: na impressão, nada disto aparece. */
  .imersao, .imersao-frente, .imersao-topo { display: none; }
  #rgImersao[aria-pressed="true"], #imersaoBtn[aria-pressed="true"] { border-color: var(--gold); color: var(--gold); background: color-mix(in srgb, var(--gold) 12%, transparent); }
  @media screen {
    html:root.od-imersao {
      --paper: #120d07; --paper-raised: #1d150c; --ink: #f4ead6; --ink-soft: #d2c09c; --hair: rgba(233, 194, 122, .24);
      --gold: #e6b75e; --gold-bright: #f5ca74; --flame: #ffd784; --glow: rgba(240, 194, 100, .5);
      --shadow: rgba(0, 0, 0, .5); --scrim: rgba(5, 3, 1, .72);
      color-scheme: dark; background: #0b0805; scrollbar-width: none;
    }
    html.od-imersao::-webkit-scrollbar { display: none; }
    html.od-imersao body { background: transparent; }
    html.od-imersao :is(.topbar, .footsite, .texture, .reader-hero, .reader-tools, .bio-link, .prod-related, #rgFoco) { display: none !important; }
    /* o texto começa e termina no meio da tela (a 1ª e a última linha também passam pelo centro) */
    html.od-imersao .reader-body { max-width: 40rem; padding: 46vh clamp(1.1rem, 5vw, 1.6rem) 62vh; }
    html.od-imersao #prayer-content { font-size: calc(1.3rem * var(--reader-scale, 1)); line-height: 1.8; text-shadow: 0 1px 2px rgba(0, 0, 0, .9), 0 0 22px rgba(0, 0, 0, .7); }
    html.od-imersao #prayer-content blockquote { background: rgba(12, 8, 4, .34); }
    html.od-imersao #prayer-content :is(h2, h3) { text-shadow: 0 0 24px rgba(240, 194, 100, .25), 0 1px 2px rgba(0, 0, 0, .9); }
    :root.od-imersao ::highlight(od-linha) { background-color: rgba(255, 215, 132, .15); }
    :root.od-imersao ::highlight(od-palavra) { background-color: rgba(255, 215, 132, .9); color: #1a130a; text-shadow: none; }
    :root.od-imersao .rg-w-linha { background-color: rgba(255, 215, 132, .15); }
    :root.od-imersao .rg-w-ativa { background-color: rgba(255, 215, 132, .9); color: #1a130a; text-shadow: none; }
    /* barra do assistente: fixa embaixo, escura e translúcida; na imersão nunca se recolhe */
    html.od-imersao .rg-bar { position: fixed; left: 0; right: 0; bottom: calc(10px + var(--od-seguro)); margin: 0 auto; width: min(44rem, calc(100% - 20px)); z-index: 36;
      padding-bottom: .7rem; background: rgba(20, 14, 8, .86); border-color: rgba(233, 194, 122, .22); box-shadow: 0 10px 34px rgba(0, 0, 0, .55);
      -webkit-backdrop-filter: none; backdrop-filter: none; /* sem desfoque: o fundo se move e o desfoque pesaria no celular */
      transition: none; }
    html.od-imersao .rg-bar.rg-recolhida { transform: none; opacity: 1; pointer-events: auto; }
    /* "Próximo dia" rola até as contas: que fiquem abaixo do degradê do alto */
    html.od-imersao :is(.beads, .day-caption) { scroll-margin-top: calc(var(--im-topo, 64px) + 110px); }
    html.od-imersao .rg-speed select { background: #1d150c; }

    /* fundo: imagem com um zoom bem lento, degradê, luz quente das velas e faíscas subindo */
    html.od-imersao .imersao { display: block; position: fixed; inset: 0; z-index: -1; overflow: hidden; background: #0b0805; pointer-events: none; }
    .imersao-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 22%; max-width: none;
      transform-origin: 50% 35%; animation: im-respira-fundo 50s ease-in-out infinite alternate; }
    @keyframes im-respira-fundo { from { transform: scale(1.02); } to { transform: scale(1.1) translateY(-1.5%); } }
    .imersao-veu { position: absolute; inset: 0;
      background: radial-gradient(ellipse 80% 70% at 50% 44%, rgba(10, 7, 4, .5) 0%, rgba(10, 7, 4, .62) 55%, rgba(10, 7, 4, .82) 100%),
        linear-gradient(180deg, rgba(10, 7, 4, .45) 0%, rgba(10, 7, 4, 0) 26%, rgba(10, 7, 4, 0) 60%, rgba(10, 7, 4, .55) 100%); }
    .imersao-luz { position: absolute; left: -10%; right: -10%; bottom: 0; height: 50%; mix-blend-mode: screen; pointer-events: none;
      background: radial-gradient(ellipse 58% 60% at 50% 100%, rgba(255, 160, 60, .3) 0%, rgba(255, 140, 40, .11) 45%, rgba(255, 140, 40, 0) 72%);
      animation: im-luz 4.8s ease-in-out infinite; }
    @keyframes im-luz { 0%, 100% { opacity: .82; } 28% { opacity: 1; } 52% { opacity: .74; } 76% { opacity: .95; } }
    .imersao-brasas { position: absolute; inset: 0; }
    .im-brasa { position: absolute; left: var(--x); bottom: var(--im-baixo, 170px); width: var(--s); height: var(--s); border-radius: 50%;
      background: #ffd27a; box-shadow: 0 0 6px 2px rgba(255, 176, 70, .7); opacity: 0; animation: im-sobe var(--t) linear var(--a) infinite; }
    @keyframes im-sobe { 0% { transform: translate(0, 0) scale(1); opacity: 0; } 12% { opacity: .85; } 60% { opacity: .5; } 100% { transform: translate(var(--dx), -56vh) scale(.35); opacity: 0; } }

    /* frente: degradês que apagam o texto no alto e embaixo; velas por cima */
    html.od-imersao .imersao-frente { display: block; position: fixed; inset: 0; z-index: 25; pointer-events: none; overflow: hidden; }
    /* os degradês "seguram" o toque: o texto e os links apagados embaixo deles não reagem
       (a rolagem com o dedo e com a roda passa para a página normalmente) */
    .imersao-nevoa { position: absolute; left: 0; right: 0; pointer-events: auto; }
    .imersao-nevoa-cima { top: 0; height: calc(var(--im-topo, 64px) + 100px);
      background: linear-gradient(180deg, rgba(10, 7, 4, .97) 0%, rgba(10, 7, 4, .95) calc(var(--im-topo, 64px) + 4px), rgba(10, 7, 4, 0) 100%); }
    .imersao-nevoa-baixo { bottom: 0; height: calc(var(--im-baixo, 170px) + 150px);
      background: linear-gradient(0deg, rgba(10, 7, 4, .96) 0%, rgba(10, 7, 4, .94) calc(var(--im-baixo, 170px) + 8px), rgba(10, 7, 4, 0) 100%); }
    .imersao-velas { position: absolute; left: 0; right: 0; bottom: var(--im-base, 84px); height: 96px; }
    /* a prateleira onde ficam as velas */
    .imersao-velas:not(.imersao-lados)::after { content: ''; position: absolute; left: 0; right: 0; bottom: -7px; height: 7px; border-radius: 2px;
      background: linear-gradient(180deg, #7a5524, #2c1c0b); box-shadow: 0 -1px 0 rgba(255, 204, 128, .32), 0 -12px 26px rgba(255, 170, 70, .16); }
    .imersao-lados { inset: 0; height: auto; bottom: 0; }
    .im-vela { position: absolute; bottom: 0; left: var(--x); width: var(--w); height: var(--h); transform: translateX(-50%);
      --fw: max(8px, calc(var(--w) * .62)); --fh: max(15px, calc(var(--w) * 1.36)); }
    .im-luz { position: absolute; left: 50%; bottom: 100%; width: 0; height: 0; }
    html.od-imersao .im-luz { animation: im-acende .9s ease-out calc(var(--i) * 90ms + 250ms) backwards; }
    @keyframes im-acende { 0% { opacity: 0; transform: scale(.25); } 60% { opacity: 1; transform: scale(1.18); } 100% { opacity: 1; transform: scale(1); } }
    .im-chama { position: absolute; left: calc(var(--fw) / -2); bottom: 4px; width: var(--fw); height: var(--fh);
      border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%; transform-origin: 50% 92%;
      background: radial-gradient(ellipse 55% 60% at 50% 74%, #fffef6 0%, #fff0bd 24%, #ffd06a 46%, #ff9a2c 72%, rgba(230, 100, 20, 0) 100%);
      box-shadow: 0 0 7px 1px rgba(255, 190, 90, .55), 0 0 2px rgba(255, 240, 200, .8);
      animation: im-tremula var(--d) ease-in-out var(--a) infinite; }
    @keyframes im-tremula {
      0%, 100% { transform: rotate(-2deg) scale(1, 1); }
      18% { transform: rotate(1.6deg) scale(.95, 1.08); }
      37% { transform: rotate(-1deg) scale(1.04, .95); }
      58% { transform: rotate(2.4deg) scale(.93, 1.1); }
      79% { transform: rotate(-1.4deg) scale(1.02, .98); }
    }
    .im-halo { position: absolute; left: calc(var(--fw) * -3.2); bottom: calc(4px + var(--fh) / 2 - var(--fw) * 3.2);
      width: calc(var(--fw) * 6.4); height: calc(var(--fw) * 6.4); border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 204, 116, .44) 0%, rgba(255, 170, 70, .16) 38%, rgba(255, 150, 50, 0) 70%);
      animation: im-halo calc(var(--d) * 1.6) ease-in-out var(--a) infinite; }
    @keyframes im-halo { 0%, 100% { opacity: .82; transform: scale(1); } 50% { opacity: 1; transform: scale(1.1); } }
    /* vela de cera: luz da chama no alto e o pavio */
    .im-corpo { position: absolute; inset: 0; border-radius: 3px 3px 2px 2px;
      background: linear-gradient(180deg, rgba(255, 206, 128, .5) 0%, rgba(255, 206, 128, 0) 38%),
        linear-gradient(90deg, #9c8259 0%, #e4d3ad 22%, #fbf3df 46%, #eee0c1 62%, #c4aa7c 84%, #876c48 100%);
      box-shadow: 0 0 16px rgba(255, 180, 80, .16); }
    .im-corpo::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 8px; border-radius: 0 0 50% 50% / 0 0 100% 100%;
      background: radial-gradient(ellipse at 50% 0%, rgba(255, 228, 164, .95), rgba(255, 210, 140, .3) 70%, transparent); }
    .im-corpo::after { content: ''; position: absolute; left: 50%; top: -6px; width: 2px; height: 7px; margin-left: -1px; border-radius: 1px; background: linear-gradient(#1e140a, #4b3218); }
    /* lamparina num copo de vidro (rubi, âmbar, ouro) */
    .im-copo { width: 26px; height: 30px; --fw: 10px; --fh: 18px; }
    .im-copo .im-luz { bottom: calc(100% - 7px); }
    .im-copo .im-corpo { border-radius: 4px 4px 9px 9px;
      background: linear-gradient(180deg, rgba(var(--c), .5) 0%, rgba(var(--c), .88) 66%, rgba(var(--c2), .96) 100%);
      box-shadow: inset 0 3px 10px rgba(255, 206, 128, .55), 0 0 20px rgba(var(--c), .5); }
    .im-copo .im-corpo::before { left: 20%; right: auto; width: 3px; top: 5px; height: 62%; border-radius: 2px; background: rgba(255, 255, 255, .22); }
    .im-copo .im-corpo::after { left: 18%; right: 18%; top: 1px; width: auto; height: 60%; margin: 0; border-radius: 50%;
      background: radial-gradient(ellipse at 50% 18%, rgba(255, 222, 150, .75), rgba(255, 200, 120, 0) 72%);
      animation: im-halo calc(var(--d) * 1.3) ease-in-out var(--a) infinite; }
    .im-copo-rubi { --c: 168, 26, 32; --c2: 104, 12, 18; }
    .im-copo-ambar { --c: 212, 118, 28; --c2: 136, 66, 10; }
    .im-copo-ouro { --c: 222, 172, 70; --c2: 146, 106, 36; }
    /* velas de altar (laterais): castiçal de latão */
    .im-lado { display: none; }
    .im-lado::after { content: ''; position: absolute; left: 50%; bottom: -3px; width: calc(var(--w) * 2.3); height: 12px; transform: translateX(-50%);
      border-radius: 50% 50% 5px 5px / 70% 70% 5px 5px; background: linear-gradient(180deg, #e0b866, #8a6528 70%, #5a3f16); box-shadow: 0 0 18px rgba(255, 180, 80, .2); }

    /* topo: nome da oração e o "×" */
    html.od-imersao .imersao-topo { display: flex; position: fixed; top: 0; left: 0; right: 0; z-index: 35; align-items: center; justify-content: center;
      min-height: 60px; padding: calc(.45rem + env(safe-area-inset-top, 0px)) 3.8rem .45rem; pointer-events: none; }
    .imersao-nome { margin: 0; max-width: 100%; font-family: 'Cormorant', Georgia, serif; font-weight: 600; font-size: 1.04rem; line-height: 1.25;
      letter-spacing: .14em; text-transform: uppercase; text-align: center; color: var(--gold); text-shadow: 0 0 18px rgba(240, 194, 100, .35);
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .imersao-sair { pointer-events: auto; position: absolute; top: calc(.45rem + env(safe-area-inset-top, 0px)); right: calc(.55rem + env(safe-area-inset-right, 0px)); width: 44px; height: 44px;
