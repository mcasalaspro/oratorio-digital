    display: flex; align-items: center; gap: 1rem;
    margin: 0 auto 1rem; padding: 1.15rem 1.5rem; max-width: 40rem;
    border-radius: 16px; text-decoration: none;
    background: color-mix(in srgb, var(--season, var(--gold)) 20%, var(--paper-raised));
    border: 1px solid color-mix(in srgb, var(--season, var(--gold)) 60%, var(--hair));
    box-shadow: 0 14px 36px var(--shadow);
    transition: transform .2s, border-color .2s, background .2s;
  }
  .liturgia-cta:hover { transform: translateY(-2px); border-color: var(--gold); background: color-mix(in srgb, var(--season, var(--gold)) 28%, var(--paper-raised)); }
  .liturgia-cta-icon { font-size: 1.7rem; color: var(--gold); line-height: 1; flex: 0 0 auto; }
  .liturgia-cta-text { display: flex; flex-direction: column; gap: .15rem; flex: 1; }
  .liturgia-cta-k { font-family: 'Cormorant', serif; font-size: 1.55rem; font-weight: 600; color: var(--ink); line-height: 1.1; }
  .liturgia-cta-sub { font-family: 'EB Garamond', serif; font-size: .98rem; color: var(--ink-soft); }
  .liturgia-cta-arrow { color: var(--gold); font-size: 1.3rem; flex: 0 0 auto; transition: transform .2s; }
  .liturgia-cta:hover .liturgia-cta-arrow { transform: translateX(4px); }

  /* "12 orações hoje", logo abaixo da vela (o fundo da abertura é sempre escuro) */
  .votive-today { margin: .45rem 0 0; font-size: .88rem; letter-spacing: .02em; color: #b9a47c; }
  .votive-today :global(b) { color: var(--flame); font-weight: 600; font-family: 'Cormorant', serif; font-size: 1.1rem; }

  /* "Santos do dia" com vários nomes: cada nome é um link discreto (criado pelo script) */
  .santo-dia-name :global(a) { color: inherit; text-decoration: none; }
  .santo-dia-name :global(a:hover) { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
  div.santo-dia .santo-dia-name { line-height: 1.2; }
</style>
