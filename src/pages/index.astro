---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PrayerCard from '../components/PrayerCard.astro';
import CommunityCounter from '../components/CommunityCounter.astro';
import { site, withBase } from '../config/site';
import { reserva } from '../config/contadores';

const all = await getCollection('prayers');
const liturgiaEntries = await getCollection('liturgia');
const liturgiaToday = {};
for (const e of liturgiaEntries) {
  const m = e.id.match(/(\d{4})(\d{2})(\d{2})/);   // AAAAMMDD do nome do arquivo
  if (m) liturgiaToday[m[1] + m[2] + m[3]] = e.id;
}

// Aviso de build: imagem de alguma oração faltando em public/saints/
// (o nome do arquivo .webp deve ser EXATAMENTE o nome da oração, minúsculo)
{
  const missing = all.map((p) => p.id).filter((id) => !fs.existsSync(`public/saints/${id}.webp`));
  if (missing.length) {
    console.warn('\n⚠️  Imagens faltando em public/saints/ (essas orações vão usar default.webp):');
    for (const id of missing) console.warn(`    • public/saints/${id}.webp   (oração "${id}")`);
    console.warn('   Confira nome EXATO (minúsculo, sem acento), extensão .webp e a pasta public/saints/.\n');
  }
}

// catálogo: destaques primeiro, depois por título
const catalog = [...all].sort((a, b) => {
  const fa = a.data.featured ? (a.data.featuredOrder ?? 50) : 999;
  const fb = b.data.featured ? (b.data.featuredOrder ?? 50) : 999;
  if (fa !== fb) return fa - fb;
  return a.data.title.localeCompare(b.data.title);
});

// orações fixas em destaque (a partir do painel)
const byId = new Map(all.map((p) => [p.id, p]));
const pinned = site.pinnedPrayers
  .sort((a, b) => a.order - b.order)
  .map((p) => byId.get(p.id))
  .filter(Boolean);

// candidatas à "Oração do dia" (têm data de festa). As devoções de mês ("mes-…",
// ex.: Mês de Maria) ficam de fora: a data delas marca o início do mês, não uma festa.
const liturgical = all.filter((p) => p.data.liturgicalFeast && !p.id.startsWith('mes-'));

// "Santo do dia": SOMENTE biografias com data de festa (campo feast "MM-DD").
// Santos do mesmo dia aparecem juntos ("São Pedro e São Paulo"), nesta ordem:
// a tradicional para os pares conhecidos, depois os destaques (featured/order) e o nome.
const bios = await getCollection('biografias');
const ORDEM_TRADICIONAL = ['sao-pedro-apostolo', 'sao-paulo-apostolo', 'sao-miguel-arcanjo', 'sao-gabriel-arcanjo', 'sao-rafael-arcanjo'];
const _trad = (id: string) => { const i = ORDEM_TRADICIONAL.indexOf(id); return i < 0 ? 999 : i; };
const santos = bios
  .filter((b) => /^\d{2}-\d{2}$/.test(b.data.feast ?? ''))
  .map((b) => ({
    id: b.id,
    feast: b.data.feast as string,
    name: b.data.name ?? b.id,
    url: withBase(`/biografia/${b.id}`),
    rank: b.data.featured ? (b.data.order ?? 50) : 999,
  }))
  .sort((a, b) => a.feast.localeCompare(b.feast) || _trad(a.id) - _trad(b.id) || a.rank - b.rank || a.name.localeCompare(b.name, 'pt-BR'));

// números de reserva do contador (src/data/contadores.json, se o build tiver trazido):
// aparecem quando o serviço não responde e não há número guardado no aparelho
const reservaTotal = reserva(site.counter.totalKey ?? 'total');
const reservaVisitas = reserva(site.counter.visitsKey ?? 'visits');

// filtros disponíveis
const types = [...new Set(all.map((p) => p.data.type))];
const langs = [...new Set(all.map((p) => p.data.language))];
---
<Base>
  <!-- ════════ HERO ════════ -->
  <section class="hero">
    <img class="hero-bg" src={withBase('/textures/rays.webp')} alt="" aria-hidden="true" data-parallax="0.12" onerror="this.style.display='none'" />
    <span class="hero-shade" aria-hidden="true"></span>
    <div class="hero-inner">
      <!-- logo leve: o CSS exibe entre 108 e 164 px, então basta a versão de 128 px ou a de 340 px (telas nítidas) -->
      <img class="hero-logo" src={withBase('/logo-340.webp')}
           srcset={`${withBase('/logo-128.webp')} 128w, ${withBase('/logo-340.webp')} 340w`}
           sizes="(max-width: 635px) 108px, (max-width: 965px) 17vw, 164px"
           alt={site.name} width="164" height="164" />
      <a class="season-badge" id="seasonBadge" href={withBase('/textos/tempos-liturgicos')} hidden>
        <span class="season-dot" aria-hidden="true"></span>
        <span id="seasonBadgeText"></span>
      </a>
      <a class="season-next" id="seasonNext" href={withBase('/textos/tempos-liturgicos')} hidden></a>
      <h1>{site.name}</h1>
      <p class="lead-line">{site.tagline}</p>
      <p class="hero-stats" id="heroStats" data-reserva-total={reservaTotal ?? undefined} data-reserva-visitas={reservaVisitas ?? undefined}><strong>{all.length}</strong> <span data-i18n="stat_prayers">orações</span><span class="sep">·</span><strong>{bios.length}</strong> <span data-i18n="stat_bios">biografias</span><span id="visitStat"><span class="sep">·</span><strong id="visitNumber">—</strong> <span data-i18n="visits_label">visitas</span></span></p>
      {site.showCommunityCounter && (
        <Fragment>
          <CommunityCounter />
          {/* orações de hoje (só o Supabase sabe): "12 orações hoje"; some sem número */}
          <p class="votive-today" id="communityToday" hidden></p>
        </Fragment>
      )}
    </div>
  </section>

  <!-- ════════ LITURGIA DO DIA (botão de abertura) ════════ -->
  <!-- só aparece quando houver ao menos uma Liturgia em src/content/liturgia/ (volta sozinho) -->
  {liturgiaEntries.length > 0 && (
    <div class="wrap">
      <a class="liturgia-cta" id="liturgiaCta" href={withBase('/liturgia')} data-map={JSON.stringify(liturgiaToday)} data-base={import.meta.env.BASE_URL}>
        <span class="liturgia-cta-icon" aria-hidden="true">&#10013;</span>
        <span class="liturgia-cta-text">
          <span class="liturgia-cta-k" data-i18n="liturgia_read">Ler a Liturgia do dia</span>
          <span class="liturgia-cta-sub">As leituras da Missa de hoje</span>
        </span>
        <span class="liturgia-cta-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  )}
  <!-- ════════ SANTO DO DIA (faixa, revelada conforme a data) ════════ -->
  {santos.length > 0 && (
    <div class="wrap">
      <a class="santo-dia" id="santoDia" hidden href="#">
        <span class="santo-dia-seal">✦ <span id="santoDiaLabel" data-i18n="santo_today">Santo do dia</span></span>
        <span class="santo-dia-name" id="santoDiaName"></span>
        <span class="santo-dia-date" id="santoDiaDate"></span>
        <span class="santo-dia-arrow" aria-hidden="true">&rarr;</span>
      </a>
      <div id="santoData" hidden>
        {santos.map((sv) => <i data-feast={sv.feast} data-name={sv.name} data-url={sv.url}></i>)}
      </div>
    </div>
  )}

  <!-- ════════ ORAÇÃO DO DIA (destaque revelado conforme a data) ════════ -->
  <section class="section today-section" id="today">
    <div class="wrap">
      <a class="today-card" id="todayCard" href="#">
        <img class="today-bg" id="todayImg" alt="" aria-hidden="true" />
        <span class="today-shade"></span>
        <span class="today-inner">
          <span class="today-seal" data-i18n="today_seal">Oração do dia</span>
          <h2 class="today-title" id="todayTitle"></h2>
          <span class="today-meta" id="todayMeta"></span>
          <span class="today-reason" id="todayReason"></span>
          <span class="today-cta" data-i18n="today_cta">Rezar agora</span>
        </span>
      </a>
    </div>
  </section>

  <!-- dados das orações com festa: alimentam a "Oração do dia" (sem seção visível).
       A imagem fica só como endereço (data-img): o script baixa apenas a da oração escolhida.
       (Uma imagem aqui seria baixada mesmo escondida: eram ~125 imagens grandes, ~52 MB.) -->
  <div id="litData" hidden data-fallback={withBase('/saints/default.webp')}>
    {liturgical.map((p) => (
      <a class="lit-card"
         href={withBase(`/oracao/${p.id}`)}
         data-feast={p.data.liturgicalFeast}
         data-start={p.data.novenaSuggestedStart ?? 0}
         data-total={p.data.totalDays ?? 1}
         data-type={p.data.type}
         data-img={withBase(p.data.image ?? `/saints/${p.id}.webp`)}>
        <h3>{p.data.title}</h3>
        <span class="lit-meta">{p.data.saint}</span>
      </a>
    ))}
  </div>

  <!-- ════════ ORAÇÕES FIXAS ════════ -->
  {pinned.length > 0 && (
    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-i18n="pinned_title">Orações do dia a dia</p>
        <h2 class="section-title" data-i18n="pinned_title">Orações do dia a dia</h2>
        <div class="grid grid--pinned">
          {pinned.map((p) => <PrayerCard prayer={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ════════ MINHAS ORAÇÕES (favoritos, revelado se houver) ════════ -->
  <section class="section" id="favSection" hidden>
    <div class="wrap">
      <p class="eyebrow" data-i18n="favorites_title">Minhas orações</p>
      <h2 class="section-title" data-i18n="favorites_title">Minhas orações</h2>
      <div class="grid grid--pinned" id="favGrid"></div>
    </div>
  </section>

  <!-- ════════ CATÁLOGO ════════ -->
  <section class="section" id="catalogo">
    <div class="wrap">
      <p class="eyebrow" data-i18n="catalog_title">Catálogo</p>
      <h2 class="section-title" data-i18n="catalog_title">Catálogo</h2>

      <div class="toolbar">
        <input id="search" class="search" type="search" placeholder="Buscar oração, novena ou santo…" data-i18n-ph="search_placeholder" />
      </div>
      <div class="filters">
        <div class="filter-row">
          <span class="filter-label" data-i18n="lbl_type">Tipo</span>
          <div class="chips" id="typeChips" role="group" aria-label="Tipo de oração">
            <button class="chip" data-type="" aria-pressed="true" data-i18n="filter_all">Todas</button>
            {types.map((t) => <button class="chip" data-type={t} aria-pressed="false" data-i18n={`type_${t}`}>{t}</button>)}
          </div>
        </div>
        <div class="filter-row">
          <span class="filter-label" data-i18n="lbl_date">Data</span>
          <div class="chips" id="dateChips" role="group" aria-label="Data">
            <button class="chip" data-date="" aria-pressed="true" data-i18n="filter_all">Todas</button>
            <button class="chip" data-date="today" aria-pressed="false" data-i18n="filter_today">Hoje</button>
            <button class="chip" data-date="week" aria-pressed="false" data-i18n="filter_week">Essa semana</button>
            <button class="chip" data-date="month" aria-pressed="false" data-i18n="filter_month">Este mês</button>
          </div>
        </div>
        {langs.length > 1 && (
          <div class="filter-row">
            <span class="filter-label" data-i18n="lbl_lang">Idioma</span>
            <div class="chips" id="langChips" role="group" aria-label="Idioma">
              <button class="chip" data-lang="" aria-pressed="true" data-i18n="filter_all">Todas</button>
              {langs.map((l) => <button class="chip" data-lang={l} aria-pressed="false">{l.slice(0,2).toUpperCase()}</button>)}
            </div>
          </div>
        )}
      </div>

      <div class="grid" id="catalogGrid">
        {catalog.map((p) => <PrayerCard prayer={p} />)}
      </div>
      <button class="btn show-more" id="showMore" type="button" hidden data-i18n="show_more">Mostrar mais</button>
      <p class="empty" id="emptyMsg" hidden data-i18n="no_results">Nenhuma oração encontrada com esses filtros.</p>
    </div>
  </section>


  <script>
    // último número bom guardado neste aparelho (0 = nenhum)
    function cachedCount(key: string): number {
      try { const n = Number(localStorage.getItem(key)); return Number.isFinite(n) && n > 0 ? n : 0; } catch (e) { return 0; }
    }
    function fmtCount(n: number) {
      const l = document.documentElement.getAttribute('data-lang') || 'pt-BR';
      return new Intl.NumberFormat(l).format(n);
    }
    // texto da interface com reserva em português (para chaves ainda fora do site.ts)
    function tr(k: string, pt: string) { const f = (window as any).odt; const v = f ? f(k) : k; return v && v !== k ? v : pt; }

    // ── Contadores da comunidade: vela, visitas, "hoje" e os cartões do catálogo ──
    // Uma leitura só (window.odContador — public/js/contador.js): no Supabase vem tudo de
    // uma vez (total, visitas, 'hoje' e cada oração); no Abacus, só total e visitas, e os
    // cartões ficam com a reserva do build. A visita conta uma vez por sessão (od-visited).
    // Número mostrado: o vivo; sem ele, o maior entre o guardado neste aparelho e a reserva
    // do build; sem nenhum, o bloco some — nunca "0".
    (function () {
      const C = (window as any).odContador;
      const stats = document.getElementById('heroStats');
      const elTotal = document.getElementById('communityNumber');
      const boxTotal = document.getElementById('community');
      const elVis = document.getElementById('visitNumber');
      const boxVis = document.getElementById('visitStat');
      const elHoje = document.getElementById('communityToday');
      const hideTotal = () => { if (boxTotal) boxTotal.style.display = 'none'; if (elHoje) elHoje.hidden = true; };   // .votive tem display próprio: hidden não bastaria
      const hideVis = () => { if (boxVis) boxVis.hidden = true; };
      if (!C || !C.ativo) { hideTotal(); hideVis(); return; }

      const reservaDe = (attr: string) => { const n = Number(stats?.getAttribute(attr)); return Number.isFinite(n) && n > 0 ? n : 0; };
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // números na tela (0 = nenhum ainda)
      let total = Math.max(cachedCount('od-total-cache'), reservaDe('data-reserva-total'));
      let visitas = Math.max(cachedCount('od-visits-cache'), reservaDe('data-reserva-visitas'));
      let hoje = 0;
      if (elTotal && total) elTotal.textContent = fmtCount(total);
      if (elVis && visitas) elVis.textContent = fmtCount(visitas);

      function animate(el: HTMLElement, from: number, to: number) {
        if (reduce || from === to) { el.textContent = fmtCount(to); return; }
        const dur = 1100, t0 = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - t0) / dur);
          el.textContent = fmtCount(Math.round(from + (to - from) * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }
      function renderHoje() {
        if (!elHoje) return;
        if (!(hoje > 0) || !total) { elHoje.hidden = true; return; }
        elHoje.textContent = '';
        const b = document.createElement('b'); b.textContent = fmtCount(hoje);
        elHoje.append(b, ' ' + (hoje === 1 ? tr('community_today_one', 'oração hoje') : tr('community_today', 'orações hoje')));
        elHoje.hidden = false;
      }
      // marca "N vezes rezada" dos cartões (PrayerCard): mostra se > 0, some com 0
      function setReza(pill: HTMLElement, n: number) {
        pill.dataset.n = n > 0 ? String(n) : '';
        if (!(n > 0)) { pill.hidden = true; return; }
        const num = pill.querySelector<HTMLElement>('.pill-reza-n');
        const lab = pill.querySelector<HTMLElement>('.pill-reza-lab');
        let txt: string;
        if (n === 1) { txt = tr('count_short_one', 'vez rezada'); lab?.removeAttribute('data-i18n'); }
        else { txt = tr('count_short', 'vezes rezada'); lab?.setAttribute('data-i18n', 'count_short'); }
        if (num) num.textContent = fmtCount(n);
        if (lab) lab.textContent = txt;
        pill.title = `${fmtCount(n)} ${txt}`;
        pill.hidden = false;
      }
      const pills = () => Array.from(document.querySelectorAll<HTMLElement>('.card[data-slug] .pill-reza'));

      // a visita conta uma vez por sessão; no Abacus, a própria contagem já traz as visitas
      let contar = false;
      try { contar = sessionStorage.getItem('od-visited') !== '1'; } catch (e) {}
      const pLer: Promise<Record<string, number> | null> = (contar && C.servico === 'abacus') ? C.ler([C.chaves.total]) : C.ler();
      const pVisita: Promise<number | null> = contar ? C.contarVisita() : Promise.resolve(null);

      pLer.then((m) => {
        const vivo = (k: string) => { const v = m ? Number(m[k]) : NaN; return Number.isFinite(v) && v > 0 ? v : 0; };
        const t = vivo(C.chaves.total);
        if (t) {
          try { localStorage.setItem('od-total-cache', String(t)); } catch (e) {}
          if (elTotal) animate(elTotal, total, t);
          total = t;
        } else if (!total) hideTotal();
        if (C.servico === 'supabase') {
          hoje = vivo('hoje');
          renderHoje();
          // cartões: no Supabase a leitura traz todas as orações de uma vez; o número vivo
          // substitui a reserva (sem número vivo, fica a reserva — ou a marca segue oculta)
          if (m) for (const p of pills()) {
            const v = vivo(p.closest<HTMLElement>('.card')?.dataset.slug || '');
            if (v) setReza(p, v);
          }
        }
      });
      Promise.all([pLer, pVisita]).then(([m, nv]) => {
        if (contar && nv != null && nv > 0) { try { sessionStorage.setItem('od-visited', '1'); } catch (e) {} }
        const lido = m ? Number(m[C.chaves.visitas]) : NaN;
        const v = (nv != null && nv > 0) ? nv : (Number.isFinite(lido) && lido > 0 ? lido : 0);
        if (v) {
          try { localStorage.setItem('od-visits-cache', String(v)); } catch (e) {}
          if (elVis) elVis.textContent = fmtCount(v);
          visitas = v;
        } else if (!visitas) hideVis();
      });

      // troca de idioma: refaz os números (separador de milhar) e os rótulos novos
      document.addEventListener('od:lang', () => {
        if (elTotal && total) elTotal.textContent = fmtCount(total);
        if (elVis && visitas) elVis.textContent = fmtCount(visitas);
        renderHoje();
        for (const p of pills()) { const n = Number(p.dataset.n); if (n > 0) setReza(p, n); }
      });
    })();

    // ── Oração do dia (calculada na data atual do visitante) ──
    (function () {
      const cards = Array.from(document.querySelectorAll<HTMLElement>('#litData .lit-card'));
      const todaySec = document.getElementById('today');
      if (cards.length === 0 || !todaySec) return;
      const DAY = 86400000;
      const now = new Date(); now.setHours(0, 0, 0, 0);
      const active: { card: HTMLElement; daysToFeast: number; suggestedDay: number; total: number; feast: Date; start: Date; novena: boolean; title: string }[] = [];

      for (const card of cards) {
        const m = (card.dataset.feast || '').match(/^(\d{2})-(\d{2})$/);
        if (!m) continue;
        const mm = +m[1], dd = +m[2];
        let feast = new Date(now.getFullYear(), mm - 1, dd);
        if (feast.getTime() + DAY < now.getTime()) feast = new Date(now.getFullYear() + 1, mm - 1, dd);
        const offset = parseInt(card.dataset.start || '0', 10);
        const total = parseInt(card.dataset.total || '1', 10);
        const start = new Date(feast.getTime() + offset * DAY);
        if (now.getTime() >= start.getTime() && now.getTime() <= feast.getTime()) {
          const daysToFeast = Math.round((feast.getTime() - now.getTime()) / DAY);
          const suggestedDay = Math.min(total, Math.max(1, Math.floor((now.getTime() - start.getTime()) / DAY) + 1));
          const title = card.querySelector('h3')?.textContent || '';
          active.push({ card, daysToFeast, suggestedDay, total, feast, start, novena: card.dataset.type === 'novena', title });
        }
      }
      if (active.length === 0) return;
      // 1º a festa de HOJE (no empate, a novena vence os demais tipos);
      // depois, a novena em andamento vence devoções de vários dias que não são novena
      // (ex.: Antífonas Ó, de 17 a 23/12, não tiram a Novena de Natal do destaque);
      // depois, a festa mais próxima; por fim, a ordem alfabética do título
      const hoje = (x: { daysToFeast: number }) => (x.daysToFeast === 0 ? 0 : 1);
      active.sort((a, b) =>
        hoje(a) - hoje(b) ||
        Number(b.novena) - Number(a.novena) ||
        a.daysToFeast - b.daysToFeast ||
        a.title.localeCompare(b.title, 'pt-BR'));

      const today = active[0];
      const src = today.card as HTMLAnchorElement;
      // só agora baixa uma imagem: a da oração escolhida (com a padrão de reserva)
      const tImg = document.getElementById('todayImg') as HTMLImageElement | null;
      const imgUrl = src.dataset.img || '';
      if (tImg && imgUrl) {
        const fallback = (document.getElementById('litData') as HTMLElement | null)?.dataset.fallback || '';
        tImg.addEventListener('error', () => { if (fallback && tImg.getAttribute('src') !== fallback) tImg.src = fallback; });
        tImg.src = imgUrl;
      }
      const tTitle = src.querySelector('h3');
      const tEl = document.getElementById('todayTitle'); if (tEl) tEl.textContent = tTitle ? tTitle.textContent : '';
      const mEl = src.querySelector('.lit-meta');
      const tM = document.getElementById('todayMeta'); if (tM) tM.textContent = mEl ? (mEl.textContent || '') : '';
      const tCard = document.getElementById('todayCard') as HTMLAnchorElement | null;
      if (tCard) tCard.href = src.href.split('?')[0] + (today.total > 1 ? `?dia=${today.suggestedDay}` : '');

      const dm = (d: Date) => String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0');
      const fillToday = () => {
        const tt = (window as any).odt;
        const feastStr = dm(today.feast), startStr = dm(today.start);
        let reason: string;
        if (today.daysToFeast === 0) reason = `${tt('feast_today')} (${feastStr})`;
        else if (today.total > 1) reason = `${tt('day')} ${today.suggestedDay} ${tt('day_of')} ${today.total} · ${startStr}–${feastStr}`;
        else reason = feastStr;
        const rEl = document.getElementById('todayReason'); if (rEl) rEl.textContent = reason;
      };
      fillToday();
      document.addEventListener('od:lang', fillToday);
      todaySec.style.display = 'block';
    })();

    // ── Filtros do catálogo ──
    (function () {
      const grid = document.getElementById('catalogGrid');
      const search = document.getElementById('search') as HTMLInputElement | null;
      const empty = document.getElementById('emptyMsg');
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
      let fType = '', fLang = '', fDate = '';
      let fWords: string[] = [];   // palavras buscadas: TODAS precisam aparecer, em qualquer ordem
      // sinônimos de uso comum: muita gente chama a "Coroa" de "Terço" (Terço da Misericórdia)
      const SINONIMOS: Record<string, string[]> = { terco: ['terco', 'coroa'], coroa: ['coroa', 'terco'] };
      const norm = (x: string) => (x || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const hay = new WeakMap<HTMLElement, string>();   // texto de busca de cada cart\u00e3o, j\u00e1 sem acentos
      for (const c of cards) hay.set(c, norm(c.dataset.search || ''));
      const STEP = 50;
      let limit = STEP;
      const moreBtn = document.getElementById('showMore');

      // calcula uma vez se a festa de cada oração é hoje / nesta semana / neste mês
      const DAY = 86400000;
      const now = new Date(); now.setHours(0, 0, 0, 0);
      const curMonth = now.getMonth();
      const weekEnd = now.getTime() + 7 * DAY;
      const dflag = new WeakMap<HTMLElement, { today: boolean; week: boolean; month: boolean }>();
      for (const c of cards) {
        const m = (c.dataset.feast || '').match(/^(\d{2})-(\d{2})$/);
        if (!m) { dflag.set(c, { today: false, week: false, month: false }); continue; }
        const mm = +m[1], dd = +m[2];
        let feast = new Date(now.getFullYear(), mm - 1, dd);
        if (feast.getTime() + DAY < now.getTime()) feast = new Date(now.getFullYear() + 1, mm - 1, dd);
        const total = parseInt(c.dataset.total || '1', 10);
        const offset = parseInt(c.dataset.offset || '0', 10);
        // a janela (novenaSuggestedStart) vale também para devoções de vários dias que não são novena (Antífonas Ó)
        const start = new Date(feast.getTime() + offset * DAY);
        const daysToFeast = Math.round((feast.getTime() - now.getTime()) / DAY);
        const inWindow = now.getTime() >= start.getTime() && now.getTime() <= feast.getTime();
        const isToday = daysToFeast === 0 || inWindow;
        const isWeek = (daysToFeast >= 0 && daysToFeast <= 7) || (start.getTime() <= weekEnd && feast.getTime() >= now.getTime());
        const isMonth = feast.getMonth() === curMonth || (total > 1 && start.getMonth() === curMonth);
        dflag.set(c, { today: isToday, week: isWeek, month: isMonth });
      }

      function apply() {
        let matched = 0;
        for (const c of cards) {
          const okType = !fType || c.dataset.type === fType;
          const okLang = !fLang || c.dataset.lang === fLang;
          const okText = !fWords.length || fWords.every((w) => (SINONIMOS[w] || [w]).some((s) => (hay.get(c) || '').includes(s)));
          const f = dflag.get(c) || { today: false, week: false, month: false };
          const okDate = !fDate || (fDate === 'today' && f.today) || (fDate === 'week' && f.week) || (fDate === 'month' && f.month);
          const show = okType && okLang && okText && okDate;
          if (show) { matched++; c.style.display = matched <= limit ? '' : 'none'; }
          else { c.style.display = 'none'; }
        }
        if (empty) empty.hidden = matched !== 0;
        if (moreBtn) moreBtn.hidden = matched <= limit;
      }
      function wireChips(sel: string, attr: string, set: (v: string) => void) {
        const group = document.querySelector(sel);
        if (!group) return;
        group.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest('.chip') as HTMLElement | null;
          if (!btn) return;
          group.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
          btn.setAttribute('aria-pressed', 'true');
          set(btn.dataset[attr] || '');
          limit = STEP;
          apply();
        });
      }
      wireChips('#typeChips', 'type', (v) => (fType = v));
      wireChips('#dateChips', 'date', (v) => (fDate = v));
      wireChips('#langChips', 'lang', (v) => (fLang = v));
      // "terço misericórdia" acha a "Coroa da Divina Misericórdia" (acentos e maiúsculas não importam)
      search?.addEventListener('input', () => { fWords = norm(search.value).split(/[^a-z0-9]+/).filter(Boolean); limit = STEP; apply(); });
      moreBtn?.addEventListener('click', () => { limit += STEP; apply(); });
      apply();
    })();
    // ── Favoritos ("Minhas orações") ──
    (function () {
      if (!(window as any).odFav) return;
      const odFav = (window as any).odFav;
      const favGrid = document.getElementById('favGrid');
      const favSec = document.getElementById('favSection');
      const source: Record<string, HTMLElement> = {};
      document.querySelectorAll<HTMLElement>('#catalogGrid .card[data-slug]').forEach((c) => {
        if (!source[c.dataset.slug!]) source[c.dataset.slug!] = c;
      });
      function refreshHearts() {
        document.querySelectorAll<HTMLElement>('.card[data-slug] .fav-btn').forEach((btn) => {
          const card = btn.closest('.card') as HTMLElement | null;
          if (card) btn.setAttribute('aria-pressed', odFav.has(card.dataset.slug) ? 'true' : 'false');
        });
      }
      function build() {
        if (!favGrid || !favSec) return;
        favGrid.innerHTML = '';
        let n = 0;
        odFav.all().forEach((slug: string) => {
          const orig = source[slug];
          if (!orig) return;
          const clone = orig.cloneNode(true) as HTMLElement;
          clone.style.display = '';
          favGrid.appendChild(clone);
          n++;
        });
        (favSec as HTMLElement).hidden = n === 0;
        refreshHearts();
      }
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const btn = t.closest ? t.closest('.fav-btn') : null;
        if (!btn) return;
        e.preventDefault(); e.stopPropagation();
        const card = btn.closest('.card') as HTMLElement | null;
        if (!card) return;
        odFav.toggle(card.dataset.slug);
        build();
      });
      build();
    })();
    // ── Santo do dia (calculado na data do visitante; só biografias) ──
    (function () {
      const link = document.getElementById('santoDia');
      const dataEl = document.getElementById('santoData');
      if (!link || !dataEl) return;
      const items = Array.from(dataEl.querySelectorAll<HTMLElement>('i')).map((el) => ({
        feast: el.dataset.feast || '', name: el.dataset.name || '', url: el.dataset.url || '',
      })).filter((x) => /^\d{2}-\d{2}$/.test(x.feast));
      if (!items.length) return;

      const DAY = 86400000;
      const now = new Date(); now.setHours(0, 0, 0, 0);
      const mmdd = String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');

      // hoje? senão, a próxima data que tiver santo
      let feast = items.some((x) => x.feast === mmdd) ? mmdd : '';
      const isToday = !!feast;
      if (!feast) {
        let bestDelta = Infinity;
        for (const x of items) {
          const mm = +x.feast.slice(0, 2), dd = +x.feast.slice(3, 5);
          let d = new Date(now.getFullYear(), mm - 1, dd);
          if (d.getTime() < now.getTime()) d = new Date(now.getFullYear() + 1, mm - 1, dd);
          const delta = Math.round((d.getTime() - now.getTime()) / DAY);
          if (delta < bestDelta) { bestDelta = delta; feast = x.feast; }
        }
      }
      // todos os santos dessa data, juntos (a ordem já vem pronta do build)
      const group = items.filter((x) => x.feast === feast);
      if (!group.length) return;
      const many = group.length > 1;

      // vários santos no mesmo dia: a faixa deixa de ser um link único
      // e cada nome passa a levar à sua própria biografia
      let strip: HTMLElement = link;
      if (many) {
        const box = document.createElement('div');
        for (const at of Array.from(link.attributes)) if (at.name !== 'href') box.setAttribute(at.name, at.value);
        while (link.firstChild) box.appendChild(link.firstChild);
        link.replaceWith(box);
        strip = box;
      } else {
        (link as HTMLAnchorElement).href = group[0].url;
      }

      const nameEl = strip.querySelector<HTMLElement>('#santoDiaName');
      const dateEl = strip.querySelector<HTMLElement>('#santoDiaDate');
      const labEl = strip.querySelector<HTMLElement>('#santoDiaLabel');
      if (dateEl) dateEl.textContent = feast.slice(3, 5) + '/' + feast.slice(0, 2);
      // o rótulo plural usa chaves novas: tira o data-i18n para o Base não trocá-lo pela chave crua
      if (labEl) { if (many) labEl.removeAttribute('data-i18n'); else labEl.setAttribute('data-i18n', isToday ? 'santo_today' : 'santo_next'); }
      const render = () => {
        if (labEl) labEl.textContent = many
          ? (isToday ? tr('santos_today', 'Santos do dia') : tr('santos_next', 'Próximos santos'))
          : (window as any).odt(isToday ? 'santo_today' : 'santo_next');
        if (!nameEl) return;
        if (!many) { nameEl.textContent = group[0].name; return; }
        // "A e B" / "A, B e C", cada nome com o seu link
        const and = tr('list_and', 'e');
        nameEl.textContent = '';
        group.forEach((g, i) => {
          if (i > 0) nameEl.append(i === group.length - 1 ? ` ${and} ` : ', ');
          const a = document.createElement('a');
          a.href = g.url; a.textContent = g.name;
          nameEl.append(a);
        });
      };
      render();
      document.addEventListener('od:lang', render);
      strip.hidden = false;
    })();

    // ── Busca pelo endereço: /?q=termo (é o endereço que o Google usa) ──
    // preenche a busca do catálogo, aplica o filtro e rola até o catálogo
    (function () {
      let q = '';
      try { q = (new URLSearchParams(location.search).get('q') || '').trim().slice(0, 100); } catch (e) {}
      const input = document.getElementById('search') as HTMLInputElement | null;
      const cat = document.getElementById('catalogo');
      if (!q || !input || !cat) return;
      input.value = q;
      input.dispatchEvent(new Event('input'));
      // o topo fixo cobriria o título: desconta a altura dele
      const rolar = () => {
        const topo = (document.querySelector('.topbar') as HTMLElement | null)?.offsetHeight || 0;
        window.scrollTo({ top: cat.getBoundingClientRect().top + window.scrollY - topo - 8, behavior: 'auto' });
      };
      rolar();
      // quando imagens e fontes terminarem de chegar, confere de novo (se a pessoa ainda não rolou)
      let mexeu = false;
      const marca = () => { mexeu = true; };
      for (const ev of ['wheel', 'touchstart', 'keydown']) window.addEventListener(ev, marca, { once: true, passive: true });
      window.addEventListener('load', () => { if (!mexeu) rolar(); }, { once: true });
    })();
  </script>
</Base>

<script>
  (function () {
    var el = document.getElementById('liturgiaCta');
    if (!el) return;
    var base = el.getAttribute('data-base') || '/';
    var map = {};
    try { map = JSON.parse(el.getAttribute('data-map') || '{}'); } catch (e) {}
    var now = new Date();
    var key = '' + now.getFullYear() + String(now.getMonth() + 1).padStart(2, '0') + String(now.getDate()).padStart(2, '0');
    if (map[key]) {
      el.setAttribute('href', base.replace(/\/$/, '') + '/liturgia/' + map[key]);
    }
  })();
</script>

<style>
