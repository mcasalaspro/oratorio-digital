---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PrayerCard from '../components/PrayerCard.astro';
import CommunityCounter from '../components/CommunityCounter.astro';
import CompartilharOratorio from '../components/CompartilharOratorio.astro';
import { site, withBase } from '../config/site';
import { reserva } from '../config/contadores';
import { srcsetDoBanner } from '../scripts/oracao/banner';

// ── Fundo da abertura: um "espaço de oração" sorteado a cada visita (nunca o mesmo da visita
// anterior). "cel" = recorte no celular e no tablet (object-position): mostra a parte da
// imagem que tem sentido sozinha — no computador a imagem aparece inteira. Imagem nova:
// public/textures/hero-<nome>.webp (1536×1024) + uma linha aqui.
const HEROIS = [
  { k: 'manha', cel: '4% 40%' },     // janela ao amanhecer: crucifixo, rosas e a Bíblia
  { k: 'capela', cel: '72% 40%' },   // capela: o altar ao fundo e as velas votivas
  { k: 'oratorio', cel: '90% 40%' }, // oratório mineiro com as imagens
  { k: 'mesa', cel: '100% 40%' },    // mesa de oração: o ícone, o lírio e o crucifixo
].filter((h) => fs.existsSync(`public/textures/hero-${h.k}.webp`))
 .map((h) => ({ ...h, u: withBase(`/textures/hero-${h.k}.webp`), s: srcsetDoBanner(`/textures/hero-${h.k}.webp`) }));
const heroReserva = withBase('/textures/rays.webp');
const heroScript = `(function(){var H=${JSON.stringify(HEROIS.map((h) => ({ k: h.k, u: h.u, s: h.s, c: h.cel })))};var el=document.getElementById('heroBg');if(!el)return;`
  + `if(!H.length){el.src=${JSON.stringify(heroReserva)};return;}var a=-1;try{a=+localStorage.getItem('od-heroi');}catch(e){}`
  + `var i=Math.floor(Math.random()*H.length);if(H.length>1&&i===a)i=(i+1)%H.length;try{localStorage.setItem('od-heroi',String(i));}catch(e){}`
  + `var h=H[i];el.classList.add('heroi-'+h.k);el.style.setProperty('--heroi-cel',h.c);if(h.s){el.sizes='(max-width: 1000px) 1536px, 100vw';el.srcset=h.s;}el.src=h.u;})();`;

const all = await getCollection('prayers');
const liturgiaEntries = await getCollection('liturgia');
const liturgiaToday = {};
for (const e of liturgiaEntries) {
  const m = e.id.match(/(\d{4})(\d{2})(\d{2})/);   // AAAAMMDD do nome do arquivo
  if (m) liturgiaToday[m[1] + m[2] + m[3]] = e.id;
}

// Aviso de build: imagem de alguma oração faltando em public/saints/
// (o nome do arquivo .webp deve ser EXATAMENTE o nome da oração, minúsculo)
{
  const missing = all.map((p) => p.id).filter((id) => !fs.existsSync(`public/saints/${id}.webp`));
  if (missing.length) {
    console.warn('\n⚠️  Imagens faltando em public/saints/ (essas orações vão usar default.webp):');
    for (const id of missing) console.warn(`    • public/saints/${id}.webp   (oração "${id}")`);
    console.warn('   Confira nome EXATO (minúsculo, sem acento), extensão .webp e a pasta public/saints/.\n');
  }
}

// catálogo: destaques primeiro, depois por título
const catalog = [...all].sort((a, b) => {
  const fa = a.data.featured ? (a.data.featuredOrder ?? 50) : 999;
  const fb = b.data.featured ? (b.data.featuredOrder ?? 50) : 999;
  if (fa !== fb) return fa - fb;
  return a.data.title.localeCompare(b.data.title);
});

// orações fixas em destaque (a partir do painel)
const byId = new Map(all.map((p) => [p.id, p]));
const pinned = site.pinnedPrayers
  .sort((a, b) => a.order - b.order)
  .map((p) => byId.get(p.id))
  .filter(Boolean);

// "Santo do dia": SOMENTE biografias com data de festa (campo feast "MM-DD").
// Santos do mesmo dia aparecem juntos ("São Pedro e São Paulo"), nesta ordem:
// a tradicional para os pares conhecidos, depois os destaques (featured/order) e o nome.
const bios = await getCollection('biografias');
const ORDEM_TRADICIONAL = ['sao-pedro-apostolo', 'sao-paulo-apostolo', 'sao-miguel-arcanjo', 'sao-gabriel-arcanjo', 'sao-rafael-arcanjo'];
const _trad = (id: string) => { const i = ORDEM_TRADICIONAL.indexOf(id); return i < 0 ? 999 : i; };
const santos = bios
  .filter((b) => /^\d{2}-\d{2}$/.test(b.data.feast ?? ''))
  .map((b) => ({
    id: b.id,
    feast: b.data.feast as string,
    name: b.data.name ?? b.id,
    url: withBase(`/biografia/${b.id}`),
    rank: b.data.featured ? (b.data.order ?? 50) : 999,
  }))
  .sort((a, b) => a.feast.localeCompare(b.feast) || _trad(a.id) - _trad(b.id) || a.rank - b.rank || a.name.localeCompare(b.name, 'pt-BR'));
const santosDados = santos.map((s) => ({ f: s.feast, n: s.name, u: s.url }));

// dados embutidos em <script type="application/json">: nenhum texto fecha o <script> antes da hora
const json = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');

// números de reserva do contador (src/data/contadores.json, se o build tiver trazido):
// aparecem quando o serviço não responde e não há número guardado no aparelho
const reservaTotal = reserva(site.counter.totalKey ?? 'total');
const reservaVisitas = reserva(site.counter.visitsKey ?? 'visits');

// filtros do catálogo: os tipos numa ordem fixa ("Outro" por último)
const ORDEM_TIPOS = ['oracao', 'novena', 'terco', 'rosario', 'dezena', 'ladainha', 'hino', 'devocional', 'liturgia', 'bizantina', 'outro'];
const presentes = new Set(all.map((p) => p.data.type));
const types = [...ORDEM_TIPOS.filter((t) => presentes.has(t)), ...[...presentes].filter((t) => !ORDEM_TIPOS.includes(t))];
// a linha "Idioma" só aparece quando houver mais de uma oração fora do português
const langs = [...new Set(all.map((p) => p.data.language ?? 'pt-BR'))];
const outrasLinguas = all.filter((p) => (p.data.language ?? 'pt-BR') !== 'pt-BR').length;
const mostrarIdioma = langs.length > 1 && outrasLinguas > 1;
---
<Base>
  <Fragment slot="head">
    <!-- com JavaScript, o catálogo já nasce mostrando só os 50 primeiros cartões (os outros
         continuam no HTML, com os links, para o Google e para quem está sem JavaScript) -->
    <script is:inline>document.documentElement.classList.add('od-catalogo-js');</script>
  </Fragment>
  <!-- ícones usados muitas vezes na página (o coração de cada cartão: <use href="#i-coracao">) -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="i-coracao" viewBox="0 0 24 24"><path d="M12 21l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.18L12 21z" stroke-width="2" /></symbol>
  </svg>

  <!-- ════════ HERO ════════ -->
  <section class="hero">
    <!-- o script logo abaixo escolhe a imagem antes de ela começar a baixar (sem ele: a imagem de sempre) -->
    <img class="hero-bg" id="heroBg" alt="" aria-hidden="true" data-parallax="0.12" fetchpriority="high" onerror="this.style.display='none'" />
    <script is:inline set:html={heroScript}></script>
    <noscript><img class="hero-bg" src={HEROIS.length ? HEROIS[0].u : heroReserva} alt="" aria-hidden="true" /></noscript>
    <span class="hero-shade" aria-hidden="true"></span>
    <div class="hero-inner">
      <!-- logo leve: o CSS exibe entre 108 e 164 px, então basta a versão de 128 px ou a de 340 px (telas nítidas) -->
      <img class="hero-logo" src={withBase('/logo-340.webp')}
           srcset={`${withBase('/logo-128.webp')} 128w, ${withBase('/logo-340.webp')} 340w`}
           sizes="(max-width: 635px) 108px, (max-width: 965px) 17vw, 164px"
           alt={site.name} width="164" height="164" />
      <a class="season-badge" id="seasonBadge" href={withBase('/textos/tempos-liturgicos')} hidden>
        <span class="season-dot" aria-hidden="true"></span>
        <span id="seasonBadgeText"></span>
      </a>
      <a class="season-next" id="seasonNext" href={withBase('/textos/tempos-liturgicos')} hidden></a>
      <h1>{site.name}</h1>
      <p class="lead-line">{site.tagline}</p>
      <p class="hero-stats" id="heroStats" data-reserva-total={reservaTotal ?? undefined} data-reserva-visitas={reservaVisitas ?? undefined}><strong>{all.length}</strong> <span data-i18n="stat_prayers">orações</span><span class="sep">·</span><strong>{bios.length}</strong> <span data-i18n="stat_bios">biografias</span><span id="visitStat"><span class="sep">·</span><strong id="visitNumber">—</strong> <span data-i18n="visits_label">visitas</span></span></p>
      {site.showCommunityCounter && (
        <Fragment>
          <CommunityCounter />
          {/* orações de hoje (só o Supabase sabe): "12 orações hoje"; some sem número */}
          <p class="votive-today" id="communityToday" hidden></p>
          {/* gráfico do dia a dia e as mais rezadas: src/pages/numeros.astro */}
          <p class="hero-numeros"><a href={withBase('/numeros')} data-i18n="see_numbers">Ver os números do Oratório</a></p>
        </Fragment>
      )}
      <!-- imagem do site para Instagram e WhatsApp (aparece quando o compartilhar.js carrega) -->
      <p class="hero-share"><CompartilharOratorio classe="btn hero-share-btn" /></p>
    </div>
  </section>

  <!-- ════════ LITURGIA DO DIA (botão de abertura) ════════ -->
  <!-- só aparece quando houver ao menos uma Liturgia em src/content/liturgia/ (volta sozinho) -->
  {liturgiaEntries.length > 0 && (
    <div class="wrap">
      <a class="liturgia-cta" id="liturgiaCta" href={withBase('/liturgia')} data-map={JSON.stringify(liturgiaToday)} data-base={import.meta.env.BASE_URL}>
        <span class="liturgia-cta-icon" aria-hidden="true">&#10013;</span>
        <span class="liturgia-cta-text">
          <span class="liturgia-cta-k" data-i18n="liturgia_read">Ler a Liturgia do dia</span>
          <span class="liturgia-cta-sub">As leituras da Missa de hoje</span>
        </span>
        <span class="liturgia-cta-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  )}
  <!-- ════════ SANTO DO DIA (faixa, revelada conforme a data) ════════ -->
  {santos.length > 0 && (
    <div class="wrap">
      <a class="santo-dia" id="santoDia" hidden href="#">
        <span class="santo-dia-seal">✦ <span id="santoDiaLabel" data-i18n="santo_today">Santo do dia</span></span>
        <span class="santo-dia-name" id="santoDiaName"></span>
        <span class="santo-dia-date" id="santoDiaDate"></span>
        <span class="santo-dia-arrow" aria-hidden="true">&rarr;</span>
      </a>
      <script type="application/json" id="santoDados" set:html={json(santosDados)}></script>
    </div>
  )}

  <!-- ════════ ORAÇÃO DO DIA (destaque revelado conforme a data) ════════ -->
  <!-- os dados vêm dos próprios cartões do catálogo (data-feast, data-offset, data-total);
       a imagem grande é a da oração escolhida: só ela é baixada -->
  <section class="section today-section" id="today" data-imgs={withBase('/saints/')} data-fallback={withBase('/saints/default.webp')}>
    <div class="wrap">
      <a class="today-card" id="todayCard" href="#">
        <img class="today-bg" id="todayImg" alt="" aria-hidden="true" />
        <span class="today-shade"></span>
        <span class="today-inner">
          <span class="today-seal" data-i18n="today_seal">Oração do dia</span>
          <h2 class="today-title" id="todayTitle"></h2>
          <span class="today-meta" id="todayMeta"></span>
          <span class="today-reason" id="todayReason"></span>
          <span class="today-brasil" id="todayBrasil" hidden></span>
          <span class="today-cta" data-i18n="today_cta">Rezar agora</span>
        </span>
      </a>
      <!-- outras novenas em curso hoje (cada uma no dia certo) -->
      <div class="andamento" id="andamento" data-festas={withBase('/proximas-festas')} hidden>
        <p class="andamento-k" id="andamentoK"></p>
        <ul class="andamento-lista" id="andamentoLista"></ul>
      </div>
    </div>
  </section>

  <!-- ════════ ORAÇÕES FIXAS ════════ -->
  {pinned.length > 0 && (
    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-i18n="pinned_title">Orações do dia a dia</p>
        <h2 class="section-title" data-i18n="pinned_title">Orações do dia a dia</h2>
        <div class="grid grid--pinned">
          {pinned.map((p) => <PrayerCard prayer={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ════════ MINHAS ORAÇÕES (favoritos, revelado se houver) ════════ -->
  <section class="section" id="favSection" hidden>
    <div class="wrap">
      <p class="eyebrow" data-i18n="favorites_title">Minhas orações</p>
      <h2 class="section-title" data-i18n="favorites_title">Minhas orações</h2>
      <div class="grid grid--pinned" id="favGrid"></div>
    </div>
  </section>

  <!-- ════════ CATÁLOGO ════════ -->
  <section class="section" id="catalogo" data-img-reserva={withBase('/saints/default.webp')}>
    <div class="wrap">
      <p class="eyebrow" data-i18n="catalog_title">Catálogo</p>
      <h2 class="section-title" data-i18n="catalog_title">Catálogo</h2>

      <div class="toolbar">
        <input id="search" class="search" type="search" placeholder="Buscar oração, novena ou santo…" data-i18n-ph="search_placeholder" />
        <!-- para conhecer algo novo: public/js/sortear.js (sem JS, a página /sortear/) -->
        <a class="btn btn-sortear" href={withBase('/sortear')} data-od-sortear>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span data-i18n="random_prayer">Sortear uma oração</span>
        </a>
      </div>
      <div class="filters">
        <div class="filter-row">
          <span class="filter-label" data-i18n="lbl_type">Tipo</span>
          <div class="chips" id="typeChips" role="group" aria-label="Tipo de oração">
            <button class="chip" data-type="" aria-pressed="true" data-i18n="filter_all">Todas</button>
            {types.map((t) => <button class="chip" data-type={t} aria-pressed="false" data-i18n={`type_${t}`}>{t}</button>)}
          </div>
        </div>
        <div class="filter-row">
          <span class="filter-label" data-i18n="lbl_date">Data</span>
          <div class="chips" id="dateChips" role="group" aria-label="Data">
            <button class="chip" data-date="" aria-pressed="true" data-i18n="filter_all">Todas</button>
            <button class="chip" data-date="today" aria-pressed="false" data-i18n="filter_today">Hoje</button>
            <button class="chip" data-date="week" aria-pressed="false" data-i18n="filter_week">Essa semana</button>
            <button class="chip" data-date="month" aria-pressed="false" data-i18n="filter_month">Este mês</button>
          </div>
        </div>
        {mostrarIdioma && (
          <div class="filter-row">
            <span class="filter-label" data-i18n="lbl_lang">Idioma</span>
            <div class="chips" id="langChips" role="group" aria-label="Idioma">
              <button class="chip" data-lang="" aria-pressed="true" data-i18n="filter_all">Todas</button>
              {langs.map((l) => <button class="chip" data-lang={l} aria-pressed="false">{l.slice(0,2).toUpperCase()}</button>)}
            </div>
          </div>
        )}
      </div>

      <div class="grid" id="catalogGrid">
        {catalog.map((p) => <PrayerCard prayer={p} />)}
      </div>
      <button class="btn show-more" id="showMore" type="button" hidden data-i18n="show_more">Mostrar mais</button>
      <p class="empty" id="emptyMsg" hidden data-i18n="no_results">Nenhuma oração encontrada com esses filtros.</p>
    </div>
  </section>
  <!-- marca "vezes rezada" para os cartões que ainda não têm (número vivo do contador) -->
  <template id="tplReza"><span class="pill pill-reza"><span class="pill-reza-n"></span><span class="sr-only"> <span class="pill-reza-lab"></span></span></span></template>


  <script>
    // último número bom guardado neste aparelho (0 = nenhum)
    function cachedCount(key: string): number {
      try { const n = Number(localStorage.getItem(key)); return Number.isFinite(n) && n > 0 ? n : 0; } catch (e) { return 0; }
    }
    function fmtCount(n: number) {
      const l = document.documentElement.getAttribute('data-lang') || 'pt-BR';
      return new Intl.NumberFormat(l).format(n);
    }
    // texto da interface com reserva em português (para chaves ainda fora do site.ts)
    function tr(k: string, pt: string) { const f = (window as any).odt; const v = f ? f(k) : k; return v && v !== k ? v : pt; }
    // dados embutidos na página (<script type="application/json">)
    function dados<T>(id: string): T[] {
      try { return JSON.parse(document.getElementById(id)?.textContent || '[]'); } catch (e) { return []; }
    }
    // calendário litúrgico do site inteiro (public/js/calendario.js): datas fixas e festas móveis
    const CAL = (window as any).odCalendario;
    const dm = (d: Date) => String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0');

    // ── imagem de cartão que não carregou → a imagem padrão (um ouvinte só para todos) ──
    (function () {
      const reserva = document.getElementById('catalogo')?.dataset.imgReserva || '';
      if (!reserva) return;
      const troca = (img: HTMLImageElement) => { if (img.getAttribute('src') !== reserva) img.src = reserva; };
      document.addEventListener('error', (e) => {
        const t = e.target;
        if (t instanceof HTMLImageElement && t.classList.contains('card-img')) troca(t);
      }, true);
      // alguma pode ter falhado antes deste script rodar
      document.querySelectorAll<HTMLImageElement>('img.card-img').forEach((img) => {
        if (img.complete && img.currentSrc && img.naturalWidth === 0) troca(img);
      });
    })();

    // ── Contadores da comunidade: vela, visitas, "hoje" e os cartões do catálogo ──
    // Uma leitura só (window.odContador — public/js/contador.js): no Supabase vem tudo de
    // uma vez (total, visitas, 'hoje' e cada oração); no Abacus, só total e visitas, e os
    // cartões ficam com a reserva do build. A visita conta uma vez por sessão (od-visited).
    // Número mostrado: o vivo; sem ele, o maior entre o guardado neste aparelho e a reserva
    // do build; sem nenhum, o bloco some — nunca "0".
    (function () {
      const C = (window as any).odContador;
      const stats = document.getElementById('heroStats');
      const elTotal = document.getElementById('communityNumber');
      const boxTotal = document.getElementById('community');
      const elVis = document.getElementById('visitNumber');
      const boxVis = document.getElementById('visitStat');
      const elHoje = document.getElementById('communityToday');
      const hideTotal = () => { if (boxTotal) boxTotal.style.display = 'none'; if (elHoje) elHoje.hidden = true; };   // .votive tem display próprio: hidden não bastaria
      const hideVis = () => { if (boxVis) boxVis.hidden = true; };
      if (!C || !C.ativo) { hideTotal(); hideVis(); document.querySelector<HTMLElement>('.hero-numeros')?.setAttribute('hidden', ''); return; }

      const reservaDe = (attr: string) => { const n = Number(stats?.getAttribute(attr)); return Number.isFinite(n) && n > 0 ? n : 0; };
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // números na tela (0 = nenhum ainda)
      let total = Math.max(cachedCount('od-total-cache'), reservaDe('data-reserva-total'));
      let visitas = Math.max(cachedCount('od-visits-cache'), reservaDe('data-reserva-visitas'));
      let hoje = 0;
      if (elTotal && total) elTotal.textContent = fmtCount(total);
      if (elVis && visitas) elVis.textContent = fmtCount(visitas);

      function animate(el: HTMLElement, from: number, to: number) {
        if (reduce || from === to) { el.textContent = fmtCount(to); return; }
        const dur = 1100, t0 = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - t0) / dur);
          el.textContent = fmtCount(Math.round(from + (to - from) * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }
      function renderHoje() {
        if (!elHoje) return;
        if (!(hoje > 0) || !total) { elHoje.hidden = true; return; }
        elHoje.textContent = '';
        const b = document.createElement('b'); b.textContent = fmtCount(hoje);
        elHoje.append(b, ' ' + (hoje === 1 ? tr('community_today_one', 'oração hoje') : tr('community_today', 'orações hoje')));
        elHoje.hidden = false;
      }
      // marca "N vezes rezada" do cartão (PrayerCard): cria a partir do <template> se faltar
      const tpl = document.getElementById('tplReza') as HTMLTemplateElement | null;
      function setReza(card: HTMLElement, n: number) {
        if (!(n > 0)) return;
        let pill = card.querySelector<HTMLElement>('.pill-reza');
        if (!pill) {
          const foot = card.querySelector('.card-foot');
          const novo = tpl?.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
          if (!foot || !novo) return;
          foot.append(novo); pill = novo;
        }
        const num = pill.querySelector<HTMLElement>('.pill-reza-n');
        const lab = pill.querySelector<HTMLElement>('.pill-reza-lab');
        let txt: string;
        if (n === 1) { txt = tr('count_short_one', 'vez rezada'); lab?.removeAttribute('data-i18n'); }
        else { txt = tr('count_short', 'vezes rezada'); lab?.setAttribute('data-i18n', 'count_short'); }
        pill.dataset.n = String(n);
        if (num) num.textContent = fmtCount(n);
        if (lab) lab.textContent = txt;
        pill.title = `${fmtCount(n)} ${txt}`;
      }
      const cartoes = () => Array.from(document.querySelectorAll<HTMLElement>('.card-oracao[data-slug]'));

      // a visita conta uma vez por sessão; no Abacus, a própria contagem já traz as visitas
      let contar = false;
      try { contar = sessionStorage.getItem('od-visited') !== '1'; } catch (e) {}
      const pLer: Promise<Record<string, number> | null> = (contar && C.servico === 'abacus') ? C.ler([C.chaves.total]) : C.ler();
      const pVisita: Promise<number | null> = contar ? C.contarVisita() : Promise.resolve(null);

      pLer.then((m) => {
        const vivo = (k: string) => { const v = m ? Number(m[k]) : NaN; return Number.isFinite(v) && v > 0 ? v : 0; };
        const t = vivo(C.chaves.total);
        if (t) {
          try { localStorage.setItem('od-total-cache', String(t)); } catch (e) {}
          if (elTotal) animate(elTotal, total, t);
          total = t;
        } else if (!total) hideTotal();
        if (C.servico === 'supabase') {
          hoje = vivo('hoje');
          renderHoje();
          // cartões: no Supabase a leitura traz todas as orações de uma vez; o número vivo
          // substitui a reserva (sem número vivo, fica a reserva — ou o cartão segue sem marca)
          if (m) for (const c of cartoes()) { const v = vivo(c.dataset.slug || ''); if (v) setReza(c, v); }
        }
      });
      Promise.all([pLer, pVisita]).then(([m, nv]) => {
        if (contar && nv != null && nv > 0) { try { sessionStorage.setItem('od-visited', '1'); } catch (e) {} }
        const lido = m ? Number(m[C.chaves.visitas]) : NaN;
        const v = (nv != null && nv > 0) ? nv : (Number.isFinite(lido) && lido > 0 ? lido : 0);
        if (v) {
          try { localStorage.setItem('od-visits-cache', String(v)); } catch (e) {}
          if (elVis) elVis.textContent = fmtCount(v);
          visitas = v;
        } else if (!visitas) hideVis();
      });

      // troca de idioma: refaz os números (separador de milhar) e os rótulos novos
      document.addEventListener('od:lang', () => {
        if (elTotal && total) elTotal.textContent = fmtCount(total);
        if (elVis && visitas) elVis.textContent = fmtCount(visitas);
        renderHoje();
        for (const c of cartoes()) { const n = Number(c.querySelector<HTMLElement>('.pill-reza')?.dataset.n); if (n > 0) setReza(c, n); }
      });
    })();

    // ── Oração do dia + novenas em andamento (na data do visitante, pelo odCalendario) ──
    (function () {
      type Lit = { u: string; f: string; s: number; n: number; t: string; i: string; h: string; m: string };
      type Ativa = { d: Lit; feast: Date; start: Date; daysToFeast: number; suggestedDay: number };
      const todaySec = document.getElementById('today');
      if (!todaySec || !CAL) return;
      // candidatas: cartões do catálogo com data de festa ('MM-DD' ou o nome de uma festa
      // móvel, ex.: 'pentecostes'). As devoções de mês ("mes-…", ex.: Mês de Maria) ficam
      // de fora: a data delas marca o início do mês, não uma festa.
      const imgs = todaySec.dataset.imgs || '';
      const lista: Lit[] = [];
      document.querySelectorAll<HTMLElement>('#catalogGrid .card[data-feast]').forEach((c) => {
        const slug = c.dataset.slug || '', link = c.querySelector<HTMLAnchorElement>('.card-link');
        if (!slug || slug.startsWith('mes-') || !link) return;
        lista.push({
          u: link.getAttribute('href') || '', f: c.dataset.feast || '',
          s: parseInt(c.dataset.offset || '0', 10) || 0, n: parseInt(c.dataset.total || '1', 10) || 1,
          t: c.dataset.type || '', i: c.dataset.img || `${imgs}${slug}.webp`,
          h: (link.textContent || '').trim(), m: (c.querySelector('.card-saint')?.textContent || '').trim(),
        });
      });
      const hojeD: Date = CAL.hoje();
      const active: Ativa[] = [];
      for (const d of lista) {
        if (!CAL.valido(d.f)) continue;
        const feast: Date | null = CAL.proxima(d.f, hojeD);   // a própria data da festa conta como "hoje"
        if (!feast) continue;
        const start: Date = CAL.somarDias(feast, d.s || 0);
        const desde = CAL.dias(start, hojeD), faltam = CAL.dias(hojeD, feast);
        if (desde < 0 || faltam < 0) continue;
        const total = d.n || 1;
        active.push({ d, feast, start, daysToFeast: faltam, suggestedDay: Math.min(total, Math.max(1, desde + 1)) });
      }
      if (active.length === 0) return;
      // 1º a festa de HOJE (no empate, a novena vence os demais tipos);
      // depois, a novena em andamento vence devoções de vários dias que não são novena
      // (ex.: Antífonas Ó, de 17 a 23/12, não tiram a Novena de Natal do destaque);
      // depois, a festa mais próxima; por fim, a ordem alfabética do título
      // devoção de vários dias que NÃO é novena (ex.: Antífonas Ó, de 17 a 23/12): a data dela é o último
      // dia do período, não uma festa — não passa à frente da novena em curso nem diz "A festa é hoje!"
      const periodo = (x: Ativa) => (x.d.s || 0) < 0 && (x.d.n || 1) <= 1;
      const ehHoje = (x: Ativa) => (x.daysToFeast === 0 && !periodo(x) ? 0 : 1);
      const ehNovena = (x: Ativa) => (x.d.t === 'novena' ? 1 : 0);
      active.sort((a, b) =>
        ehHoje(a) - ehHoje(b) ||
        ehNovena(b) - ehNovena(a) ||
        a.daysToFeast - b.daysToFeast ||
        a.d.h.localeCompare(b.d.h, 'pt-BR'));

      const today = active[0];
      const total = today.d.n || 1;
      // link para o dia certo da novena (endereço com barra final + ?dia=N)
      const linkDia = (x: Ativa) => x.d.u + ((x.d.n || 1) > 1 && x.daysToFeast > 0 ? `?dia=${x.suggestedDay}` : '');
      // só agora baixa uma imagem: a da oração escolhida (com a padrão de reserva)
      const tImg = document.getElementById('todayImg') as HTMLImageElement | null;
      if (tImg && today.d.i) {
        const fallback = todaySec.dataset.fallback || '';
        tImg.addEventListener('error', () => { if (fallback && tImg.getAttribute('src') !== fallback) tImg.src = fallback; });
        tImg.src = today.d.i;
      }
      const tEl = document.getElementById('todayTitle'); if (tEl) tEl.textContent = today.d.h;
      const tM = document.getElementById('todayMeta'); if (tM) tM.textContent = today.d.m;
      const tCard = document.getElementById('todayCard') as HTMLAnchorElement | null;
      if (tCard) tCard.href = total > 1 ? today.d.u + `?dia=${today.suggestedDay}` : today.d.u;

      // no Brasil a solenidade pode ir para o domingo (Assunção, Todos os Santos, S. Pedro e S. Paulo…)
      const noBr: Date | null = CAL.noBrasil(today.d.f, today.feast.getFullYear());
      // outras novenas em curso (não as que já chegaram ao dia da festa), a mais perto da festa primeiro;
      // no celular, no máximo 2 (o catálogo não vai para longe); o resto fica em "Próximas festas"
      const MAX = window.matchMedia('(max-width: 560px)').matches ? 2 : 3;
      const outras = active.filter((x) => x !== today && (x.d.n || 1) > 1 && x.daysToFeast > 0)
        .sort((a, b) => a.daysToFeast - b.daysToFeast || a.d.h.localeCompare(b.d.h, 'pt-BR'));
      const caixa = document.getElementById('andamento'), ul = document.getElementById('andamentoLista'), cab = document.getElementById('andamentoK');

      const fill = () => {
        const tt = (window as any).odt;
        const feastStr = dm(today.feast), startStr = dm(today.start);
        let reason: string;
        if (periodo(today)) reason = `${startStr}–${feastStr}`;
        else if (today.daysToFeast === 0) reason = `${tt('feast_today')} (${feastStr})`;
        else if (total > 1) reason = `${tt('day')} ${today.suggestedDay} ${tt('day_of')} ${total} · ${startStr}–${feastStr}`;
        else reason = feastStr;
        const rEl = document.getElementById('todayReason'); if (rEl) rEl.textContent = reason;
        const br = document.getElementById('todayBrasil');
        if (br) {
          br.hidden = !noBr;
          // "Assunção: no Brasil, celebrada no domingo 20/08"
          if (noBr) br.textContent = tr('brasil_festa', '{festa}: no Brasil, celebrada no domingo {data}')
            .replace('{festa}', CAL.nomeBrasil(today.d.f)).replace('{data}', dm(noBr));
        }

        if (!caixa || !ul || !cab) return;
        caixa.hidden = outras.length === 0;
        if (!outras.length) return;
        const destaqueEmCurso = total > 1 && today.daysToFeast > 0;
        cab.textContent = destaqueEmCurso ? tr('novenas_outras', 'Outras novenas em andamento') : tr('novenas_andamento', 'Novenas em andamento');
        ul.textContent = '';
        // a linha inteira é o link (área de toque grande): "Novena de … · Dia 5 de 9"
        for (const x of outras.slice(0, MAX)) {
          const li = document.createElement('li');
          const a = document.createElement('a'); a.href = linkDia(x);
          const nome = document.createElement('span'); nome.className = 'andamento-t'; nome.textContent = x.d.h;
          const dia = document.createElement('span'); dia.className = 'andamento-dia';
          dia.textContent = `${tt('day')} ${x.suggestedDay} ${tt('day_of')} ${x.d.n}`;
          a.append(nome, ' ', dia); li.append(a); ul.append(li);
        }
        if (outras.length > MAX) {
          const li = document.createElement('li'); li.className = 'andamento-mais';
          const a = document.createElement('a'); a.href = caixa.dataset.festas || '';
          a.textContent = `+ ${outras.length - MAX} · ${tt('nav_feasts')} →`;
          li.append(a); ul.append(li);
        }
      };
      fill();
      document.addEventListener('od:lang', fill);
      todaySec.style.display = 'block';
    })();

    // ── Filtros do catálogo ──
    (function () {
      const grid = document.getElementById('catalogGrid');
      const search = document.getElementById('search') as HTMLInputElement | null;
      const empty = document.getElementById('emptyMsg');
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
      let fType = '', fLang = '', fDate = '';
      let fWords: string[] = [];   // palavras buscadas: TODAS precisam aparecer, em qualquer ordem
      // sinônimos de uso comum: muita gente chama a "Coroa" de "Terço" (Terço da Misericórdia)
      const SINONIMOS: Record<string, string[]> = { terco: ['terco', 'coroa'], coroa: ['coroa', 'terco'] };
      const norm = (x: string) => (x || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      // texto de busca de cada cartão, já sem acentos: título + santo + o resto (data-search)
      const hay = new WeakMap<HTMLElement, string>();
      for (const c of cards) {
        const tit = c.querySelector('.card-title')?.textContent || '', santo = c.querySelector('.card-saint')?.textContent || '';
        hay.set(c, norm(`${tit} ${santo} ${c.dataset.search || ''}`));
      }
      const STEP = 50;
      let limit = STEP;
      const moreBtn = document.getElementById('showMore');

      // calcula uma vez se a festa de cada oração é hoje / nesta semana / neste mês (odCalendario)
      const vazio = { today: false, week: false, month: false };
      const dflag = new WeakMap<HTMLElement, { today: boolean; week: boolean; month: boolean }>();
      const hojeD: Date | null = CAL ? CAL.hoje() : null;
      const mesmoMes = (d: Date | null) => !!d && !!hojeD && d.getMonth() === hojeD.getMonth() && d.getFullYear() === hojeD.getFullYear();
      for (const c of cards) {
        const codigo = c.dataset.feast || '';
        if (!hojeD || !CAL.valido(codigo)) { dflag.set(c, vazio); continue; }
        const feast: Date | null = CAL.proxima(codigo, hojeD);
        if (!feast) { dflag.set(c, vazio); continue; }
        const total = parseInt(c.dataset.total || '1', 10);
        // a janela (novenaSuggestedStart) vale também para devoções de vários dias que não são novena (Antífonas Ó)
        const offset = parseInt(c.dataset.offset || '0', 10);
        const start: Date = CAL.somarDias(feast, offset);
        const faltam = CAL.dias(hojeD, feast), desde = CAL.dias(start, hojeD);
        const inWindow = desde >= 0 && faltam >= 0;
        const isToday = faltam === 0 || inWindow;
        const isWeek = (faltam >= 0 && faltam <= 7) || (CAL.dias(hojeD, start) <= 7 && faltam >= 0);
        // "este mês": a festa deste ano cai neste mês, ou a próxima (ou a janela dela) começa nele
        const desteAno: Date | null = CAL.data(codigo, hojeD.getFullYear());
        const isMonth = mesmoMes(desteAno) || mesmoMes(feast) || (total > 1 && mesmoMes(start));
        dflag.set(c, { today: isToday, week: isWeek, month: isMonth });
      }

      function apply() {
        let matched = 0;
        for (const c of cards) {
          const okType = !fType || c.dataset.type === fType;
          const okLang = !fLang || (c.dataset.lang || 'pt-BR') === fLang;
          const okText = !fWords.length || fWords.every((w) => (SINONIMOS[w] || [w]).some((s) => (hay.get(c) || '').includes(s)));
          const f = dflag.get(c) || vazio;
          const okDate = !fDate || (fDate === 'today' && f.today) || (fDate === 'week' && f.week) || (fDate === 'month' && f.month);
          const show = okType && okLang && okText && okDate;
          if (show) { matched++; c.style.display = matched <= limit ? '' : 'none'; }
          else { c.style.display = 'none'; }
        }
        if (empty) empty.hidden = matched !== 0;
        if (moreBtn) moreBtn.hidden = matched <= limit;
      }
      function wireChips(sel: string, attr: string, set: (v: string) => void) {
        const group = document.querySelector(sel);
        if (!group) return;
        group.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest('.chip') as HTMLElement | null;
          if (!btn) return;
          group.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
          btn.setAttribute('aria-pressed', 'true');
          set(btn.dataset[attr] || '');
          limit = STEP;
          apply();
        });
      }
      wireChips('#typeChips', 'type', (v) => (fType = v));
      wireChips('#dateChips', 'date', (v) => (fDate = v));
      wireChips('#langChips', 'lang', (v) => (fLang = v));
      // "terço misericórdia" acha a "Coroa da Divina Misericórdia" (acentos e maiúsculas não importam)
      search?.addEventListener('input', () => { fWords = norm(search.value).split(/[^a-z0-9]+/).filter(Boolean); limit = STEP; apply(); });
      moreBtn?.addEventListener('click', () => { limit += STEP; apply(); });
      apply();
      grid.classList.add('pronto');   // daqui em diante quem esconde é o filtro (ver o CSS do fim)
    })();
    // ── Favoritos ("Minhas orações") ──
    (function () {
      const odFav = (window as any).odFav;
      if (!odFav) return;
      const favGrid = document.getElementById('favGrid');
      const favSec = document.getElementById('favSection');
      const source: Record<string, HTMLElement> = {};
      document.querySelectorAll<HTMLElement>('#catalogGrid .card[data-slug]').forEach((c) => {
        if (!source[c.dataset.slug!]) source[c.dataset.slug!] = c;
      });
      function refreshHearts() {
        document.querySelectorAll<HTMLElement>('.card[data-slug] .fav-btn').forEach((btn) => {
          const card = btn.closest('.card') as HTMLElement | null;
          if (card) btn.setAttribute('aria-pressed', odFav.has(card.dataset.slug) ? 'true' : 'false');
        });
      }
      // nome do botão para o leitor de tela: "Salvar Pai Nosso nos favoritos" (o estado vem do aria-pressed)
      function rotulos() {
        const modelo = tr('fav_add_label', 'Salvar {nome} nos favoritos');
        document.querySelectorAll<HTMLElement>('.card-oracao .fav-btn').forEach((btn) => {
          const nome = btn.closest('.card')?.querySelector('.card-link')?.textContent || '';
          btn.setAttribute('aria-label', modelo.replace('{nome}', nome));
        });
      }
      // monta "Minhas orações" sem recriar as cópias que continuam salvas (o foco do teclado não se perde)
      function build() {
        if (!favGrid || !favSec) return;
        const salvas: string[] = odFav.all().filter((s: string) => source[s]);
        const ja = new Set<string>();
        favGrid.querySelectorAll<HTMLElement>('.card[data-slug]').forEach((c) => {
          const s = c.dataset.slug || '';
          if (salvas.includes(s) && !ja.has(s)) ja.add(s); else c.remove();
        });
        for (const s of salvas) {
          if (ja.has(s)) continue;
          const clone = source[s].cloneNode(true) as HTMLElement;
          clone.style.display = '';
          favGrid.appendChild(clone);
        }
        favSec.hidden = salvas.length === 0;
        refreshHearts();
      }
      // o coração é um botão ao lado do link (não dentro dele): clicar não abre a oração
      document.addEventListener('click', (e) => {
        const btn = (e.target as Element | null)?.closest?.('.fav-btn') as HTMLElement | null;
        if (!btn) return;
        const card = btn.closest('.card') as HTMLElement | null;
        const slug = card?.dataset.slug;
        if (!card || !slug) return;
        e.preventDefault();
        // se o cartão sair de "Minhas orações", o foco vai para o vizinho (ou para o cartão do catálogo)
        const viz = favGrid?.contains(card) ? (card.nextElementSibling || card.previousElementSibling) as HTMLElement | null : null;
        odFav.toggle(slug);
        build();
        if (!document.body.contains(btn)) {
          const alvo = viz && document.body.contains(viz) ? viz : source[slug];
          alvo?.querySelector<HTMLElement>('.fav-btn')?.focus();
        }
      });
      build();
      document.addEventListener('od:lang', rotulos);
    })();
    // ── Santo do dia (calculado na data do visitante; só biografias) ──
    (function () {
      const link = document.getElementById('santoDia');
      if (!link || !CAL) return;
      const items = dados<{ f: string; n: string; u: string }>('santoDados')
        .map((x) => ({ feast: x.f, name: x.n, url: x.u }))
        .filter((x) => CAL.valido(x.feast));
      if (!items.length) return;

      // hoje? senão, a próxima data que tiver santo
      const hojeD: Date = CAL.hoje();
      let feast = '', bestDelta = Infinity;
      for (const x of items) {
        const d: Date | null = CAL.proxima(x.feast, hojeD);
        const delta = d ? CAL.dias(hojeD, d) : Infinity;
        if (delta < bestDelta) { bestDelta = delta; feast = x.feast; }
      }
      const isToday = bestDelta === 0;
      // todos os santos dessa data, juntos (a ordem já vem pronta do build)
      const group = items.filter((x) => x.feast === feast);
      if (!group.length) return;
      const many = group.length > 1;

      // vários santos no mesmo dia: a faixa deixa de ser um link único
      // e cada nome passa a levar à sua própria biografia
      let strip: HTMLElement = link;
      if (many) {
        const box = document.createElement('div');
        for (const at of Array.from(link.attributes)) if (at.name !== 'href') box.setAttribute(at.name, at.value);
        while (link.firstChild) box.appendChild(link.firstChild);
        link.replaceWith(box);
        strip = box;
      } else {
        (link as HTMLAnchorElement).href = group[0].url;
      }

      const nameEl = strip.querySelector<HTMLElement>('#santoDiaName');
      const dateEl = strip.querySelector<HTMLElement>('#santoDiaDate');
      const labEl = strip.querySelector<HTMLElement>('#santoDiaLabel');
      if (dateEl) dateEl.textContent = feast.slice(3, 5) + '/' + feast.slice(0, 2);
      // o rótulo plural usa chaves próprias: tira o data-i18n para o Base não trocá-lo
      if (labEl) { if (many) labEl.removeAttribute('data-i18n'); else labEl.setAttribute('data-i18n', isToday ? 'santo_today' : 'santo_next'); }
      const render = () => {
        if (labEl) labEl.textContent = many
          ? (isToday ? tr('santos_today', 'Santos do dia') : tr('santos_next', 'Próximos santos'))
          : (window as any).odt(isToday ? 'santo_today' : 'santo_next');
        if (!nameEl) return;
        if (!many) { nameEl.textContent = group[0].name; return; }
        // "A e B" / "A, B e C", cada nome com o seu link
        const and = tr('list_and', 'e');
        nameEl.textContent = '';
        group.forEach((g, i) => {
          if (i > 0) nameEl.append(i === group.length - 1 ? ` ${and} ` : ', ');
          const a = document.createElement('a');
          a.href = g.url; a.textContent = g.name;
          nameEl.append(a);
        });
      };
      render();
      document.addEventListener('od:lang', render);
      strip.hidden = false;
    })();

    // ── Busca pelo endereço: /?q=termo (é o endereço que o Google usa) ──
    // preenche a busca do catálogo, aplica o filtro e rola até o catálogo
    // (o scroll-margin-top do #catalogo deixa o título abaixo do topo fixo)
    (function () {
      let q = '';
      try { q = (new URLSearchParams(location.search).get('q') || '').trim().slice(0, 100); } catch (e) {}
      const input = document.getElementById('search') as HTMLInputElement | null;
      const cat = document.getElementById('catalogo');
      if (!q || !input || !cat) return;
      input.value = q;
      input.dispatchEvent(new Event('input'));
      // 'instant': o html tem scroll-behavior: smooth, e aqui a rolagem é parte da chegada à página
      const rolar = () => cat.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior });
      rolar();
      // quando imagens e fontes terminarem de chegar, confere de novo (se a pessoa ainda não rolou)
      let mexeu = false;
      const marca = () => { mexeu = true; };
      for (const ev of ['wheel', 'touchstart', 'keydown']) window.addEventListener(ev, marca, { once: true, passive: true });
      window.addEventListener('load', () => { if (!mexeu) rolar(); }, { once: true });
    })();
  </script>
</Base>

<script>
  // botão "Ler a Liturgia do dia": leva direto à de hoje, se houver (endereço com barra final)
  (function () {
    var el = document.getElementById('liturgiaCta');
    if (!el) return;
    var base = el.getAttribute('data-base') || '/';
    var map = {};
    try { map = JSON.parse(el.getAttribute('data-map') || '{}'); } catch (e) {}
    var now = (window as any).odCalendario ? (window as any).odCalendario.hoje() : new Date();
    var key = '' + now.getFullYear() + String(now.getMonth() + 1).padStart(2, '0') + String(now.getDate()).padStart(2, '0');
    if (map[key]) {
      el.setAttribute('href', base.replace(/\/$/, '') + '/liturgia/' + map[key] + '/');
    }
  })();
</script>

<style>
  /* atalho "Catálogo" e busca ?q=: o título para abaixo do topo fixo */
  #catalogo { scroll-margin-top: 76px; }

  /* antes do filtro rodar, só os 50 primeiros cartões (o mesmo STEP do script) entram no
     cálculo da página: os outros 180 e poucos nem passam por estilo e layout */
  :global(.od-catalogo-js #catalogGrid:not(.pronto) > .card:nth-child(n+51)) { display: none; }

  .liturgia-cta {
    display: flex; align-items: center; gap: 1rem;
    margin: 0 auto 1rem; padding: 1.15rem 1.5rem; max-width: 40rem;
