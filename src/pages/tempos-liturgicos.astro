---
// Endereço antigo. O texto sobre os tempos litúrgicos agora vive em /textos/tempos-liturgicos;
// esta página só redireciona para lá (e diz ao Google qual é o endereço certo), para que
// links antigos continuem funcionando sem publicar uma cópia duplicada do texto.
import { withBase } from '../config/site';
const destino = withBase('/textos/tempos-liturgicos/'); // com a barra final, como o GitHub Pages serve
const canonico = new URL(destino, Astro.site ?? 'https://www.oratoriodigital.com').href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Os tempos litúrgicos · Oratório Digital</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonico} />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <script is:inline define:vars={{ destino }}>location.replace(destino + location.hash);</script>
  </head>
  <body style="font-family: Georgia, serif; padding: 2rem; background: #14110d; color: #efe6d4;">
    <p>Esta página mudou de endereço: <a href={destino} style="color: #d8b35a;">Os tempos litúrgicos</a>.</p>
  </body>
</html>
