---
import { getCollection } from 'astro:content';
import { site, ui, withBase } from '../config/site';
import { oracoesMovidas } from '../config/redirecionamentos';
// noindex: a página não entra no Google nem no sitemap (ex.: 404, páginas internas)
// idioma: língua do CONTEÚDO, para os dados estruturados (ex.: 'en' numa oração em inglês)
const { title, description, noindex = false, idioma = 'pt-BR' } = Astro.props;
// Segurança do contador: em site.ts vai a chave PÚBLICA do Supabase (sb_publishable_…). Uma "Secret key"
// (ou a antiga "service_role") abriria o banco inteiro para qualquer visitante — o build para aqui,
// antes de publicar, e o site no ar continua como estava.
{
  const k = String((site.counter as { supabaseKey?: string }).supabaseKey ?? '').trim();
  let papel = '';
  try { papel = JSON.parse(Buffer.from(k.split('.')[1] ?? '', 'base64').toString('utf-8')).role ?? ''; } catch { papel = ''; }
  if (/^sb_secret_/i.test(k) || papel === 'service_role') {
    throw new Error('src/config/site.ts → counter.supabaseKey: use a "Publishable key" (começa com sb_publishable_), NUNCA a "Secret key". Troque a chave, gere uma Secret key nova no Supabase (Settings → API Keys) e publique de novo.');
  }
}
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const desc = description || site.tagline; // descrição vazia ('') também cai no lema do site
const base = import.meta.env.BASE_URL;
// dados expostos ao cliente
const clientConfig = {
  base,
  counter: site.counter,
  turnstile: site.turnstile,
  defaultLang: site.defaultLang,
  movidas: oracoesMovidas, // orações duplicadas que saíram: favoritos antigos passam para a que ficou
};
// Link "Liturgia" (topo e rodapé): só aparece quando a coleção 'liturgia' tiver ao menos
// uma entrada — volta sozinho quando houver conteúdo. Conta uma vez por build: com a
// coleção vazia, cada getCollection() imprime um aviso no log, e este layout roda em
// todas as páginas. (No "npm run dev" conta a cada página, para refletir arquivos novos.)
const _g = globalThis as { __odLiturgias?: number };
if (import.meta.env.DEV || _g.__odLiturgias === undefined) _g.__odLiturgias = (await getCollection('liturgia')).length;
const temLiturgia = _g.__odLiturgias > 0;

// ── Google e prévias de link: endereço canônico, Open Graph e dados estruturados ──
const SITE = (Astro.site?.href ?? 'https://www.oratoriodigital.com/').replace(/\/$/, '');
const raiz = SITE + base.replace(/\/$/, '');          // https://www.oratoriodigital.com
// endereço da página sempre com barra final: é como o GitHub Pages serve (/oracao/pai-nosso/)
let caminho = Astro.url.pathname;
if (!caminho.endsWith('/') && !/\.[a-z0-9]+$/i.test(caminho)) caminho += '/';
const rel = '/' + caminho.slice(base.length).replace(/^\//, '');   // sem o "base": /oracao/pai-nosso/
const canonical = SITE + caminho;
// fora do Google: 404, páginas internas (/ferramentas/) e a Liturgia enquanto não tiver conteúdo
const semIndice = noindex || /^\/(404|ferramentas\/)/.test(rel) || (!temLiturgia && rel.startsWith('/liturgia/'));
// orações, biografias e textos são "artigos" e têm prévia própria, gerada no build por
// scripts/og/previas.mjs em /og/<seção>/<slug>.jpg (mesmas seções de lá); o resto usa a padrão
const ehArtigo = /^\/(oracao|biografia|textos)\/.+\/$/.test(rel);
const ogImagem = raiz + (ehArtigo ? `/og${rel.replace(/\/$/, '')}.jpg` : '/og/padrao.jpg');
const ogTitulo = title || site.name;
// JSON-LD (schema.org): site com busca, organização, trilha (Início › Seção › Página) e artigo
const ORG = raiz + '/#organizacao', WEB = raiz + '/#site';
const SECOES: Record<string, [string, string]> = {
  oracao: ['Catálogo', '/#catalogo'], biografia: ['Biografias', '/biografias/'], textos: ['Textos', '/textos/'],
  cantos: ['Cantos', '/cantos/'], liturgia: ['Liturgia', '/liturgia/'],
};
const partes = rel.split('/').filter(Boolean);
const trilha: [string, string][] = [];
if (partes.length) {
  trilha.push(['Início', raiz + '/']);
  const secao = partes.length > 1 ? SECOES[partes[0]] : undefined;
  if (secao) trilha.push([secao[0], raiz + secao[1]]);
  trilha.push([ogTitulo, canonical]);
}
const corta = (s: string, n: number) => (s.length > n ? s.slice(0, n - 1).trimEnd() + '…' : s);
const grafo: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': WEB, url: raiz + '/', name: site.name, description: site.tagline, inLanguage: 'pt-BR',
    publisher: { '@id': ORG },
    potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: raiz + '/?q={search_term_string}' }, 'query-input': 'required name=search_term_string' } },
  { '@type': 'Organization', '@id': ORG, name: site.name, url: raiz + '/',
    logo: { '@type': 'ImageObject', url: raiz + '/logo.png', width: 512, height: 512 } },
];
if (!semIndice && trilha.length) grafo.push({ '@type': 'BreadcrumbList',
  itemListElement: trilha.map(([name, item], i) => ({ '@type': 'ListItem', position: i + 1, name, item })) });
if (!semIndice && ehArtigo) grafo.push({ '@type': 'Article', headline: corta(ogTitulo, 110), description: desc,
  image: ogImagem, inLanguage: idioma, author: { '@id': ORG }, publisher: { '@id': ORG },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical }, isPartOf: { '@id': WEB } });
// todo "<" vira o código de escape do JSON (barra-u-003c): nenhum texto consegue fechar o <script> antes da hora
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': grafo }).replace(/</g, '\\u003c');
// Cloudflare Web Analytics: só entra se houver token em site.ts (analytics.cloudflareToken)
const cfToken = (site.analytics?.cloudflareToken ?? '').trim();
---
<!doctype html>
<html lang="pt-BR" data-theme="dark" data-lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <!-- viewport-fit=cover: no iPhone, a página usa a tela toda e as margens seguras (env(safe-area-inset-*)) valem -->
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  {semIndice ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <!-- prévia de link (WhatsApp, Facebook, Telegram…): imagens geradas no build por scripts/og/previas.mjs -->
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:type" content={ehArtigo ? 'article' : 'website'} />
  <meta property="og:title" content={ogTitulo} />
  <meta property="og:description" content={desc} />
  {!semIndice && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImagem} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogTitulo === site.name ? site.name : `${ogTitulo} — ${site.name}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" is:inline set:html={jsonLd} />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base.replace(/\/$/,'')}/favicon-32.png`} />
  <link rel="icon" type="image/png" sizes="48x48" href={`${base.replace(/\/$/,'')}/favicon-48.png`} />
  <link rel="apple-touch-icon" href={`${base.replace(/\/$/,'')}/apple-touch-icon.png`} />
  <!-- fontes servidas pelo próprio site (public/fonts/, @font-face no CSS abaixo): sem Google Fonts.
       Pré-carrega só as duas que toda página mostra logo de cara: o texto e a marca/títulos. -->
  <link rel="preload" href={`${base.replace(/\/$/,'')}/fonts/eb-garamond-latin-400-normal.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base.replace(/\/$/,'')}/fonts/cormorant-latin-600-normal.woff2`} as="font" type="font/woff2" crossorigin />

  <!-- evita "flash" de tema/idioma errados antes da página pintar -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('od-theme');
        if (!t) t = 'dark';
        document.documentElement.setAttribute('data-theme', t);
        var l = localStorage.getItem('od-lang') || 'pt-BR';
        document.documentElement.setAttribute('data-lang', l);
        document.documentElement.setAttribute('lang', l);
      } catch (e) {}
    })();
  </script>

  <script is:inline define:vars={{ clientConfig, ui }}>
    window.__SITE__ = clientConfig;
    window.__UI__ = ui;
    window.odt = function (key) {
      var l = document.documentElement.getAttribute('data-lang') || 'pt-BR';
      var dict = (window.__UI__[l] || window.__UI__['pt-BR']);
      return dict[key] != null ? dict[key] : key;
    };
    // E9: endereço de PÁGINA sempre com barra final (antes de ? e #), como o GitHub Pages serve;
    // arquivos (search-index.json, imagens…) ficam como estão
    window.odBase = function (p) {
      var b = (window.__SITE__.base || '/').replace(/\/$/, '');
      if (!p) return b || '/';
      if (/^https?:\/\//.test(p)) return p;
      var m = /^([^?#]*)(.*)$/.exec(p.charAt(0) === '/' ? p : '/' + p);
      var c = m[1];
      if (c.slice(-1) !== '/' && !/\.[a-z0-9]+$/i.test(c)) c += '/';
      return b + c + m[2];
    };
    window.odFav = {
      key: 'od-favs',
      all: function () {
        var a; try { a = JSON.parse(localStorage.getItem(this.key) || '[]'); } catch (e) { return []; }
        // favorito de uma oração duplicada que saiu do site: passa para a oração que ficou
        var mov = (window.__SITE__ && window.__SITE__.movidas) || {}, novo = [], mudou = false;
        for (var i = 0; i < a.length; i++) { var s = mov[a[i]] || a[i]; if (s !== a[i]) mudou = true; if (novo.indexOf(s) < 0) novo.push(s); else mudou = true; }
        if (mudou) { try { localStorage.setItem(this.key, JSON.stringify(novo)); } catch (e) {} }
        return novo;
      },
      has: function (s) { return this.all().indexOf(s) >= 0; },
      toggle: function (s) { var a = this.all(); var i = a.indexOf(s); if (i >= 0) a.splice(i, 1); else a.push(s); try { localStorage.setItem(this.key, JSON.stringify(a)); } catch (e) {} return i < 0; }
    };
    window.odFavBio = {
      key: 'od-fav-bios',
      all: function () { try { return JSON.parse(localStorage.getItem(this.key) || '[]'); } catch (e) { return []; } },
      has: function (s) { return this.all().indexOf(s) >= 0; },
      toggle: function (s) { var a = this.all(); var i = a.indexOf(s); if (i >= 0) a.splice(i, 1); else a.push(s); try { localStorage.setItem(this.key, JSON.stringify(a)); } catch (e) {} return i < 0; }
    };
  </script>
  <!-- espaço para uma página acrescentar algo ao <head>: <Fragment slot="head">…</Fragment> -->
  <slot name="head" />
  <!-- calendário litúrgico (datas fixas e móveis, regras do Brasil): window.odCalendario — ver public/js/calendario.js -->
  <script is:inline src={`${base.replace(/\/$/,'')}/js/calendario.js`}></script>
  <!-- tempo litúrgico do dia (cor de destaque, selo da abertura, rodapé): tudo pelo odCalendario, sem contas próprias -->
  <script is:inline>
    window.odSeason = (function () {
      // cor de destaque de cada tempo; o Tríduo Pascal tem a sua (vermelho, mais escuro que o de Pentecostes)
      var CORES = { advento: '#9a86d4', natal: '#e6c876', quaresma: '#8f7bbf', triduo: '#b4463e', pascoa: '#e6c876', comum: '#6fae84', pentecostes: '#c0563f' };
      var CAL = window.odCalendario, t = null;
      try { t = CAL ? CAL.tempo(CAL.hoje()) : null; } catch (e) { t = null; }
      var key = t ? t.chave : 'comum';
      try {
        document.documentElement.dataset.season = key;
        document.documentElement.style.setProperty('--season', CORES[key] || '#c8a24a');
      } catch (e) {}
      function tr(k, pt) { var v = window.odt ? window.odt(k) : k; return v && v !== k ? v : pt; }
      function aplica() {
        var lang = document.documentElement.getAttribute('data-lang') || 'pt-BR';
        var nome = window.odt('season_' + key);
        var ft = document.getElementById('seasonTag'); if (ft) ft.textContent = nome;
        var bt = document.getElementById('seasonBadgeText'); if (bt) bt.textContent = nome;
        var bg = document.getElementById('seasonBadge'); if (bg) bg.hidden = false;
        var nx = document.getElementById('seasonNext');
        if (nx && t && t.fim && t.proximo) {
          // "até" = ÚLTIMO dia do tempo atual; quando ele acaba hoje (ex.: Pentecostes), "até hoje"
          var hoje = CAL.hoje(), quando;
          if (CAL.dias(hoje, t.fim) === 0) quando = tr('season_hoje', 'hoje');
          else {
            var o = { day: 'numeric', month: 'long' };
            if (t.fim.getFullYear() !== hoje.getFullYear()) o.year = 'numeric';
            quando = t.fim.toLocaleDateString(lang, o);
          }
          nx.innerHTML = window.odt('season_until') + ' ' + quando + ' · ' + window.odt('season_then') + ' <b>' + window.odt('season_' + t.proximo.chave) + '</b>';
          nx.hidden = false;
        }
      }
      if (document.readyState !== 'loading') aplica(); else document.addEventListener('DOMContentLoaded', aplica);
      document.addEventListener('od:lang', aplica);
      return { key: key, color: CORES[key] };
    })();
  </script>
  <!-- contador da comunidade (Supabase ou Abacus): window.odContador — ver public/js/contador.js -->
  <script is:inline src={`${base.replace(/\/$/,'')}/js/contador.js`}></script>
</head>
<body>
  <div class="texture" aria-hidden="true"></div>

  <header class="topbar">
    <a class="brand" href={withBase('/')}>
      <span class="brand-mark" aria-hidden="true">
        <img src={`${base.replace(/\/$/,'')}/logo-64.webp`} alt="" width="30" height="30" />
      </span>
      <span class="brand-text">{site.name}</span>
    </a>
    <nav class="topnav" aria-label="Principal">
      <div class="topnav-links" id="navLinks">
      <a href={withBase('/')} data-i18n="nav_home">Início</a>
      <a href={withBase('/#catalogo')} data-i18n="nav_catalog">Catálogo</a>
      {temLiturgia && <a href={withBase('/liturgia')} data-i18n="nav_liturgia">Liturgia</a>}
      <a href={withBase('/proximas-festas')} data-i18n="nav_feasts">Próximas festas</a>
      <a href={withBase('/biografias')} data-i18n="nav_bio">Biografias</a>
      <a href={withBase('/textos')} data-i18n="nav_textos">Textos</a>
      <a href={withBase('/produtos')} data-i18n="nav_produtos">Produtos</a>
      <a href={withBase('/sobre')} data-i18n="nav_about">Sobre</a>
      <button id="themeBtn" class="icon-btn nav-theme" type="button" aria-label="Modo claro/escuro" title="Modo claro/escuro" data-i18n-aria="theme_toggle">
        <svg class="i-sun" viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="2.5" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="21.5"/><line x1="2.5" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="21.5" y2="12"/><line x1="5.2" y1="5.2" x2="6.9" y2="6.9"/><line x1="17.1" y1="17.1" x2="18.8" y2="18.8"/><line x1="5.2" y1="18.8" x2="6.9" y2="17.1"/><line x1="17.1" y1="6.9" x2="18.8" y2="5.2"/></g></svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="20" height="20"><path d="M20 14.5A8 8 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
              <span class="nav-theme-label" data-i18n="theme_toggle">Modo claro/escuro</span>
      </button>
      <button id="searchBtn" class="icon-btn nav-util" type="button" aria-label="Buscar" title="Buscar" data-i18n-aria="search_label" data-abre-busca>
        <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="nav-btn-label" data-i18n="search_label">Buscar</span>
      </button>
      <button id="langBtn" class="icon-btn nav-util" type="button" aria-label="Idioma" title="Idioma" data-i18n-aria="lang_label">
        <span class="nav-btn-label" data-i18n="lang_label">Idioma</span>
        <span id="langCode">PT</span>
      </button>
      </div>
      <div class="topnav-actions">
        <!-- celular/tablet: a lupa fica ao lado do ☰ (um toque só); no desktop ela está no menu acima -->
        <button id="searchBtnMob" class="icon-btn nav-search-mob" type="button" aria-label="Buscar" title="Buscar" data-i18n-aria="search_label" data-abre-busca>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <button id="navToggle" class="icon-btn nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="navLinks">
          <svg class="i-menu" viewBox="0 0 24 24" width="20" height="20"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="i-close" viewBox="0 0 24 24" width="20" height="20"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="footsite">
    <p class="foot-mark">✦</p>
    <p class="season-tag" id="seasonTag"></p>
    <nav class="footnav" aria-label="Seções">
      <a href={withBase('/')} data-i18n="nav_home">Início</a>
      <a href={withBase('/#catalogo')} data-i18n="nav_catalog">Catálogo</a>
      {temLiturgia && <a href={withBase('/liturgia')} data-i18n="nav_liturgia">Liturgia</a>}
      <a href={withBase('/proximas-festas')} data-i18n="nav_feasts">Próximas festas</a>
      <a href={withBase('/biografias')} data-i18n="nav_bio">Biografias</a>
      <a href={withBase('/produtos')} data-i18n="nav_produtos">Produtos</a>
      <a href={withBase('/textos')} data-i18n="nav_textos">Textos</a>
      <a href={withBase('/cantos')} data-i18n="nav_cantos">Cantos</a>
      <a href={withBase('/sobre')} data-i18n="nav_about">Sobre</a>
      <a href={withBase('/privacidade')} data-i18n="nav_privacidade">Privacidade</a>
    </nav>
    <p>{site.name}</p>
    <p class="foot-small" data-i18n="progress_saved">Progresso salvo neste aparelho.</p>
  </footer>

  <!-- Busca global (orações, biografias, textos e cantos) -->
  <div id="searchOverlay" class="search-overlay" hidden>
    <div class="search-panel" role="dialog" aria-modal="true" aria-label="Buscar" data-i18n-aria="search_label">
      <div class="search-bar">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="globalSearch" type="search" autocomplete="off" enterkeyhint="search" placeholder="Buscar orações, santos, textos…" data-i18n-ph="busca_ph" aria-label="Buscar" data-i18n-aria="search_label" />
        <button id="searchClose" class="icon-btn" type="button" aria-label="Fechar" data-i18n-aria="close">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div id="searchResults" class="search-results"></div>
      <p id="searchHint" class="search-hint" data-i18n="busca_dica">Digite para buscar orações, santos, textos e cantos.</p>
    </div>
  </div>

  <script>
    // ── Tema ──
    const themeBtn = document.getElementById('themeBtn');
    themeBtn?.addEventListener('click', () => {
      const cur = document.documentElement.getAttribute('data-theme');
      const next = cur === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('od-theme', next); } catch (e) {}
    });

    // ── Idioma ──
    const langs = Object.keys((window as any).__UI__ || { 'pt-BR': 1 });
    function applyLang(l: string) {
      document.documentElement.setAttribute('data-lang', l);
      document.documentElement.setAttribute('lang', l);
      const code = document.getElementById('langCode');
      if (code) code.textContent = l.slice(0, 2).toUpperCase();
      // chave ainda sem tradução em site.ts: odt devolve a própria chave — aí fica o texto do HTML (reserva em PT)
      document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
        const k = el.getAttribute('data-i18n')!;
        const v = (window as any).odt(k);
        if (v !== k) el.textContent = v;
      });
      // rótulos de botões só com ícone (aria-label e title); a reserva é o próprio rótulo do HTML
      document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((el) => {
        const k = el.getAttribute('data-i18n-aria')!;
        if (el.dataset.ariaPt === undefined) el.dataset.ariaPt = el.getAttribute('aria-label') || '';
        const v = (window as any).odt(k);
        const txt = v !== k ? v : el.dataset.ariaPt;
        el.setAttribute('aria-label', txt);
        if (el.hasAttribute('title')) el.setAttribute('title', txt);
      });
      document.querySelectorAll<HTMLElement>('[data-i18n-ph]').forEach((el) => {
        const k = el.getAttribute('data-i18n-ph')!;
        const v = (window as any).odt(k);
        if (v !== k) (el as HTMLInputElement).placeholder = v;
      });
      document.dispatchEvent(new CustomEvent('od:lang', { detail: l }));
    }
    const langBtn = document.getElementById('langBtn');
    langBtn?.addEventListener('click', () => {
      const cur = document.documentElement.getAttribute('data-lang') || 'pt-BR';
      const idx = langs.indexOf(cur);
      const next = langs[(idx + 1) % langs.length];
      applyLang(next);
      try { localStorage.setItem('od-lang', next); } catch (e) {}
    });
    applyLang(document.documentElement.getAttribute('data-lang') || 'pt-BR');

    // ── Chegada por âncora (/#catalogo, /oracao/terco/#3ª-dezena…) ──
    // O html rola suave (scroll-behavior: smooth) e o conteúdo acima do alvo ainda muda de altura
    // durante a chegada (imagens, seções que o JS revela): o pulo do navegador para no lugar errado.
    // Aqui o alvo é alinhado de novo, sem animação, até a página terminar de carregar — só enquanto
    // a pessoa não rolou por conta própria. O scroll-margin-top deixa o alvo abaixo do topo fixo.
    (function () {
      if (location.hash.length < 2) return;
      let alvo: HTMLElement | null = null;
      try { alvo = document.getElementById(decodeURIComponent(location.hash.slice(1))); } catch (e) {}
      if (!alvo) return;
      let mexeu = false;
      const marca = () => { mexeu = true; };
      for (const ev of ['wheel', 'touchstart', 'keydown', 'mousedown']) window.addEventListener(ev, marca, { once: true, passive: true });
      const alinhar = () => { if (!mexeu) alvo!.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior }); };
      alinhar();
      const depois = () => { alinhar(); setTimeout(alinhar, 250); document.fonts?.ready.then(alinhar); };
      if (document.readyState === 'complete') depois(); else window.addEventListener('load', depois, { once: true });
    })();

    // ── E-mail protegido contra robôs de spam (Sobre, Privacidade) ──
    // O HTML traz só "nome (arroba) domínio" num <span data-email>; aqui ele vira um link mailto
    // com os mesmos atributos (classe e o atributo de estilo do Astro). Sem JS, fica o texto.
    document.querySelectorAll<HTMLElement>('[data-email]').forEach((el) => {
      const txt = el.querySelector<HTMLElement>('[data-email-txt]');
      if (!txt) return;
      const end = (txt.textContent || '').replace(/\s*\(arroba\)\s*/, '@').replace(/\s+/g, '');
      if (!/^[^@]+@[^@]+\.[a-z]{2,}$/i.test(end)) return;
      const a = document.createElement('a');
      for (const at of Array.from(el.attributes)) if (at.name !== 'data-email') a.setAttribute(at.name, at.value);
      a.href = 'mailto:' + end;
      txt.textContent = end;
      while (el.firstChild) a.appendChild(el.firstChild);
      el.replaceWith(a);
    });

    // ── Menu mobile (hambúrguer) ──
    (function () {
      const topbar = document.querySelector('.topbar');
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      if (!topbar || !toggle || !links) return;
      const setOpen = (open: boolean) => {
        topbar.classList.toggle('nav-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      toggle.addEventListener('click', () => setOpen(!topbar.classList.contains('nav-open')));
      links.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.querySelectorAll('[data-abre-busca]').forEach((b) => b.addEventListener('click', () => setOpen(false)));
      // mesma media query do CSS (@media do menu ☰): ao passar para o layout de desktop, fecha o menu
      const mq = window.matchMedia('(max-width: 1279px)');
      const onMq = () => { if (!mq.matches) setOpen(false); };
      if (typeof mq.addEventListener === 'function') mq.addEventListener('change', onMq);
      else mq.addListener(onMq); // Safari antigo (< 14)
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    })();

    // ── Paralaxe (respeita prefers-reduced-motion) ──
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
      let ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          for (const el of layers) {
            const speed = parseFloat(el.dataset.parallax || '0');
            el.style.transform = `translate3d(0, ${(-y * speed).toFixed(1)}px, 0)`;
          }
          ticking = false;
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  </script>

